{
  "hosting": {
    "public": "site/dist",
    "ignore": ["firebase.json", "**/.*", "**/.prerender/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      { "regex": "^/liner-notes/?$", "destination": "/about/", "type": 301 },
      { "regex": "^/de/liner-notes/?$", "destination": "/de/about/", "type": 301 },
      { "regex": "^/es/liner-notes/?$", "destination": "/es/about/", "type": 301 },
      { "regex": "^/fr/liner-notes/?$", "destination": "/fr/about/", "type": 301 },
      { "regex": "^/it/liner-notes/?$", "destination": "/it/about/", "type": 301 },
      { "regex": "^/pl/liner-notes/?$", "destination": "/pl/about/", "type": 301 },
      { "regex": "^/ru/liner-notes/?$", "destination": "/ru/about/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'" }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/graph{,/**}",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      },
      {
        "source": "/{install.sh,licenses.txt,llms.txt}",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      },
      {
        "source": "/install.sh",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ]
  }
}
