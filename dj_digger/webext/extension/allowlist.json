{
  "schemes": ["https"],
  "groups": {
    "hypeddit": {
      "hosts": ["hypeddit.com", "hypd.it"],
      "www": true,
      "subdomains": false,
      "forbiddenPaths": []
    },
    "bandcamp": {
      "hosts": ["bandcamp.com"],
      "www": false,
      "subdomains": true,
      "forbiddenPaths": ["/checkout", "/cart/checkout", "/cart/checkout_start", "/payment"]
    },
    "beatport": {
      "hosts": ["beatport.com"],
      "www": false,
      "subdomains": true,
      "forbiddenPaths": ["/checkout", "/cart/checkout", "/payment", "/account/billing", "/subscriptions/billing"]
    },
    "soundcloud": {
      "hosts": ["soundcloud.com"],
      "www": false,
      "subdomains": false,
      "allowedPaths": ["/signin"],
      "dom": false,
      "forbiddenPaths": []
    }
  },
  "clickDenylist": {
    "pattern": "\\b(check ?out|pay|payment|purchase|place order|buy now|complete order)\\b",
    "flags": "i",
    "exceptions": [
      {"host": "bandcamp.com", "pattern": "^buy digital (?:track|album)$", "flags": "i"}
    ]
  }
}
