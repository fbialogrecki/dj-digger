{
  "manifest_version": 3,
  "name": "dj-digger",
  "version": "1.4.2",
  "description": "Lets the dj-digger desktop app drive download gates and store carts in your own browser.",
  "minimum_chrome_version": "121",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "key": "",
  "browser_specific_settings": {
    "gecko": {"id": "dj-digger@fbialogrecki.github.io", "strict_min_version": "128.0"}
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["dom.js", "background.js"]
  },
  "permissions": [
    "nativeMessaging", "tabs", "scripting", "downloads", "cookies",
    "webRequest", "webNavigation", "storage", "alarms", "offscreen", "activeTab", "contextMenus"
  ],
  "host_permissions": [
    "https://hypeddit.com/*",
    "https://www.hypeddit.com/*",
    "https://hypd.it/*",
    "https://www.hypd.it/*",
    "https://toneden.io/*",
    "https://www.toneden.io/*",
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*",
    "https://beatport.com/*",
    "https://*.beatport.com/*",
    "https://soundcloud.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "dj-digger",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}
  },
  "options_ui": {"page": "welcome.html", "open_in_tab": true}
}
