---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Record from "../components/Record.astro";
import appIcon from "../../../dj_digger/gui/qml/icons/app.png";
import archivo from "../assets/fonts/archivo-latin.woff2?url";
import boot from "../scripts/boot.js?raw";
import { author, measurementId, repo, version } from "../../site.config.mjs";
import { baseOf, langOf, languages, pathIn, ui } from "../i18n/index.mjs";

// `label` picks the record label's colours for this page (global.css: [data-label]).
// `tracks` is accepted and ignored: there is no tracklist any more.
const { title, description, label = "home", noindex = false } = Astro.props;
const here = Astro.url.pathname;
const lang = langOf(here);
const t = ui(here);
const local = (base) => pathIn(lang, base);
// The same page in every language; a page that is not indexed (404) offers each language's start.
const alternates = languages.map((language) => ({ ...language, href: pathIn(language.code, noindex ? "/" : baseOf(here)) }));
const current = languages.find((language) => language.code === lang);
const canonical = new URL(here, Astro.site);
const pages = [
  { href: local("/app/"), label: t.nav.app, icon: "desktop" },
  { href: local("/extension/"), label: t.nav.extension, icon: "puzzle-piece" },
  { href: local("/about/"), label: t.nav.about, icon: "info" },
  { href: local("/download/"), label: t.nav.download, icon: "download-simple" },
  { href: repo, label: t.nav.github, icon: "github-logo" },
];
const project = [
  { href: local("/privacy/"), label: t.legal.privacy, icon: "shield-check" },
  { href: local("/terms/"), label: t.legal.terms, icon: "scales" },
  { href: `${repo}/blob/main/LICENSE`, label: t.footer.license, icon: "scales" },
  { href: repo, label: t.nav.github, icon: "github-logo" },
  { href: `${local("/about/")}#credits`, label: t.footer.credits, icon: "heart" },
];
---

<!doctype html>
<html lang={lang} data-label={label}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0e" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eceef1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {/* boot.js reads these to send a first visit to the visitor's language. */}
    {!noindex && alternates.map((language) => <link rel="alternate" hreflang={language.code} href={new URL(language.href, Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(baseOf(here), Astro.site)} />}
    <link rel="icon" type="image/png" href={appIcon.src} />
    <link rel="preload" as="font" type="font/woff2" href={archivo} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dj-digger" />
    <meta property="og:locale" content={current.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline set:html={boot} />
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <header class="top">
      <a class="brand" href={local("/")} aria-current={here === local("/") ? "page" : undefined}>
        <img src={appIcon.src} width="28" height="28" alt="" />
        dj-digger
      </a>
      <button class="button compact menu-toggle" type="button" popovertarget="site-menu">
        <Icon name="list" /><span class="menu-word">{t.menu}</span>
      </button>
      <div id="site-menu" popover>
        <div class="menu-heading">
          <strong>{t.menu}</strong>
          <button class="button compact icon-only" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label={t.close}>
            <Icon name="x" />
          </button>
        </div>
        <nav class="links" aria-label={t.primary}>
          <ul>
            {
              pages.map((page) => (
                <li>
                  <a href={page.href} aria-current={here === page.href ? "page" : undefined}>
                    <Icon name={page.icon} />
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {/* Works without a script; deck.js remembers the choice (boot.js then follows it). */}
        <details class="lang">
          <summary class="button compact">
            <Icon name="translate" />
            <span class="sr">{t.language}: {current.name}</span>
            <span class="lang-code" aria-hidden="true">{lang.toUpperCase()}</span>
            <span class="lang-name" aria-hidden="true">{t.language} · {current.name}</span>
          </summary>
          <ul>
            {
              alternates.map((language) => (
                <li>
                  <a href={language.href} hreflang={language.code} lang={language.code} data-lang={language.code} aria-current={language.code === lang ? "true" : undefined}>
                    {language.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        {/* Shown by deck.js: without JavaScript the site follows the system's theme. */}
        <button class="button compact icon-only theme" type="button" data-to-light={t.toLight} data-to-dark={t.toDark} hidden>
          <Icon name="sun" class="sun" />
          <Icon name="moon" class="moon" />
          <span class="theme-label"></span>
        </button>
      </div>
    </header>

    {measurementId && <aside id="consent" class="consent" data-ga={measurementId} data-version={version} data-page={noindex ? "/404/" : here} aria-labelledby="consent-title" hidden>
      <h2 id="consent-title" tabindex="-1">{t.legal.bannerTitle}</h2>
      <p>{t.legal.bannerText} <a href={local("/privacy/")}>{t.legal.privacy}</a></p>
      <div class="cta">
        <button type="button" class="button compact" data-choice="allow">{t.legal.accept}</button>
        <button type="button" class="button compact" data-choice="deny">{t.legal.reject}</button>
      </div>
    </aside>}
    <div class="page">
      {/* The record rides beside the text; it ends where the page's text ends, above the footer. */}
      <div class="deck">
        <div class="platter">
          <Record />
        </div>
      </div>
      <div class="sheet">
        <main id="content" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <footer class="foot">
      <div class="foot-inner">
        <a class="foot-brand" href={local("/")}>
          <img src={appIcon.src} width="40" height="40" alt="" loading="lazy" />
          <span>
            <strong>dj-digger</strong>
            {t.footer.free}
          </span>
        </a>
        <nav aria-label={t.footer.site}>
          <ul>
            {
              pages.slice(0, 4).map((page) => (
                <li>
                  <a href={page.href}>
                    <Icon name={page.icon} />
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="foot-small">
          <p>
            {t.footer.madeBy} <a href={author.url}>{author.name}</a>, 2026
          </p>
          <ul aria-label={t.footer.project}>
            {measurementId && <li><button type="button" class="cookie-settings" data-settings hidden>{t.legal.settings}</button></li>}
            {
              project.map((link) => (
                <li>
                  <a href={link.href}>
                    <Icon name={link.icon} />
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>

    {/* One zoomed view for every <Shot>, opened by lightbox.js; without a script a shot is a plain link. */}
    <dialog class="lightbox" aria-label={t.lightbox.label}>
      <button class="button compact icon-only" type="button" data-close aria-label={t.close}><Icon name="x" /></button>
      <img alt="" decoding="async" />
    </dialog>
    <script>
      import "../scripts/deck.js";
      import "../scripts/consent.js";
      import "../scripts/lightbox.js";
    </script>
  </body>
</html>
