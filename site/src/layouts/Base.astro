---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Record from "../components/Record.astro";
import appIcon from "../../../dj_digger/gui/qml/icons/app.png";
import archivo from "../assets/fonts/archivo-latin.woff2?url";
import boot from "../scripts/boot.js?raw";
import { author, chromeStore, measurementId, releaseDate, repo, version } from "../../site.config.mjs";
import { baseOf, langOf, languages, pathIn, ui } from "../i18n/index.mjs";
import { languagesOf, partial } from "../i18n/pages.mjs";

// `label` picks the record label's colours for this page (global.css: [data-label]).
// `tracks` is accepted and ignored: there is no tracklist any more.
// `crumb` names the page in its breadcrumb when it is not one of the pages named below.
// `article` ({ published, modified? } as YYYY-MM-DD) marks a guide as an article with dates.
const { title, description, label = "home", noindex = false, crumb, article } = Astro.props;
const articleDate = article?.modified ?? article?.published;
const here = Astro.url.pathname;
const lang = langOf(here);
const t = ui(here);
const local = (base) => pathIn(lang, base);
// The same page in every language it exists in; the switcher offers a language's start page where it
// does not, and so does a page that is not indexed (404).
const offered = noindex ? [] : languagesOf(baseOf(here));
const alternates = languages.map((language) => ({
  ...language,
  href: pathIn(language.code, offered.includes(language.code) ? baseOf(here) : "/"),
  exists: offered.includes(language.code),
}));
const current = languages.find((language) => language.code === lang);
const canonical = new URL(here, Astro.site);
const pages: { href: string; label: string; icon: string; hreflang?: string }[] = [
  { href: local("/app/"), label: t.nav.app, icon: "desktop" },
  { href: local("/extension/"), label: t.nav.extension, icon: "puzzle-piece" },
  { href: local("/about/"), label: t.nav.about, icon: "info" },
  { href: local("/download/"), label: t.nav.download, icon: "download-simple" },
  { href: repo, label: t.nav.github, icon: "github-logo" },
];
const project = [
  { href: local("/privacy/"), label: t.legal.privacy, icon: "shield-check" },
  { href: local("/terms/"), label: t.legal.terms, icon: "scales" },
  { href: `${repo}/blob/main/LICENSE`, label: t.footer.license, icon: "scales" },
  { href: repo, label: t.nav.github, icon: "github-logo" },
  { href: `${local("/about/")}#credits`, label: t.footer.credits, icon: "heart" },
];
// The questions and guides, in this language where they exist, else in English (marked as such).
const guides = Object.entries(partial).map(([path, names]) => ({
  href: lang in names ? local(path) : path,
  label: names[lang] ?? names.en,
  hreflang: lang in names ? undefined : "en",
  icon: path === "/faq/" ? "question" : "book-open",
}));

// Structured data (schema.org JSON-LD): who makes the site, what the software is, where the page sits.
const base = baseOf(here);
const site = (path) => new URL(path, Astro.site).href;
const id = (name) => `${site("/")}#${name}`;
const pageName = crumb ?? partial[base]?.[lang] ?? { "/app/": t.nav.app, "/extension/": t.nav.extension, "/about/": t.nav.about, "/download/": t.nav.download, "/privacy/": t.legal.privacy, "/terms/": t.legal.terms }[base];
const free = { "@type": "Offer", price: "0", priceCurrency: "USD" };
const license = "https://www.apache.org/licenses/LICENSE-2.0";
const graph = [
  { "@type": "WebSite", "@id": id("website"), url: site("/"), name: "dj-digger", publisher: { "@id": id("author") } },
  { "@type": "Person", "@id": id("author"), name: author.name, url: author.url, sameAs: [author.url] },
  ["/", "/app/", "/download/"].includes(base) && {
    "@type": "SoftwareApplication",
    "@id": id("app"),
    name: "dj-digger",
    description,
    url: site(local("/app/")),
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Windows 10, Windows 11, macOS 15, Linux",
    softwareVersion: version,
    dateModified: releaseDate,
    downloadUrl: site(local("/download/")),
    releaseNotes: `${repo}/blob/v${version}/CHANGELOG.md`,
    image: site(appIcon.src),
    isAccessibleForFree: true,
    license,
    offers: free,
    sameAs: [repo, "https://pypi.org/project/dj-sc-digger/"],
    author: { "@id": id("author") },
  },
  // No softwareVersion: the store may still serve an older version than the manifest in this repository.
  base === "/extension/" && {
    "@type": "SoftwareApplication",
    "@id": id("extension"),
    name: "dj-digger browser extension",
    description,
    url: site(local("/extension/")),
    applicationCategory: "BrowserApplication",
    softwareRequirements: "Chrome, Microsoft Edge or Brave",
    downloadUrl: chromeStore,
    isAccessibleForFree: true,
    license,
    offers: free,
    author: { "@id": id("author") },
  },
  article && {
    "@type": "Article",
    headline: title,
    description,
    inLanguage: lang,
    datePublished: article.published,
    dateModified: articleDate,
    url: canonical.href,
    mainEntityOfPage: canonical.href,
    author: { "@id": id("author") },
    publisher: { "@id": id("author") },
  },
  base !== "/" && pageName && {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "dj-digger", item: site(local("/")) },
      { "@type": "ListItem", position: 2, name: pageName, item: canonical.href },
    ],
  },
].filter(Boolean);
// A data block, never executed, so the script policy does not apply; "<" is escaped so no text can close it.
const structured = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={lang} data-label={label}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0e" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eceef1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    {alternates.filter((language) => language.exists).map((language) => <link rel="alternate" hreflang={language.code} href={new URL(language.href, Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(baseOf(here), Astro.site)} />}
    <link rel="icon" type="image/png" href={appIcon.src} />
    <link rel="preload" as="font" type="font/woff2" href={archivo} crossorigin />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="dj-digger" />
    <meta property="og:locale" content={current.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={articleDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <script is:inline type="application/ld+json" set:html={structured} />}
    <script is:inline set:html={boot} />
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <header class="top">
      <a class="brand" href={local("/")} aria-current={here === local("/") ? "page" : undefined}>
        <img src={appIcon.src} width="28" height="28" alt="" />
        dj-digger
      </a>
      <button class="button compact icon-only menu-toggle" type="button" popovertarget="site-menu" aria-label={t.menu}>
        <Icon name="list" />
      </button>
      <div id="site-menu" popover>
        <nav class="links" aria-label={t.primary}>
          <ul>
            {
              pages.map((page) => (
                <li>
                  <a href={page.href} aria-current={here === page.href ? "page" : undefined}>
                    <Icon name={page.icon} />
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {/* Every language choice is a crawlable link, including without JavaScript. */}
        <details class="lang">
          <summary class="button compact">
            <Icon name="translate" />
            <span class="sr">{t.language}: {current.name}</span>
            <span class="lang-code" aria-hidden="true">{lang.toUpperCase()}</span>
            <span class="lang-name" aria-hidden="true">{t.language} · {current.name}</span>
          </summary>
          <ul>
            {
              alternates.map((language) => (
                <li>
                  <a href={language.href} hreflang={language.code} lang={language.code} data-lang={language.code} aria-current={language.code === lang ? "true" : undefined}>
                    {language.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        {/* Shown by deck.js: without JavaScript the site follows the system's theme. */}
        <button class="button compact icon-only theme" type="button" data-to-light={t.toLight} data-to-dark={t.toDark} hidden>
          <Icon name="sun" class="sun" />
          <Icon name="moon" class="moon" />
          <span class="theme-label"></span>
        </button>
        <button class="button compact menu-close" type="button" popovertarget="site-menu" popovertargetaction="hide">{t.close}</button>
      </div>
    </header>

    {measurementId && <aside id="consent" class="consent" data-ga={measurementId} data-version={version} data-repo={repo} data-store={chromeStore} data-category={article ? "guide" : base.split("/")[1] || "home"} data-page={noindex ? "/404/" : here} aria-labelledby="consent-title" hidden>
      <h2 id="consent-title" tabindex="-1">{t.legal.bannerTitle}</h2>
      <p>{t.legal.bannerText} <a href={local("/privacy/")}>{t.legal.privacy}</a></p>
      <div class="cta">
        <button type="button" class="button compact" data-choice="allow">{t.legal.accept}</button>
        <button type="button" class="button compact" data-choice="deny">{t.legal.reject}</button>
      </div>
    </aside>}
    <div class="page">
      {/* The record rides beside the text; it ends where the page's text ends, above the footer. */}
      <div class="deck">
        <div class="platter">
          <Record />
        </div>
      </div>
      <div class="sheet">
        <main id="content" tabindex="-1">
          {article && (
            <div class="guide-path">
              <p><a href={local("/")}>dj-digger</a> <span aria-hidden="true"> / </span> {pageName}</p>
              <p>
                <a rel="author" href={local("/about/")}>{author.name}</a> · {t.guideUpdated}
                {" "}<time datetime={articleDate}>{new Date(articleDate).toLocaleDateString(lang, { dateStyle: "long", timeZone: "UTC" })}</time>
              </p>
            </div>
          )}
          <slot />
        </main>
      </div>
    </div>

    <footer class="foot">
      <div class="foot-inner">
        <a class="foot-brand" href={local("/")}>
          <img src={appIcon.src} width="40" height="40" alt="" loading="lazy" />
          <span>
            <strong>dj-digger</strong>
            {t.footer.free}
          </span>
        </a>
        <nav aria-label={t.footer.site}>
          <ul>
            {
              [...pages.slice(0, 4), ...guides].map((page) => (
                <li>
                  <a href={page.href} hreflang={page.hreflang} lang={page.hreflang}>
                    <Icon name={page.icon} />
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="foot-small">
          <p>
            {t.footer.madeBy} <a href={author.url}>{author.name}</a>, 2026
          </p>
          <ul aria-label={t.footer.project}>
            {measurementId && <li><button type="button" class="cookie-settings" data-settings hidden>{t.legal.settings}</button></li>}
            {
              project.map((link) => (
                <li>
                  <a href={link.href}>
                    <Icon name={link.icon} />
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>

    {/* One zoomed view for every <Shot>, opened by lightbox.js; without a script a shot is a plain link. */}
    <dialog class="lightbox" aria-label={t.lightbox.label}>
      <button class="button compact icon-only" type="button" data-close aria-label={t.close}><Icon name="x" /></button>
      <img alt="" decoding="async" />
    </dialog>
    <script>
      import "../scripts/deck.js";
      import "../scripts/consent.js";
      import "../scripts/lightbox.js";
    </script>
  </body>
</html>
