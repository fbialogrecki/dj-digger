---
// A recreation of the dj-digger player (Main.qml, v1.6.0) in HTML and SVG, showing a real
// SoundCloud track as the app shows it: its artwork on the record's label, its title (no artist
// line, the owner's choice), and SoundCloud's own waveform (src/assets/player/, from the public track page).
// No audio and no BPM: SoundCloud gives neither a tempo nor a key for it, so there are no
// chips and no kick light. Without JavaScript it is a still frame; player.js moves the playhead.
// One per page (its SVG ids are fixed). `eager`, `sizes` and the slot are accepted and ignored.
import { getImage } from "astro:assets";
import data from "../assets/player/temple-sourire.json";
import artwork from "../assets/player/temple-sourire.jpg";
import { hash, radialCode, seeded } from "../scripts/seeded.js";
import { ui } from "../i18n/index.mjs";

const t = ui(Astro.url.pathname);
const code = hash(data.title);

// The cover's backdrop (Main.qml Backdrop), in a 100 x 100 square: the pair's two colours
// blended along a line at a seeded angle, one of them pooled around a seeded spot.
const back = seeded(code);
const angle = back() * Math.PI * 2;
const line = { x1: 50 - Math.cos(angle) * 50, y1: 50 - Math.sin(angle) * 50, x2: 50 + Math.cos(angle) * 50, y2: 50 + Math.sin(angle) * 50 };
const stops = [back() * 0.35, 0.65 + back() * 0.35];
const pool = back() < 0.5 ? "a" : "b";
const spot = { cx: back() * 100, cy: back() * 100, r: 100 * (0.3 + back() * 0.4) };
// The record: 84% of the cover, a label of 42% of the record in one of the pair's colours,
// darkened, carrying the artwork cut to a circle (Cover labelArtwork, Vinyl artwork on).
const disc = 42;
const labelR = disc * 0.42;
const label = (code >> 5) % 2 ? "a" : "b";
const { strokes, dots } = radialCode(seeded(code), disc * 2 * 0.23, disc * 2 * 0.48, 50, 50);
// The label is at most about 60 CSS px wide; 120 px covers a 2x screen.
const art = await getImage({ src: artwork, width: 120, format: "webp" });

// The waveform over the whole track: 256 bars, each the loudest of its share of SoundCloud's samples.
const n = data.peaks.length;
const bars = Array.from({ length: 256 }, (_, i) => Math.max(...data.peaks.slice(Math.floor((i * n) / 256), Math.floor(((i + 1) * n) / 256))));
const [W, H] = [bars.length * 3, 60];
const wave = bars.map((level, i) => `M${i * 3} ${H}v${-Math.max(1, level * (H - 2)).toFixed(2)}h2V${H}z`).join("");
// Where the still frame rests and the playhead sets off: a third of the way in.
const start = Math.floor(data.duration / 3);
const at = (start / data.duration) * W;

// As the app writes it (Main.qml clock).
const clock = (seconds) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;
---

<figure
  class="player"
  data-player
  data-start={start}
  data-duration={data.duration}
  data-width={W}
  data-play={t.play}
  data-pause={t.pause}
  data-play-anim={t.player.playAnim}
  data-pause-anim={t.player.pauseAnim}
>
  <div class="player-panel">
    {/* The whole panel is one button that pauses and plays the animation; the transport sits above it. */}
    <button class="player-toggle" type="button" aria-label={t.player.pauseAnim} hidden></button>
    <svg class="player-cover" viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <linearGradient id="pl-back" gradientUnits="userSpaceOnUse" {...line}>
          <stop offset={stops[0]} class="pl-a"></stop>
          <stop offset={stops[1]} class="pl-b"></stop>
        </linearGradient>
        <radialGradient id="pl-pool" gradientUnits="userSpaceOnUse" {...spot}>
          <stop offset="0" class={`pl-${pool}`}></stop>
          <stop offset="1" class={`pl-${pool}`} stop-opacity="0"></stop>
        </radialGradient>
        <clipPath id="pl-square"><rect width="100" height="100" rx="3"></rect></clipPath>
        <clipPath id="pl-label"><circle cx="50" cy="50" r={labelR}></circle></clipPath>
      </defs>
      <g clip-path="url(#pl-square)">
        <rect width="100" height="100" fill="url(#pl-back)"></rect>
        <rect width="100" height="100" fill="url(#pl-pool)"></rect>
      </g>
      <g class="player-disc">
        <circle cx="50" cy="50" r={disc} fill="#0c0c0e"></circle>
        <circle class={`pl-label-${label}`} cx="50" cy="50" r={labelR}></circle>
        <image href={art.src} x={50 - labelR} y={50 - labelR} width={labelR * 2} height={labelR * 2} preserveAspectRatio="xMidYMid slice" clip-path="url(#pl-label)"></image>
        <g class="pl-code" stroke-width={((disc * 2) / 110).toFixed(3)}>
          <path d={strokes}></path>
          {dots.map(([x, y]) => <circle cx={x} cy={y} r={(((disc * 2) / 110) * 1.2).toFixed(3)} />)}
        </g>
      </g>
    </svg>
    <div class="player-body">
      {/* The title exactly as SoundCloud shows it; the owner wants no artist line under it. */}
      <p class="player-title">{data.title}</p>
      <svg class="player-wave" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="pl-rest" gradientUnits="userSpaceOnUse" x1="0" y1={H} x2="0" y2="0">
            <stop offset="0" class="pl-a"></stop>
            <stop offset="1" class="pl-b"></stop>
          </linearGradient>
          <clipPath id="pl-played"><rect data-played width={at.toFixed(2)} height={H}></rect></clipPath>
          <path id="pl-bars" d={wave}></path>
        </defs>
        {/* The unplayed side rests in shadow; the played side in the full rest colours. */}
        <use class="pl-unplayed" href="#pl-bars" fill="url(#pl-rest)"></use>
        <g clip-path="url(#pl-played)">
          <use href="#pl-bars" fill="url(#pl-rest)"></use>
        </g>
        <rect class="pl-cursor" data-cursor x={at.toFixed(2)} width="2.5" height={H}></rect>
      </svg>
      <div class="player-transport">
        {/* The app's own transport (Main.qml): previous, play or pause, next, stop, with its icons. */}
        <button class="player-key" type="button" data-act="previous" aria-label={t.previous} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4 H7 V20 H4 Z M20 4 L8 12 L20 20 Z"></path></svg>
        </button>
        <button class="player-key" type="button" data-act="play" aria-label={t.pause} hidden>
          <svg class="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4 L21 12 L7 20 Z"></path></svg>
          <svg class="pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4 H10 V20 H6 Z M14 4 H18 V20 H14 Z"></path></svg>
        </button>
        <button class="player-key" type="button" data-act="next" aria-label={t.next} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 4 H20 V20 H17 Z M4 4 L16 12 L4 20 Z"></path></svg>
        </button>
        <button class="player-key" type="button" data-act="stop" aria-label={t.stop} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5 H19 V19 H5 Z"></path></svg>
        </button>
        <span class="player-time"><span data-time>{clock(start)}</span> / {clock(data.duration)}</span>
      </div>
    </div>
  </div>
  {/* The owner wants no visible caption; the credit lives on About (#credits). */}
  <figcaption class="sr">
    {t.player.note} {t.player.music} {data.title}.
  </figcaption>
</figure>

<script>
  import "../scripts/player.js";
</script>
