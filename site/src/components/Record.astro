---
// The record from the app icon, seen from straight above. Its radial code is drawn by
// the same seeded generator as scripts/app_icon.py (and the artwork in Main.qml), so
// the site, the icon and the app carry the same record.
import { ARM, ARM_REST, ARM_START, ARM_END, PIVOT } from "../scripts/geometry.js";
import { hash, radialCode, seeded } from "../scripts/seeded.js";
import css from "../styles/global.css?raw";

const random = seeded(hash("dj-digger"));
const [inner, outer] = [36.5, 92.2]; // the icon's .19 and .48 of the record's width
const { strokes, dots } = radialCode(random, inner, outer);

// The arm's angles live in global.css (a style attribute would need a looser content
// security policy); fail the build if they drift from the geometry.
const angles = `--arm-start: ${ARM_START.toFixed(2)}deg;\n  --arm-end: ${ARM_END.toFixed(2)}deg;\n  --arm-rest: ${(ARM_REST - ARM_START).toFixed(2)}deg;`;
if (!css.includes(angles)) throw new Error(`global.css must define on .record:\n  ${angles}`);
---

<svg class="record" viewBox="-104 -104 232 208" aria-hidden="true">
  <defs>
    <radialGradient id="neon" gradientUnits="userSpaceOnUse" cx="0" cy="0" r={outer}>
      <stop offset="0.38" stop-color="var(--neon-foot)"></stop>
      <stop offset="1" stop-color="var(--neon-top)"></stop>
    </radialGradient>
    <linearGradient id="label" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--label-from)"></stop>
      <stop offset="1" stop-color="var(--label-to)"></stop>
    </linearGradient>
    <linearGradient id="sheen" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.09"></stop>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0.06"></stop>
    </linearGradient>
    <g id="record-code">
      <path d={strokes}></path>
      {dots.map(([x, y]) => <circle cx={x} cy={y} r="2.1" stroke="none" />)}
    </g>
    <path id="label-arc" d="M-22.5 0a22.5 22.5 0 1 1 45 0a22.5 22.5 0 1 1-45 0"></path>
  </defs>

  <circle class="vinyl" r="96"></circle>
  <g class="spin-up">
    <g class="disc">
      <g class="code">
        <use href="#record-code" />
      </g>
      <g class="code neon">
        <use href="#record-code" />
      </g>
      <circle class="label" r="32.6"></circle>
      <text class="label-text"><textPath href="#label-arc" textLength="139" lengthAdjust="spacing">DJ-DIGGER &#183; CRATE DIGGING &#183; 33 RPM &#183; STEREO &#183;</textPath></text>
      <circle class="spindle" r="2.4"></circle>
    </g>
  </g>
  <circle class="sheen" r="96"></circle>
</svg>

{/* Its own element, so that between pages the arm can lift off before the disc turns over. */}
<svg class="tonearm" viewBox="-104 -104 232 208" aria-hidden="true">
  <g transform={`translate(${PIVOT.join(" ")})`}>
    <g class="drop">
      <g class="arm">
        <path class="tube" d={`M-18 0H${ARM - 16}`}></path>
        <rect class="weight" x="-30" y="-6.5" width="16" height="13" rx="2.5"></rect>
        <path class="shell" d={`M${ARM - 18} -4.2h15l5 4.2l-5 4.2h-15z`}></path>
        <circle class="stylus" cx={ARM} cy="0" r="1.6"></circle>
      </g>
    </g>
    <circle class="bearing" r="9.5"></circle>
    <circle class="bearing-cap" r="4"></circle>
  </g>
</svg>
