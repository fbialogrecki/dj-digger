---
// A real screenshot (or a tight crop of one) in a frame, always whole at its own shape.
// It opens larger in the shared lightbox (Base.astro, lightbox.js): `full` shows the
// whole-window screenshot it was cut from, otherwise the same image. Without a script
// it is a plain link to that image. `caption` is optional.
import { getImage, Picture } from "astro:assets";
import { ui } from "../i18n/index.mjs";

// `eager` is for the one image at the top of a page; it is also fetched with high priority.
const { src, alt, caption, full, eager = false, sizes = "(min-width: 68rem) 50vw, 92vw", class: className } = Astro.props;
const t = ui(Astro.url.pathname);
const widths = [640, 960, 1280, src.width].filter((width, i, all) => width <= src.width && all.indexOf(width) === i);
const large = full ?? src;
const zoom = await getImage({ src: large, width: Math.min(2560, large.width), format: "webp" });
---

<figure class:list={["shot", className]}>
  <a href={zoom.src} data-zoom data-width={zoom.attributes.width} data-height={zoom.attributes.height}>
    <Picture src={src} alt={alt} sizes={sizes} widths={widths} formats={["avif", "webp"]} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} />
    <span class="sr">{full ? t.openFull : t.lightbox.zoom}</span>
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
