---
import Base from "../layouts/Base.astro";
import Track from "../components/Track.astro";
import Shot from "../components/Shot.astro";
import DataFlow from "../components/extension/DataFlow.astro";
import panel from "../assets/screenshots/extension-panel.png";
import connect from "../assets/screenshots/crops/connect.png";
import connectFull from "../assets/screenshots/desktop-browser-connect.png";
import { chromeStore, repo } from "../../site.config.mjs";

const description =
  "The dj-digger browser extension lets the desktop app finish download gates, fill store carts and sign in to SoundCloud in your own browser. What it does, which browsers, every permission and where data goes.";
const tracks = [
  { id: "overview", no: "01", title: "The app's hands" },
  { id: "does", no: "02", title: "What it does" },
  { id: "needs-app", no: "03", title: "It needs the desktop app" },
  { id: "browsers", no: "04", title: "Supported browsers" },
  { id: "permissions", no: "05", title: "Permissions and why" },
  { id: "data", no: "06", title: "Where your data goes" },
  { id: "end", no: "07", title: "Start with the app" },
];

// The five jobs, as the store listing's "What it does" names them.
const jobs = [
  ["Finishes download gates", "When the app cannot finish a Hypeddit or ToneDen gate by itself, the extension finishes it in your browser, and the file goes to the app."],
  ["Fills store carts", "Adds the tracks you picked to your Bandcamp cart and looks tracks up on Beatport. It never checks out or pays: checkout and payment pages are closed."],
  ["Signs in to SoundCloud", "The app can use the SoundCloud session your browser already has, so you paste nothing."],
  ["Puts the player in your toolbar", "Play, pause, skip and seek the track playing in the app, follow the running job and cancel it, and answer the app when gates need you."],
  ["Imports from SoundCloud", "On a playlist or profile, open the panel to import it, or right-click and choose Dig in dj-digger."],
];

// Released manifest, in its order. `shows` quotes the install prompts the store listing names.
const permissions = [
  ["nativeMessaging", "Communicate with cooperating native applications", "The only command channel: a link to the native host the dj-digger app installs on this computer. The app sends browser steps and receives results, player commands and SoundCloud imports; there is no other input."],
  ["tabs", "Read your browsing history", "Opens, navigates, mutes and closes the tabs and windows it creates for the app, and the sign-in popups they open, reading the address and load state of those tabs only. When an add-to-cart click cannot be verified, it screenshots its own store tab for the app's local diagnostics."],
  ["scripting", "", "Runs the extension's own bundled page functions (find, click, fill, read) in its own tabs on the allowed sites, which is how gates and carts are completed. No remote or user-supplied code is executed."],
  ["downloads", "Manage your downloads", "Recognises the file a gate in its own tab starts, tells the app where it is, and removes the browser's copy and history entry once the app has taken it. Unsafe downloads and Save-as prompts are reported as blocked, never accepted; other downloads are ignored."],
  ["cookies", "", "Exactly two hard-coded operations: reads SoundCloud's oauth_token when you sign the app in to SoundCloud, and deletes Hypeddit's filedownloading cookie between gate downloads, because Hypeddit refuses the next download while it is set. No other cookie is read, written or deleted."],
  ["webRequest", "", "Observes, never blocks or changes, the responses and redirects of its own tabs on the allowed sites, to learn a page's HTTP status and match a download to the tab that started it."],
  ["webNavigation", "", "Knows when a page in its own tab has loaded or failed, so each step waits for it. Closes its own Bandcamp or Beatport tab the moment it heads for a checkout or payment page."],
  ["storage", "", "Session storage only, cleared when the browser closes: its own tabs and windows, the link status and the player state. Nothing is synced or stored permanently."],
  ["alarms", "", "A 30-second alarm that reconnects to the app after the app was closed or the background was stopped."],
  ["offscreen", "", "Runs Hypeddit and ToneDen gates in hidden, muted frames of an offscreen document, so no browser window pops up during a hidden gate batch."],
  ["activeTab", "", "When you open the toolbar panel, reads that tab's address once to see whether it is a SoundCloud playlist or profile to import. Nothing else on the page is read."],
  ["contextMenus", "", "Adds Dig in dj-digger to the right-click menu on SoundCloud pages and links, to import that playlist, track or profile into the app. Shown only while the app is running."],
];
const hosts = [
  [
    ["https://hypeddit.com/*", "https://www.hypeddit.com/*", "https://hypd.it/*", "https://www.hypd.it/*", "https://toneden.io/*", "https://www.toneden.io/*"],
    "Free-download gates on Hypeddit and ToneDen: opens the gate, completes its steps (the e-mail form; follow, like, repost and comment steps only when you allow social actions in the app) and starts the download.",
  ],
  [
    ["https://bandcamp.com/*", "https://*.bandcamp.com/*"],
    "Adds the tracks you picked in the app to your own Bandcamp cart; artist pages are subdomains. Checkout and payment pages are never opened.",
  ],
  [
    ["https://beatport.com/*", "https://*.beatport.com/*"],
    "Looks up tracks and adds them to your Beatport cart. Checkout, payment and billing pages are never opened.",
  ],
  [
    ["https://soundcloud.com/*"],
    "The sign-in page, when you sign the app in and the browser has no session yet, and reading the oauth_token cookie. On SoundCloud pages you open, an Import to DJ digger button reads only track and playlist links; nothing on SoundCloud is clicked.",
  ],
];
const hostPrompt = "Read and change your data on hypeddit.com, toneden.io, bandcamp.com, beatport.com, soundcloud.com";
---

<Base title="The browser extension · dj-digger" description={description} label="extension" tracks={tracks}>
  <Track hero sub id="overview" no="01" title="The app's hands" label="The browser extension">
    <Fragment slot="heading">The app's hands in <span class="grad">your own browser</span></Fragment>
    <p class="lede">
      The <strong>dj-digger extension</strong> lets the desktop app finish download gates and fill store carts in the
      browser you already use, and puts the app's player in your toolbar. It does nothing on its own: the dj-digger app
      must be running on the same computer.
    </p>
    <div class="cta">
      <a class="button primary" href={chromeStore}>Add from Chrome Web Store</a>
      <a class="quiet" href="/download/">Get the desktop app first</a>
    </div>
    <div class="panel">
      <Shot
        src={panel}
        alt="The dj-digger toolbar panel playing Slow Orbit by Nightglass: generated record artwork, a seek bar at 1:08 of 3:20, and previous, pause and next buttons."
        caption="Toolbar panel, demo track"
        sizes="(min-width: 44rem) 17rem, 20rem"
        eager
      />
    </div>
  </Track>

  <Track id="does" no="02" title="What it does" label="Five jobs" heading="What it does">
    <ul class="jobs">
      {
        jobs.map(([name, text]) => (
          <li>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="needs-app" no="03" title="It needs the desktop app" label="Before you install" heading="It needs dj-digger running on this computer">
    <ol class="steps">
      <li>
        <span class="no">01</span>
        <h3>Install and start the app</h3>
        <p>The desktop app registers itself with your browsers every time it starts. <a href="/download/">Download dj-digger</a>.</p>
      </li>
      <li>
        <span class="no">02</span>
        <h3>Install the extension</h3>
        <p>From the Chrome Web Store, or with the <a href="#browsers">Firefox steps below</a>.</p>
      </li>
      <li>
        <span class="no">03</span>
        <h3>Grant site access</h3>
        <p>The extension's welcome page shows <strong>Desktop app link</strong> and <strong>Site access</strong>, and asks for the site permissions that are missing.</p>
      </li>
    </ol>
    <p class="copy">
      Installed the extension first? Its status page and toolbar panel say the app is missing and link to its download.
      In the app, <strong>Connect browser…</strong> in the Settings menu shows the steps and checks the connection.
    </p>
    <Shot
      src={connect}
      full={connectFull}
      alt="The app's Connect browser dialog. Status: Not connected, install the dj-digger extension in your browser. For Chrome, Edge and Brave: install from the Chrome Web Store, then click Check connection. For Firefox: three steps to load a temporary add-on, with the extension folder and a Copy path button. Buttons: Open Chrome Web Store, Check connection, Not now."
      caption="Connect browser, in the desktop app"
    />
  </Track>

  <Track id="browsers" no="04" title="Supported browsers" label="Where it runs" heading="Supported browsers">
    <ul class="cards">
      <li class="card">
        <h3>Chrome, Edge, Brave, Chromium</h3>
        <p>Install from the Chrome Web Store. Edge first asks to allow extensions from other stores: allow it.</p>
        <p><a class="quiet" href={chromeStore}>dj-digger in the Chrome Web Store</a></p>
      </li>
      <li class="card">
        <h3>Firefox</h3>
        <p>
          Install the signed extension file when a release provides one. Otherwise load it as a temporary add-on from the
          app's extension folder; Firefox removes it when it restarts.
        </p>
        <p><a class="quiet" href={`${repo}/blob/main/docs/installation.md#connect-your-browser`}>Firefox steps in the installation guide</a></p>
      </li>
      <li class="card">
        <h3>Not supported</h3>
        <p>Browsers installed as Flatpak or Snap cannot start the link to the app, so the extension cannot reach it.</p>
      </li>
    </ul>
  </Track>

  <Track id="permissions" no="05" title="Permissions and why" heading="Permissions, and what each one is for">
    <p class="copy">
      It works only on Hypeddit, ToneDen, Bandcamp, Beatport and SoundCloud, and acts only in the tabs it opened for
      the app. The one addition is an import button on the SoundCloud pages you open yourself.
    </p>
    <div class="table" role="region" aria-labelledby="perm-caption" tabindex="0">
      <table class="perms">
        <caption id="perm-caption">
          Every permission in the released manifest. The middle column quotes the install prompts the store listing
          names; a dash means it names none for that permission.
        </caption>
        <thead>
          <tr>
            <th scope="col">Permission</th>
            <th scope="col">What the browser shows</th>
            <th scope="col">Why it is needed</th>
          </tr>
        </thead>
        <tbody>
          <tr class="group"><th scope="rowgroup" colspan="3">Permissions</th></tr>
          {
            permissions.map(([name, shows, why]) => (
              <tr>
                <th scope="row"><code>{name}</code></th>
                <td class="shows">{shows ? `“${shows}”` : <><span aria-hidden="true">–</span><span class="sr">None named</span></>}</td>
                <td>{why}</td>
              </tr>
            ))
          }
        </tbody>
        <tbody>
          <tr class="group"><th scope="rowgroup" colspan="3">Host permissions</th></tr>
          {
            hosts.map(([patterns, why], i) => (
              <tr>
                <th scope="row">
                  {patterns.map((pattern) => (
                    <code>{pattern}</code>
                  ))}
                </th>
                {i === 0 && <td class="shows" rowspan={hosts.length}>{`“${hostPrompt}”`}</td>}
                <td>{why}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Track>

  <Track id="data" no="06" title="Where your data goes" heading="Nothing leaves this computer for us">
    <div class="split">
      <DataFlow />
      <div class="stack">
        <p class="copy">
          The extension talks only to the dj-digger app on your own computer. Nothing is sent to the developer; there are
          no analytics and no ads.
        </p>
        <ul class="ticks">
          <li>No remote code, and no messages taken from other extensions or websites</li>
          <li>Only session data, cleared when the browser closes</li>
          <li>Tabs heading for a checkout or payment page are closed</li>
        </ul>
        <p><a class="button" href={`${repo}/blob/main/PRIVACY.md`}>Read the privacy policy</a></p>
      </div>
    </div>
  </Track>

  <Track id="end" no="07" title="Start with the app" heading="No app yet? Start there.">
    <p class="copy">The extension waits for the desktop app. Install it and start it once; it connects itself to your browsers.</p>
    <div class="cta">
      <a class="button primary" href="/download/">Download the app</a>
      <a class="quiet" href="/app/">Back to the desktop app</a>
    </div>
  </Track>
</Base>

<style>
  /* Hero: the portrait panel at phone width beside the text, under it on narrow columns. */
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 44rem) {
    :global(#overview) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 34%, 17rem);
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    :global(#overview) > :global(*) {
      grid-column: 1;
      align-self: start;
    }
    :global(#overview) > .panel {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      max-width: none;
    }
  }

  .jobs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.6rem 2.2rem;
  }
  .jobs li {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .jobs p,
  .steps p {
    margin-top: 0.35rem;
    color: var(--muted);
  }
  .steps {
    display: grid;
    gap: 1.6rem;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 1rem;
    max-width: 38rem;
  }
  .steps .no {
    grid-row: span 2;
    padding-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--neon-foot);
  }
  .steps strong,
  .copy strong {
    color: var(--fg);
    font-weight: 600;
  }

  .perms {
    min-width: 42rem;
  }
  .perms caption {
    padding: 0.8rem 1rem;
    text-align: left;
    font-size: 0.84rem;
    color: var(--muted);
  }
  .perms th code {
    display: block;
    width: max-content;
  }
  .perms th code + code {
    margin-top: 0.3rem;
  }
  .perms .shows {
    min-width: 10rem;
    color: var(--fg);
  }
  .perms td:last-child {
    min-width: 17rem;
  }
  .perms .group th {
    padding-top: 1.1rem;
    font-size: 0.78rem;
    font-stretch: 112%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--panel);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
</style>
