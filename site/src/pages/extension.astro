---
import Base from "../layouts/Base.astro";
import Track from "../components/Track.astro";
import Shot from "../components/Shot.astro";
import Icon from "../components/Icon.astro";
import DataFlow from "../components/extension/DataFlow.astro";
import panel from "../assets/screenshots/extension-panel.png";
import { chromeStore } from "../../site.config.mjs";

const description =
  "The dj-digger browser extension finishes download gates, fills store carts and signs the desktop app in to SoundCloud in your own browser. What it does, which browsers, where your data goes.";

// The five jobs of extension 1.4.4 (dj-digger 1.6.0).
const jobs = [
  ["lock-key-open", "Download gates", "Finishes the Hypeddit and ToneDen gates the app cannot finish alone. The file goes to the app."],
  ["shopping-cart", "Store carts", "Adds your picks to your Bandcamp and Beatport carts. It never checks out or pays."],
  ["sign-in", "SoundCloud sign-in", "Signs the app in with the SoundCloud session your browser already has."],
  ["play-circle", "Player in your toolbar", "Play, pause, skip and seek the app's track, follow its running job, answer when gates need you."],
  ["soundcloud-logo", "Import from SoundCloud", "Send a playlist, track or profile to the app from the panel, the right-click menu or the Import to DJ digger button."],
];
---

<Base title="The browser extension · dj-digger" description={description} label="extension">
  <Track hero sub id="overview" title="The browser extension">
    <Fragment slot="heading">The browser <span class="grad">extension</span></Fragment>
    <p class="lede">
      The desktop app's hands in the browser you already use. It works while dj-digger runs on the same computer.
    </p>
    <div class="cta">
      <a class="button primary" href={chromeStore}><Icon name="google-chrome-logo" />Add from Chrome Web Store</a>
    </div>
    <div class="panel">
      <Shot
        src={panel}
        alt="The dj-digger toolbar panel playing Drift Away by JMHBM: a record on the cover art, a seek bar at 1:25 of 3:01, and previous, pause and next buttons."
        sizes="(min-width: 44rem) 17rem, 20rem"
        eager
      />
    </div>
  </Track>

  <Track id="does" title="What it does">
    <ul class="cards">
      {
        jobs.map(([icon, name, text]) => (
          <li class="card">
            <h3><Icon name={icon} />{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="browsers" title="Supported browsers">
    <p class="lede">Chrome, Edge and Brave. Edge asks to allow extensions from other stores.</p>
    <p class="copy">Browsers installed as Flatpak or Snap cannot start the link to the app.</p>
  </Track>

  <Track id="data" title="Where your data goes">
    <div class="split">
      <DataFlow />
      <p class="copy">
        The extension talks only to the dj-digger app on your computer. Nothing is sent to the developer: no analytics,
        no ads. It keeps only session data, cleared when the browser closes.
      </p>
    </div>
  </Track>

  <Track id="end" title="Start with the app">
    <p class="copy">The extension waits for the desktop app. Install it and start it once.</p>
    <div class="cta">
      <a class="button primary" href="/download/"><Icon name="download-simple" />Get the desktop app</a>
    </div>
  </Track>
</Base>

<style>
  /* Hero: the portrait panel at phone width beside the text, under it on narrow columns. */
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 44rem) {
    :global(#overview) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 34%, 17rem);
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    :global(#overview) > :global(*) {
      grid-column: 1;
      align-self: start;
    }
    :global(#overview) > .panel {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      max-width: none;
    }
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card h3 :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
</style>
