---
import { readdirSync, readFileSync, statSync } from "node:fs";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import { author, repo } from "../../../site.config.mjs";

const description =
  "Come è fatto dj-digger: l'architettura, il confine di fiducia dell'estensione del browser, le protezioni contro l'input non attendibile, la luce che segue la cassa e la sua verifica, test e release, e questo sito.";
const tracks = [
  { id: "notes", no: "01", title: "Libretto" },
  { id: "architecture", no: "02", title: "Architettura" },
  { id: "browser", no: "03", title: "Il confine del browser" },
  { id: "untrusted", no: "04", title: "Non attendibile di default" },
  { id: "kick", no: "05", title: "La luce della cassa" },
  { id: "releases", no: "06", title: "Test e release" },
  { id: "website", no: "07", title: "Questo sito" },
  { id: "credits", no: "08", title: "Crediti e fonti" },
];

// Figures are counted from the repository at build time, never typed.
// Paths are relative to the working directory (npm runs in site/), as in site.config.mjs.
const testFunctions = readdirSync("../tests", { recursive: true })
  .filter((file) => String(file).endsWith(".py"))
  .reduce((sum, file) => sum + (readFileSync(`../tests/${file}`, "utf8").match(/def test_/g) ?? []).length, 0);
const workflows = readdirSync("../.github/workflows").filter((file) => /\.ya?ml$/.test(file)).length;
const ci = readFileSync("../.github/workflows/ci.yml", "utf8");
const list = (key) => {
  const found = new RegExp(`^\\s*${key}:\\s*\\[([^\\]]+)\\]`, "m").exec(ci);
  if (!found) throw new Error(`ci.yml: no ${key} matrix`); // fail the build rather than print a wrong figure
  return found[1].split(",").map((item) => item.trim().replace(/^["']|["']$/g, ""));
};
const osName = { "ubuntu-latest": "Ubuntu", "macos-latest": "macOS", "windows-latest": "Windows" };
const ciOs = list("os").map((os) => osName[os] ?? os);
const ciPython = list("python-version");
const scriptBytes = statSync("src/scripts/deck.js").size + statSync("src/scripts/geometry.js").size;
const scriptKb = (scriptBytes / 1000).toLocaleString("it", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const count = new Intl.NumberFormat("it");
const join = (items) => (items.length > 1 ? `${items.slice(0, -1).join(", ")} e ${items.at(-1)}` : items[0]);

const spec = `${repo}/blob/main/PROJECT_SPECIFICATION.md`;
const guide = `${repo}/blob/main/docs/architecture.md`;
const validation = `${repo}/blob/main/docs/kick-pulse-validation.md`;
const workflowsUrl = `${repo}/tree/main/.github/workflows`;
// Anchors are GitHub's slugs of the specification's headings (github-slugger).
const section = {
  urls: { href: `${spec}#111-untrusted-urls-and-ssrf-boundary`, label: "§11.1 URL non attendibili e confine SSRF" },
  secrets: { href: `${spec}#112-secret-and-personal-data-handling`, label: "§11.2 Gestione di segreti e dati personali" },
  files: { href: `${spec}#113-file-and-mutation-safety`, label: "§11.3 Sicurezza di file e modifiche" },
};

const guards = [
  ["Schemi degli URL", "Campi dei brani, descrizioni, file di riepilogo, reindirizzamenti e risposte dei gate non sono attendibili, e al browser vengono passati solo URL HTTP(S) con un host.", section.urls],
  ["Confini di dominio", "I controlli di appartenenza a store e SoundCloud richiedono l'host esatto o un confine di sottodominio, mai una sottostringa, così un host somigliante non passa per uno store.", section.urls],
  ["Protezione SSRF", "Prima di ogni richiesta automatica vengono rifiutati credenziali negli URL, nomi localhost e indirizzi IP letterali non globali, e ogni reindirizzamento convalidato ha un limite; i nomi DNS non vengono risolti prima, un limite che la specifica dichiara.", section.urls],
  ["Limiti di download", "Le dimensioni dichiarate e osservate sono limitate a 2 GiB, i corpi HTML vengono rifiutati e i nomi dei file sono ridotti al nome base, con i caratteri non validi sostituiti e un prefisso davanti ai nomi riservati di Windows.", section.files],
  ["Sostituzione atomica", "I download HTTP e dal browser vengono scritti in file temporanei e pubblicati con una rinomina atomica sotto un blocco condiviso sul nome, e i file parziali vengono rimossi in caso di errore o annullamento.", section.files],
  ["Riconvalida del carrello", "Le scritture nei carrelli degli store richiedono un controllo preliminare dell'articolo esatto e una riconvalida immediata, e le scritture di rete che potrebbero duplicare una modifica su un altro sito non vengono mai ritentate in automatico.", section.files],
  ["Segreti", "Le password si digitano solo sulle pagine del servizio stesso, l'accesso a SoundCloud conserva nel portachiavi di sistema solo l'oauth_token verificato, i file dei token vengono scritti come privati prima di una sostituzione atomica, e i log della CLI oscurano le query degli URL e i campi delle credenziali.", section.secrets],
];

// The architecture diagram: boxes in the SVG's own units (320 wide), drawn in a column that holds at 328px.
const LINE = 13;
const box = (x, y, w, h, lines, kind = "") => ({ x, y, w, h, lines, kind });
const nodes = [
  box(1, 18, 154, 36, ["CLI"], "ctl"),
  box(165, 18, 154, 36, ["Desktop Qt Quick"], "ctl"),
  box(1, 82, 318, 46, ["ApplicationServices", "lazy: non importa Qt, non apre nulla prima dell'uso"], "named"),
  box(1, 154, 110, 62, ["Servizi di", "raccolta,", "download, acquisti", "e account"]),
  box(119, 154, 96, 62, ["Servizio", "libreria"]),
  box(223, 154, 96, 62, ["Servizio", "riproduzione"]),
  box(1, 242, 110, 50, ["Adattatori", "SoundCloud,", "gate e store"]),
  box(119, 242, 96, 50, ["Repository"]),
  box(223, 242, 96, 50, ["Motore audio", "in memoria"]),
  box(119, 318, 96, 44, ["SQLite", "thread titolare"], "owner"),
  box(1, 378, 318, 58, ["OperationCoordinator", "uno slot principale, uno di scansione: ammette", "il lavoro e segue l'annullamento fino alla fine"], "named coord"),
];
const wires = [[78, 54, 80], [242, 54, 80], [56, 128, 152], [167, 128, 152], [271, 128, 152], [56, 216, 240], [167, 216, 240], [271, 216, 240], [167, 292, 316]];
const baseline = (node, i) => node.y + node.h / 2 - ((node.lines.length - 1) * LINE) / 2 + 4 + i * LINE;
---

<Base title="Libretto: come è fatto dj-digger" description={description} label="notes" tracks={tracks}>
  <Track id="notes" no="01" title="Libretto" hero sub>
    <Fragment slot="heading">Libretto: <span class="grad">come è fatto dj-digger</span></Fragment>
    <p class="lede">
      Il retro della copertina: come è costruita l'app, dove traccia i suoi confini e come viene verificata. Ogni
      affermazione qui rimanda al documento o al file da cui proviene.
    </p>
    <p class="copy">
      Scritto, progettato e stampato da <a href={author.url}>{author.name}</a>.
    </p>
    <ul class="facts">
      <li>Python 3.12+</li>
      <li>Qt Quick</li>
      <li>Estensione Manifest V3</li>
      <li>SQLite</li>
      <li>Nessun server dj-digger</li>
    </ul>
  </Track>

  <Track id="architecture" no="02" title="Architettura" heading="I controller presentano, i servizi possiedono gli effetti">
    <p class="lede">
      La CLI e il desktop Qt sono controller sopra gli stessi servizi applicativi. I controller gestiscono la
      presentazione; i servizi gestiscono gli effetti completati e il ciclo di vita delle risorse; un coordinatore ammette
      il lavoro e segue l'annullamento finché i worker non hanno finito.
    </p>
    <figure class="diagram">
      <svg class="arch" viewBox="0 0 320 438" role="img" aria-labelledby="arch-title arch-desc">
        <title id="arch-title">Come è composto dj-digger</title>
        <desc id="arch-desc">
          La CLI e il desktop Qt Quick sono controller sopra ApplicationServices, che compone i servizi applicativi in
          modo lazy e non importa Qt. I servizi di raccolta, download, acquisti e account usano gli adattatori per
          SoundCloud, gate e store. Il servizio libreria lavora tramite i repository sul thread titolare di SQLite. Il
          servizio di riproduzione pilota il motore audio in memoria. L'OperationCoordinator, con uno slot principale e
          uno slot di scansione, ammette il lavoro e segue l'annullamento finché i worker non hanno finito.
        </desc>
        <defs>
          <marker id="arch-tip" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path class="tip" d="M0 0L8 4L0 8z"></path>
          </marker>
        </defs>
        <text class="group" x="1" y="10">CONTROLLER</text>
        {wires.map(([x, from, to]) => <path class="wire" d={`M${x} ${from}V${to}`} marker-end="url(#arch-tip)" />)}
        {
          nodes.map((node) => (
            <g class={node.kind}>
              <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
              {node.lines.map((line, i) => (
                <text x={node.x + node.w / 2} y={baseline(node, i)} class={node.kind.includes("named") && i > 0 ? "sub" : undefined}>
                  {line}
                </text>
              ))}
            </g>
          ))
        }
      </svg>
    </figure>
    <ul class="ticks rules">
      <li>
        <strong>Nessun lavoro bloccante sul thread dell'interfaccia.</strong> Il backend, il bridge dei segnali Qt, il
        modello della tabella e la finestra QML si dividono orchestrazione, segnali, righe e rendering; nessuno di loro
        esegue lavoro bloccante di rete o su disco sul thread dell'interfaccia, e i risultati vengono riconsegnati a quel
        thread (<a href={`${guide}#ui-ownership`}>Proprietà dell'interfaccia</a>).
      </li>
      <li>
        <strong>Un solo thread possiede SQLite.</strong> Le transazioni sono esplicite e brevi, al loro interno non
        avvengono operazioni di rete, del browser o finestre di dialogo, stato e provenienza dei file vengono confermati
        insieme, e le copie in memoria cambiano solo dopo il commit
        (<a href={`${guide}#persistent-effects-and-identity`}>Effetti persistenti e identità</a>).
      </li>
      <li>
        <strong>La composizione non importa Qt.</strong> Costruire <code>ApplicationServices</code> non importa Qt e non
        apre alcun database, dispositivo o connessione al browser; la CLI e il desktop ne ricevono lo stesso servizio di
        raccolta lazy (<a href={`${guide}#composition-and-execution`}>Composizione ed esecuzione</a>).
      </li>
    </ul>
    <p class="copy">
      La guida dice anche cosa il progetto non pretende: niente DNS pinning, nessun audit di sicurezza e nessuna
      transazione che abbracci file system e SQLite.
    </p>
    <p><a class="quiet" href={guide}>Leggi la guida all'architettura</a></p>
  </Track>

  <Track id="browser" no="03" title="Il confine del browser" heading="Guidare il tuo browser senza impossessarsene">
    <p class="lede">
      Gate e carrelli girano nel browser reale dell'utente, con i suoi accessi, quindi l'estensione impone i propri
      limiti, qualunque cosa le invii l'app desktop.
    </p>
    <div class="movement">
      <h3>Un solo canale, niente codice remoto</h3>
      <p class="copy">
        L'unico input di comando è la porta di native messaging dell'app sullo stesso computer: il manifest non ha
        né <code>externally_connectable</code> né <code>web_accessible_resources</code>, e nessuno script di pagina
        ascolta <code>window.postMessage</code>. Non c'è <code>eval</code>; le uniche funzioni eseguite in una pagina sono
        funzioni con nome, di sola lettura, incluse nell'estensione. Dal lato dell'app la cartella del socket è privata
        dell'utente e i peer si autenticano con una chiave in un file 0600.
      </p>
    </div>
    <div class="movement">
      <h3>Un elenco fisso di siti</h3>
      <p class="copy">
        Un unico <code>allowlist.json</code> guida lo script in background, e un test lo confronta con gli elenchi di host
        in Python e con i permessi host del manifest: HTTPS sulla porta predefinita, senza credenziali, verso Hypeddit,
        ToneDen, Bandcamp e Beatport, più la pagina di accesso di SoundCloud. La navigazione verso qualsiasi altro
        indirizzo viene rifiutata.
      </p>
    </div>
    <div class="movement">
      <h3>Solo le proprie schede</h3>
      <p class="copy">
        I comandi agiscono sulle schede e sulle finestre di lavoro create dall'estensione e sui loro popup, mai sulle
        altre schede dell'utente. Per leggere o cliccare serve anche che l'indirizzo attuale della scheda sia
        nell'allowlist; qualsiasi altro indirizzo viene ridotto a <code>https://&lt;host&gt;/</code> prima di essere
        riportato, e i parametri OAuth vengono rimossi. Ogni scheda dell'estensione è silenziata.
      </p>
    </div>
    <div class="movement">
      <h3>Uno stop netto prima del denaro</h3>
      <p class="copy">
        Una scheda Bandcamp o Beatport dell'estensione che naviga o viene reindirizzata verso un percorso di checkout,
        checkout del carrello, pagamento o fatturazione viene chiusa e segnalata. I clic su elementi chiamati check out,
        pay, purchase, place order, buy now o complete order vengono rifiutati, e la compilazione dei moduli rifiuta i
        campi della password e della carta di pagamento.
      </p>
    </div>
    <div class="cta">
      <a class="quiet" href={`${spec}#114-browser-extension-trust-boundary`}>§11.4 Confine di fiducia dell'estensione del browser</a>
      <a class="quiet" href={`${repo}/blob/main/CHROMEWEBSTORE.md`}>Giustificazioni dei permessi</a>
      <a class="quiet" href="/it/extension/">La pagina dell'estensione</a>
    </div>
  </Track>

  <Track id="untrusted" no="04" title="Non attendibile di default" heading="Ogni link è non attendibile">
    <p class="lede">
      Link degli artisti, reindirizzamenti, risposte dei servizi e nomi dei file sono trattati come input ostile. Queste
      protezioni esistono nel codice; ognuna rimanda alla parte della specifica che la dichiara.
    </p>
    <ul class="guards">
      {
        guards.map(([name, text, source]) => (
          <li>
            <h3>{name}</h3>
            <p>{text}</p>
            <a href={source.href}>{source.label}</a>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="kick" no="05" title="La luce della cassa" heading="Una luce che segue la cassa, non il basso">
    <p class="lede">
      La luce del player segue un livello continuo della cassa, ricavato dall'audio prima che arrivi all'altoparlante,
      invece di decisioni sì-o-no sui battiti, così una decisione mancata non può mai fermarla.
    </p>
    <Loop>Ripreso dall'app vera con un brano demo sintetico. Il renderer software usato per la cattura non disegna il bagliore della GPU, quindi la luce reale è più intensa.</Loop>
    <div class="movement">
      <h3>Cosa segue la luce</h3>
      <p class="copy">
        <code>beats.py</code> confronta ogni banda a bassa frequenza dell'audio decodificato con la sua mediana recente,
        così un basso tenuto, la ripresa dopo un sidechain o un pad diventano il riferimento e conta solo ciò che sale
        sopra. Quella salita viene pesata in base a quanto somiglia a una cassa. La cassa propria di un brano viene appresa
        solo dai colpi che scendono di intonazione, così una nota di basso ripetuta non lo diventa mai
        (<a href={`${spec}#34-audio-preview`}>§3.4 Anteprima audio</a>).
      </p>
    </div>
    <div class="movement">
      <h3>In anticipo sull'altoparlante</h3>
      <p class="copy">
        Il player decodifica in anticipo rispetto al dispositivo audio, così ogni livello esiste prima che il suo suono
        venga sentito, e la finestra lo legge rispetto al tempo che raggiunge davvero l'altoparlante, misurato da ciò che
        il dispositivo ha già preso. Il 1° ottobre 2026, riproducendo un brano da 60 s sulla macchina di sviluppo
        (PipeWire, periodi da 50 ms), i livelli arrivavano 184–189 ms oltre la posizione del dispositivo, mentre la coda
        misurata del dispositivo era di 46–71 ms; l'analisi richiedeva circa lo 0,57 % del tempo reale.
      </p>
    </div>
    <div class="movement">
      <h3>La forma della luce</h3>
      <p class="copy">
        La luce è analogica: salta subito al livello della cassa e si spegne in modo esponenziale, come una lampada, così
        una cassa piena torna al buio prima della successiva e i colpi bassi più deboli appaiono più tenui e più brevi
        (<a href={`${spec}#38-qt-quick-desktop`}>§3.8 Desktop Qt Quick</a>). Un colore di riposo pastello più chiaro un
        tempo faceva sembrare la cassa una luce che si spegne; nei colori saturi misurati il 1° ottobre 2026 il neon è
        da 2,1 a 2,2 volte più luminoso del riposo.
      </p>
    </div>
    <div class="movement">
      <h3>Verificato nella finestra reale</h3>
      <p class="copy">
        Le misure offline dicevano che due brani segnalati andavano bene, così il 1° ottobre 2026 è stato eseguito lo stack
        reale (finestra, bridge, backend, player e dispositivo audio; silenziato, offscreen, su uno stato applicativo
        isolato) registrando a ogni frame la luce, l'orologio e i livelli della finestra. Ha trovato due bug fuori
        dall'analisi. I livelli tra 0 e 1 erano float di numpy, che Qt passa a QML come oggetti opachi e non come numeri,
        quindi accendevano qualcosa solo i livelli esattamente 0 e 1; ora i livelli sono float semplici. E dopo un avvio il
        dispositivo prendeva subito i primi 50 ms e i successivi solo più tardi, così il tempo udito veniva bloccato alla
        posizione consegnata ed era in anticipo di circa 70 ms, a scatti di 50 ms; ora la coda non viene mai considerata
        inferiore a quanto consegnato dall'ultima callback.
      </p>
      <div class="table">
        <table>
          <caption>Kalipo – Captain, 45–105 s, dal vivo nella finestra reale, 1° ottobre 2026</caption>
          <thead>
            <tr><th scope="col">Misura</th><th scope="col">Prima</th><th scope="col">Dopo</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Casse sotto 0,3 di luminosità</th><td>20 su 114</td><td>0</td></tr>
            <tr><th scope="row">Cassa più tenue</th><td>0,00</td><td>0,95</td></tr>
            <tr><th scope="row">Frame con l'orologio fermo alla posizione dello snapshot</th><td>54 %</td><td>0 %</td></tr>
            <tr><th scope="row">Salti oltre 20 ms nel tempo udito</th><td>1199</td><td>0</td></tr>
          </tbody>
        </table>
      </div>
      <p class="copy">
        Su un secondo brano, dopo la correzione, 62 casse avevano una luminosità mediana di 0,94 e nessuna scendeva sotto
        0,3, con la finestra a 63 frame al secondo e nessun intervallo tra frame oltre 28 ms.
      </p>
    </div>
    <p><a class="quiet" href={validation}>Leggi le note di verifica</a></p>
  </Track>

  <Track id="releases" no="06" title="Test e release" heading="Dal commit all'installer">
    <p class="lede">
      {workflows} file di workflow portano una modifica da un commit agli installer e agli store. Ogni passaggio qui
      sotto è ciò che il workflow esegue, come lo registra la specifica.
    </p>
    <ol class="steps">
      <li>
        <span class="no">01</span>
        <h3>Suite offline</h3>
        <p>
          {count.format(testFunctions)} funzioni di test in <code>tests/</code>. Di default i marker live sono esclusi,
          una fixture autouse sposta config, auth, database e cartelle di scansione in una directory temporanea, e il
          trasporto HTTP predefinito è bloccato, così nessun test raggiunge un endpoint live, dati dell'utente o cartelle
          musicali. La CI la esegue a ogni push e pull request su {join(ciOs)} con Python {join(ciPython)} ({ciOs.length * ciPython.length} job),
          dopo il controllo della mappa della specifica e Ruff, e in ogni job compila e verifica un'installazione isolata del wheel.
        </p>
      </li>
      <li>
        <span class="no">02</span>
        <h3>Controlli live dei contratti</h3>
        <p>
          Un workflow settimanale esegue la suite live, marcata a parte, contro l'API di SoundCloud: scoperta del client
          ID, raccolte lunghe, idratazione, disponibilità dei media e decodifica del socket. È un monitoraggio, non un
          requisito per la release. I controlli di store e gate si fanno a mano: pagine pubbliche degli store lette tramite
          l'estensione senza accedere né toccare un carrello, e ispezione dei gate solo con GET.
        </p>
      </li>
      <li>
        <span class="no">03</span>
        <h3>Installer</h3>
        <p>
          I contratti del desktop e un avvio isolato girano su Linux, Windows e macOS. Poi la CI compila l'installer
          Windows x64 e le immagini disco native macOS arm64 e x86_64, verifica il runtime incluso e l'installazione di
          ciascuno, e carica ognuno come artefatto di test con accanto un file SHA-256. Sono
          anteprime non firmate; i test su dispositivi fisici restano a parte.
        </p>
      </li>
      <li>
        <span class="no">04</span>
        <h3>Pubblicazione</h3>
        <p>
          Una release stabile pubblicata esegue la propria matrice di test, poi carica su PyPI tramite trusted publishing
          (OIDC); solo quel job può richiedere un token di identità, e le action di terze parti sono fissate a commit
          precisi. La stessa release impacchetta l'estensione e la invia al Chrome Web Store tramite la sua API,
          autenticandosi come account di servizio. Le prerelease saltano entrambi i passaggi.
        </p>
      </li>
    </ol>
    <div class="cta">
      <a class="quiet" href={`${spec}#14-verification-ci-and-release`}>§14 Verifica, CI e release</a>
      <a class="quiet" href={workflowsUrl}>I workflow</a>
    </div>
  </Track>

  <Track id="website" no="07" title="Questo sito" heading="Questo sito">
    <p class="lede">Il colophon. Le cifre vengono contate quando il sito viene generato.</p>
    <dl class="spec">
      <dt>Stack</dt>
      <dd>Pagine Astro statiche e CSS semplice. Nessun framework UI e nessuna dipendenza a runtime: Astro gira solo in fase di build.</dd>
      <dt>Il disco</dt>
      <dd>
        SVG inline dallo stesso generatore con seed dell'icona dell'app (<code>scripts/app_icon.py</code>). Le animazioni
        CSS guidate dallo scroll lo fanno girare e muovono il braccio; dove mancano, un piccolo script fa da ripiego.
      </dd>
      <dt>Peso degli script</dt>
      <dd>
        {scriptKb} kB per lo script del disco (<code>deck.js</code> e <code>geometry.js</code>): sorgente, prima di
        minificazione e compressione.
      </dd>
      <dt>Richieste a terzi</dt>
      <dd>Nessuna. Niente analytics, niente cookie, font ospitati sul sito.</dd>
      <dt>Screenshot</dt>
      <dd>
        Interfaccia reale con dati demo, rigenerata insieme al loop del player qui sopra
        da <code>scripts/site_screenshots.py</code>.
      </dd>
      <dt>Accessibilità</dt>
      <dd>Uso completo da tastiera, una tracklist testuale accanto al disco, animazioni disattivate con il movimento ridotto, completo anche senza JavaScript.</dd>
      <dt>Sorgente</dt>
      <dd><a href={`${repo}/tree/main/site`}>La cartella del sito nel repository</a></dd>
    </dl>
  </Track>

