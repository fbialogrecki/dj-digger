---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import mainWindow from "../../assets/screenshots/it/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/it/desktop-crates-decisions.png";
import storesWindow from "../../assets/screenshots/it/desktop-store-links.png";
import gatesWindow from "../../assets/screenshots/it/desktop-jobs-gates.png";
import cartWindow from "../../assets/screenshots/it/desktop-cart.png";
import libraryWindow from "../../assets/screenshots/it/desktop-local-library.png";
import exportWindow from "../../assets/screenshots/it/desktop-export.png";
import sidebar from "../../assets/screenshots/it/crops/sidebar.png";
import decisions from "../../assets/screenshots/it/crops/decisions.png";
import stores from "../../assets/screenshots/it/crops/stores.png";
import gates from "../../assets/screenshots/it/crops/gates.png";
import cart from "../../assets/screenshots/it/crops/cart.png";
import library from "../../assets/screenshots/it/crops/library.png";
import exportDialog from "../../assets/screenshots/it/crops/export.png";

const description =
  "L'app desktop dj-digger: raccogli playlist SoundCloud intere, ascoltale, ricorda ogni decisione, segui i link Bandcamp e Beatport, risolvi i gate di download, riempi i carrelli ed esporta i file per i tuoi deck.";
---

<Base title="L'app desktop · dj-digger" description={description} label="app">
  <Track hero sub id="overview" title="Tutto il ciclo">
    <Fragment slot="heading">Tutto il ciclo del digging <span class="grad">in una finestra</span></Fragment>
    <p class="lede">Ogni immagine di questa pagina è l'app vera, con dati demo.</p>
    <div class="cta">
      <a class="button primary" href="/it/download/"><Icon name="download-simple" />Scarica</a>
    </div>
    <Shot
      src={mainWindow}
      eager
      alt="La finestra principale di dj-digger. Una barra laterale elenca tre playlist SoundCloud, con Late Night Selects selezionata, sopra le cartelle Download e Musica. Il player in alto mostra Drift Away di JMHBM a 1:21 di 3:01, con una copertina a disco generata e una forma d'onda magenta. Sotto, un campo di ricerca, i filtri degli store (Bandcamp 4, Beatport 3, Hypeddit 3, Traxsource 1, Juno Download 1), un filtro di stato e una tabella di 14 brani, ognuno con stato, artista, titolo, genere, anno, etichetta, durata e un badge dello store."
    />
  </Track>

  <Track id="collect" title="Raccogli" heading="Playlist intere, non una pagina scorsa">
    <div class="beside">
      <div class="beside-grid">
        <div class="stack">
          <p class="lede">L'app legge l'intera raccolta tramite l'API di SoundCloud.</p>
          <ul class="ticks">
            <li>Playlist e set, like, repost, profili di artisti e singoli brani</li>
            <li>L'importazione riempie la tabella a blocchi e viene salvata quando è arrivato tutto</li>
            <li>Accedi a SoundCloud per leggere le tue playlist private</li>
            <li>Aggiornando una playlist, i brani nuovi finiscono in cima, segnati <code>Nuovo</code></li>
          </ul>
        </div>
        <Shot
          src={sidebar}
          full={libraryWindow}
          sizes="220px"
          alt="La barra laterale: un campo per filtrare playlist e cartelle; tre playlist SoundCloud, Late Night Selects con 14 brani, Sunday Balcony con 4 e Warehouse Warmups con 6, e un pulsante più per aggiungerne una; sotto, le Cartelle con Download e Musica, dove è selezionata la cartella Digging 2026 con sette file."
        />
      </div>
    </div>
  </Track>

  <Track id="audition" title="Ascolta" heading="Un'anteprima che sente la cassa">
    <p class="lede">Ascolta l'anteprima da SoundCloud, o il file su disco quando ce l'hai.</p>
    <Loop />
    <ul class="ticks">
      <li>Salta nel brano dalla forma d'onda; il brano successivo viene preparato in anticipo</li>
      <li>A ogni cassa la parte già suonata della forma d'onda si accende, seguendo la cassa, non il basso</li>
      <li>Le anteprime vengono decodificate in memoria e mai salvate su disco</li>
      <li>Cerca, filtra e ordina senza lasciare la playlist; <kbd>?</kbd> elenca tutte le scorciatoie</li>
      <li>Visualizza → Animazioni spegne la luce</li>
    </ul>
  </Track>

  <Track id="decide" title="Decidi" heading="Crate che ricordano">
    <p class="lede">Ce l'ho, saltato, ascoltato e aperto: ogni brano conserva il suo stato.</p>
    <Shot
      src={decisions}
      full={decisionsWindow}
      alt="La tabella dei brani con il filtro di stato aperto, che offre «Tutti gli stati», «Non gestiti», «Nuovo», «Aperti», «Posseduti» e «Saltati». La colonna Stato riporta «Ce l'ho», «Ce l'ho», «Ascoltato», «Ce l'ho», «Aperto» e «Nuovo» accanto a Nightglass, Coral Engine, Sable Fern, Tidewell, Ostra Lumen e Pale Circuit; sopra la tabella, i filtri degli store come Bandcamp 4 e Beatport 3."
    />
    <ul class="ticks">
      <li>Scansiona le tue cartelle musicali: una corrispondenza sicura di artista e titolo viene segnata come posseduta e suona dal disco</li>
      <li><kbd>H</kbd> mostra solo i brani ancora da gestire, e poi di nuovo tutti</li>
      <li>Filtra per stato, store, genere e altro</li>
    </ul>
  </Track>

  <Track id="acquire" title="Procurati" heading="La via più sicura per ogni brano">
    <p class="lede">Tre strade verso il file. Ognuna dice cosa resta a te.</p>

    <div class="movement stack">
      <h3>Ogni link, classificato</h3>
      <p class="copy">
        I link di acquisto e di download vengono classificati con un confronto rigoroso del dominio: Bandcamp, Beatport,
        Traxsource, Juno Download, Apple, negozi di dischi, gate di download, smart link e download gratuiti da
        SoundCloud. Un link che si rivela un elenco di negozi viene aperto, e i link Bandcamp e Beatport che contiene
        finiscono sul brano.
      </p>
      <p class="manual"><strong>Resta a te</strong> Quale link aprire: <kbd>O</kbd> o <kbd>Invio</kbd> apre nel browser i link dei brani selezionati.</p>
      <Shot
        src={stores}
        full={storesWindow}
        alt="La tabella dei brani filtrata con i filtri degli store Bandcamp 4 e Beatport 3: 7 brani su 14, ognuno con un badge Bandcamp o Beatport nella colonna Store."
      />
    </div>

    <div class="movement stack">
      <h3>Gate di download, risolti</h3>
      <p class="copy">
        I gate che chiedono un follow per scaricare, su Hypeddit, ToneDen, GateRush e Droploud, vengono risolti tramite
        i loro flussi di download. Quando un gate ha bisogno del browser, l'estensione ne esegue i passaggi senza mostrarli e il file
        arriva nell'app. I passaggi social seguono <em>Consenti azioni social</em> nelle Impostazioni, attivo di
        default; se lo disattivi, quei gate restano manuali.
      </p>
      <p class="manual"><strong>Resta a te</strong> CAPTCHA, accessi ai provider e prime approvazioni. L'app chiede prima, e una finestra del browser si apre solo se lo scegli tu.</p>
      <Shot
        src={gates}
        full={gatesWindow}
        alt="La finestra «I gate richiedono il tuo intervento»: «Questi gate richiedono qualcosa che puoi fare solo tu, come un accesso o un CAPTCHA», sopra un elenco di tre brani, ognuno con un gate che chiede di risolvere un CAPTCHA, e i pulsanti «Apri nel browser», «Salta questi» e «Interrompi download»."
      />
    </div>

    <div class="movement stack">
      <h3>Carrelli, mai il checkout</h3>
      <p class="copy">
        Spunta i brani e l'app riempie il tuo carrello Bandcamp, e quello Beatport quando il brano esatto è noto, in
        schede in background del tuo browser. Ogni pagina prodotto viene ricontrollata subito prima del clic; un titolo
        ambiguo, un prezzo cambiato o un brano venduto solo con l'album fermano tutto invece di tirare a indovinare.
      </p>
      <p class="manual"><strong>Resta a te</strong> Il checkout. Una scheda del carrello per store diventa tua; l'app non legge mai la tua password, non sceglie un metodo di pagamento e non paga.</p>
      <Shot
        src={cart}
        full={cartWindow}
        alt="La finestra «Risultati del carrello»: «Aggiunti ai carrelli: 4. Non aggiunti: 1», un elenco di cinque brani con esiti come nel carrello Bandcamp, già nel carrello Bandcamp e in playlist, e i pulsanti «Apri i link non aggiunti», «Mostra i carrelli» e «Chiudi»."
      />
    </div>
  </Track>

  <Track id="prepare" title="Prepara" heading="Pronti per i deck">
    <p class="lede">Le cartelle su disco si aprono nella stessa tabella, e ne escono come copie che i tuoi deck leggono.</p>

    <div class="movement stack">
      <h3>La tua libreria locale</h3>
      <p class="copy">
        Sfoglia le cartelle accanto alle tue playlist e crea da esse playlist locali. BPM e tonalità vengono stimati sul
        tuo computer e si possono correggere a mano; l'analisi non scrive mai tag audio né dati rekordbox. WAV, AIFF,
        FLAC, MP3, AAC e M4A.
      </p>
      <Shot
        src={library}
        full={libraryWindow}
        alt="Una cartella locale nella tabella dei brani: sette file, Drift Away di JMHBM segnato «Ascoltato» e gli altri «Nuovo», con BPM da 120 a 130 e tonalità 9A, 8A, 10A, 5A, 7A e 8B."
      />
    </div>

    <div class="movement stack">
      <h3>Esporta per i deck</h3>
      <p class="copy">
        Spunta i deck su cui i file devono suonare e l'app sceglie il formato migliore che leggono tutti: FLAC se ogni
        deck scelto lo legge, altrimenti WAV, alla profondità di bit e frequenza di campionamento più alte che hanno in
        comune. I file che i deck già riproducono vengono copiati così come sono; solo gli altri vengono convertiti, in
        una nuova cartella.
      </p>
      <p class="manual"><strong>Dove si ferma</strong> Le regole vengono dal manuale di ogni deck: è compatibilità dei file audio, non un test sull'hardware né un'esportazione rekordbox. Non fa mai upsampling e non formatta mai un drive.</p>
      <Shot
        src={exportDialog}
        full={exportWindow}
        alt="La finestra «Esporta audio»: «Scegli i deck su cui questi file devono suonare; verrà scelto il formato migliore supportato da tutti.» Dieci gruppi di deck come caselle, da CDJ-350 a OMNIS-DUO e XDJ-AN, cinque dei quali spuntati; una cartella di destinazione vuota con «Sfoglia…», Modalità impostata su «Copia», «Includi sottocartelle» non spuntato, e i pulsanti «Esporta» e «Annulla»."
      />
    </div>
  </Track>

  <Track id="requirements" title="Requisiti di sistema">
    <p class="copy">Windows 10+, macOS 15+ e Linux.</p>
  </Track>

  <Track id="end" title="Scaricala" heading="Mettila sul piatto">
    <p class="copy">Poi collega il tuo browser: i gate di download e i carrelli degli store passano dall'estensione.</p>
    <div class="cta">
      <a class="button primary" href="/it/download/"><Icon name="download-simple" />Scarica</a>
      <a class="button" href="/it/extension/"><Icon name="puzzle-piece" />Scopri l'estensione</a>
    </div>
  </Track>
</Base>

<style>
  /* Collect: the tall sidebar crop stands beside its text once the column has room. */
  .beside {
    container-type: inline-size;
  }
  .beside-grid {
    display: grid;
    gap: 2rem;
  }
  /* The figure is rendered by <Shot>, outside this page's scope. */
  .beside :global(.shot) {
    max-width: 13.75rem;
  }
  @container (min-width: 36rem) {
    .beside-grid {
      grid-template-columns: minmax(0, 1fr) 13.75rem;
      align-items: start;
    }
  }

  /* What each way to a track leaves to you: a margin note, not an alert. */
  .manual {
    max-width: 38rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--edge);
    color: var(--muted);
  }
  .manual strong {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--fg);
  }
</style>
