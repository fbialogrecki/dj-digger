---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Shot from "../../components/Shot.astro";
import Track from "../../components/Track.astro";
import collect from "../../assets/screenshots/it/crops/collect.png";
import decisions from "../../assets/screenshots/it/crops/decisions.png";
import panelJob from "../../assets/screenshots/extension-panel-job.png";
import libraryWindow from "../../assets/screenshots/it/desktop-local-library.png";
import playerWindow from "../../assets/screenshots/it/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/it/desktop-crates-decisions.png";
import { version } from "../../../site.config.mjs";

const description =
  "Importa playlist e preferiti da SoundCloud, ascolta i brani e segna quelli che possiedi. Trova i link degli artisti per acquistare o scaricare la musica.";
const loop = [
  {
    name: "Raccogli",
    text: "Incolla il link di una playlist, dei like o di un profilo. Arriva l'elenco completo, non solo le righe che una pagina ha mostrato.",
    src: collect,
    full: playerWindow,
    alt: "La finestra di dj-digger: la playlist Late Night Selects aperta nella barra laterale, il player su Drift Away di JMHBM a 1:21 di 3:01 con la sua forma d'onda, i filtri degli store come Bandcamp 4 e Beatport 3, e le prime righe della tabella dei brani.",
  },
  {
    name: "Decidi",
    text: "Segna i brani come posseduti o saltati. La decisione segue il brano in ogni playlist in cui compare.",
    src: decisions,
    full: decisionsWindow,
    alt: "La tabella dei brani con il filtro di stato aperto: righe segnate «Ce l'ho», «Ascoltato», «Aperto» e «Nuovo», e un menu che offre «Tutti gli stati», «Non gestiti», «Nuovo», «Aperti», «Posseduti» e «Saltati».",
  },
  {
    name: "Compra o scarica",
    text: "Da qui fa il resto l'estensione del browser, nel tuo browser: risolve i gate di download e riempie i carrelli degli store. Il checkout resta a te.",
    src: panelJob,
    alt: "Il pannello dell'estensione dj-digger: Drift Away di JMHBM a 1:27 di 3:01, i pulsanti di trasporto e sotto «Aggiunta ai carrelli degli store» con un pulsante «Annulla».",
  },
];
---

<Base title="dj-digger: app gratuita di crate digging per SoundCloud" description={description}>
  <section class="hero" id="start" aria-labelledby="start-title">
    <h1 id="start-title">Da una playlist SoundCloud ai <span class="grad">file sui tuoi deck</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> è un'app gratuita e open source per DJ. Importa playlist o preferiti, ascolta i brani e segna quelli che possiedi già. Se un artista indica uno store o un download gratuito, puoi aprire il link dalla stessa playlist.
    </p>
    <div class="cta">
      <a class="button primary" href="/it/download/"><Icon name="download-simple" />Scarica</a>
    </div>
    <ul class="facts">
      <li>Gratuito e open source</li>
      <li>Windows, macOS, Linux</li>
      <li>Nessun account, nessun backend</li>
    </ul>
    <Loop eager />
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the three steps
      one at a time. Everywhere else, and without the CSS below, three stacked steps. */}
  <section id="loop" class="loop" aria-labelledby="loop-title">
    <div class="stage stack">
      <h2 id="loop-title">Un solo ciclo, dall'inizio alla fine</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step) => (
            <li class="movement">
              <div class="text">
                <h3>{step.name}</h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" title="L'app desktop">
    <Shot
      src={libraryWindow}
      alt="La finestra principale di dj-digger su una cartella locale, Digging 2026: il player su Drift Away di JMHBM a 1:27 di 3:01 e sette brani con BPM da 120 a 130 e tonalità come 9A, 8A e 5A."
    />
    <ul class="ticks">
      <li>Sa cosa possiedi già</li>
      <li>Stima BPM e tonalità</li>
      <li>Esporta per i tuoi deck</li>
    </ul>
    <div class="cta"><a class="button" href="/it/app/"><Icon name="desktop" />Scopri l'app</a></div>
  </Track>

  <Track id="extension" title="L'estensione del browser">
    <p class="copy">
      Nel tuo Chrome, Edge o Brave risolve i gate di download, riempie i carrelli degli store e mette il player nella
      barra degli strumenti.
    </p>
    <div class="cta"><a class="button" href="/it/extension/"><Icon name="puzzle-piece" />Scopri l'estensione</a></div>
  </Track>

  <Track id="trust" title="Tua, e onesta" heading="Tua, e onesta sui propri limiti">
    <ul class="ticks">
      <li>Le tue playlist e le tue decisioni restano sul tuo computer.</li>
      <li>Non paga e non fa mai il checkout al posto tuo.</li>
      <li>Non tira mai a indovinare: una corrispondenza incerta si ferma e viene segnalata.</li>
    </ul>
  </Track>

  <Track id="get" title="Scarica" heading="Scarica dj-digger">
    <p class="copy">dj-digger {version}, gratuito per Windows, macOS e Linux.</p>
    <div class="cta"><a class="button primary" href="/it/download/"><Icon name="download-simple" />Scarica</a></div>
  </Track>
</Base>

<style>
  /* ---------- the loop: three stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each shot keeps its own shape; the frame sits on the image so it hugs narrow and wide shots alike.
     --ar is the image's width / height, so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 2.3623;
  }
  .steps > li:nth-child(2) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(3) {
    --ar: 0.6413;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 320svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All three share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      /* The whole image fits the stage: as wide as the column allows, never taller than the cell. */
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
        max-height: calc(100cqh - 2px);
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 33.333%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 33.333% contain 66.667%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 66.667% contain 100%;
      }
    }
  }
  /* Full opacity over 90% of a step's range; the hand-over is a short cross-fade.
     z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    5%,
    95% {
      color: var(--fg);
    }
  }
</style>
