---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Loop from "../../components/Loop.astro";
import Shot from "../../components/Shot.astro";
import Track from "../../components/Track.astro";
import sidebar from "../../assets/screenshots/it/crops/sidebar.png";
import playerCrop from "../../assets/screenshots/it/crops/player.png";
import decisions from "../../assets/screenshots/it/crops/decisions.png";
import cart from "../../assets/screenshots/it/crops/cart.png";
import libraryWindow from "../../assets/screenshots/it/desktop-local-library.png";
import playerWindow from "../../assets/screenshots/it/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/it/desktop-crates-decisions.png";
import cartWindow from "../../assets/screenshots/it/desktop-cart.png";
import panel from "../../assets/screenshots/extension-panel.png";
import { repo, version } from "../../../site.config.mjs";

const description =
  "Un'app di crate digging per DJ che lavora in locale: trasforma playlist, like e profili SoundCloud in una libreria da ascoltare, poi trova il modo più sicuro per scaricare o comprare ogni brano.";
const tracks = [
  { id: "start", no: "01", title: "Dalla playlist ai deck" },
  { id: "loop", no: "02", title: "Il ciclo del digging" },
  { id: "app", no: "03", title: "L'app desktop" },
  { id: "extension", no: "04", title: "L'estensione del browser" },
  { id: "trust", no: "05", title: "Tua, e onesta" },
  { id: "get", no: "06", title: "Scegli la tua stampa" },
];
const loop = [
  {
    name: "Raccogli",
    text: "Incolla il link di una playlist, dei like, dei repost, di un profilo o di un brano. L'elenco completo arriva tramite l'API di SoundCloud, non solo le righe che una pagina ha mostrato.",
    src: sidebar,
    full: libraryWindow,
    alt: "La barra laterale di dj-digger: tre playlist SoundCloud, Late Night Selects con 14 brani, Sunday Balcony con 4 e Warehouse Warmups con 6, e sotto le cartelle Download e Musica, con Digging 2026 aperta.",
  },
  {
    name: "Ascolta",
    text: "Anteprima, salti nel brano, ricerca, filtri e ordinamento senza lasciare la playlist. La parte già suonata della forma d'onda si accende a ogni cassa.",
    src: playerCrop,
    full: playerWindow,
    alt: "Il player di dj-digger: Slow Orbit di Nightglass a 1:04 di 3:20, la sua copertina generata, una forma d'onda accesa di magenta fino alla testina, i pulsanti di trasporto e un cursore del volume.",
  },
  {
    name: "Decidi",
    text: "Segna i brani come posseduti o saltati. La decisione segue il brano in ogni playlist in cui compare.",
    src: decisions,
    full: decisionsWindow,
    alt: "La tabella dei brani con il filtro di stato aperto: righe segnate «Ce l'ho», «Ascoltato», «Aperto» e «Nuovo», e un menu che offre «Tutti gli stati», «Non gestiti», «Nuovo», «Aperti», «Posseduti» e «Saltati».",
  },
  {
    name: "Compra o scarica",
    text: "Segui i link agli store già classificati, risolvi i gate di download, riempi i carrelli Bandcamp e Beatport. Il checkout resta a te.",
    src: cart,
    full: cartWindow,
    alt: "La finestra «Risultati del carrello»: aggiunti ai carrelli 4, non aggiunti 1. Quattro brani risultano nel carrello Bandcamp o già presenti e uno è finito in una playlist, con i pulsanti per inviare la playlist a Soundiiz, aprire i link non aggiunti, mostrare i carrelli o chiudere.",
  },
];
---

<Base title="dj-digger: crate digging per DJ" description={description} tracks={tracks}>
  <section class="hero" id="start" data-track="01" data-title="Dalla playlist ai deck" aria-labelledby="start-title">
    <p class="eyebrow"><span class="no">01</span>Crate digging per DJ</p>
    <h1 id="start-title">Da una playlist SoundCloud ai <span class="grad">file sui tuoi deck</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> è un'app desktop che lavora in locale. Raccoglie playlist intere, te le fa ascoltare,
      ricorda cosa hai deciso e trova il modo più sicuro per comprare o scaricare ogni brano.
    </p>
    <div class="cta">
      <a class="button primary" href="/it/download/">Scarica</a>
      <a class="quiet" href="#loop">Guarda come va una sessione</a>
    </div>
    <ul class="facts">
      <li>Gratuito e open source</li>
      <li>Windows, macOS, Linux</li>
      <li>Nessun account, nessun backend</li>
    </ul>
    <Loop eager>Ripreso dall'app vera, brani demo, copertine generate</Loop>
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the four steps
      one at a time. Everywhere else, and without the CSS below, four stacked steps. */}
  <section id="loop" class="loop" data-track="02" data-title="Il ciclo del digging" aria-labelledby="loop-title">
    <div class="stage stack">
      <p class="eyebrow"><span class="no">02</span>Come va una sessione</p>
      <h2 id="loop-title">Un solo ciclo, dall'inizio alla fine</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step, i) => (
            <li class="movement">
              <div class="text">
                <h3>
                  <span class="no">{`0${i + 1}`}</span>{" "}{step.name}
                </h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" no="03" title="L'app desktop" label="Sul tuo computer" heading="L'app desktop">
    <p class="copy">
      Un'app desktop da usare con la tastiera: le playlist nella barra laterale, una tabella dei brani con i badge degli
      store, un player con la forma d'onda.
    </p>
    <Shot
      src={playerWindow}
      caption="La finestra principale"
      alt="La finestra principale di dj-digger: la barra laterale con tre playlist SoundCloud e le cartelle musicali, il player su Slow Orbit di Nightglass a 1:04 di 3:20 e la tabella di Late Night Selects con stato, artista, nome del brano, genere, anno, etichetta, durata e badge degli store come Bandcamp, Beatport e Hypeddit."
    />
    <ul class="ticks">
      <li>Sa cosa possiedi già: scansiona le tue cartelle e riproduce dal disco</li>
      <li>Stima BPM e tonalità, ed esporta copie verificate sui profili audio documentati dei deck</li>
      <li>Una CLI headless per i tuoi script</li>
    </ul>
    <div class="cta"><a class="button" href="/it/app/">Scopri l'app</a></div>
  </Track>

  <Track id="extension" no="04" title="L'estensione del browser" label="Nel tuo browser" heading="L'estensione del browser">
    <div class="split">
      <div class="stack">
        <p class="copy">
          Funziona solo mentre l'app desktop è in esecuzione sullo stesso computer: fa da mani all'app nel tuo browser.
          Completa i gate di download, riempie i carrelli Bandcamp e Beatport in schede in background e mette il player
          dell'app nella barra degli strumenti.
        </p>
        <ul class="ticks">
          <li>Funziona nel browser e con gli account che usi già</li>
          <li>Parla solo con dj-digger sul tuo computer</li>
          <li>Chrome, Edge, Brave, Chromium; Firefox a parte</li>
        </ul>
        <div class="cta"><a class="button" href="/it/extension/">Scopri l'estensione</a></div>
      </div>
      <div class="panel">
        <Shot
          src={panel}
          sizes="(min-width: 46rem) 13rem, 18rem"
          alt="Il pannello di dj-digger nella barra degli strumenti: la copertina di Slow Orbit di Nightglass, una barra di avanzamento a 1:08 di 3:20 e i pulsanti precedente, pausa e successivo."
        />
      </div>
    </div>
  </Track>

  <Track id="trust" no="05" title="Tua, e onesta" label="In locale" heading="Tua, e onesta sui suoi limiti">
    <div class="columns">
      <div class="stack">
        <h3>Cosa resta a te</h3>
        <ul class="ticks">
          <li>Nessun account dj-digger e nessun server dj-digger.</li>
          <li>Playlist, decisioni e impostazioni stanno in un database locale sul tuo computer.</li>
          <li>L'accesso a SoundCloud è conservato nel portachiavi di sistema; le password non vengono mai lette.</li>
          <li>Questo sito non imposta cookie e non carica nulla da altri server.</li>
        </ul>
      </div>
      <div class="stack">
        <h3>Cosa non farà</h3>
        <ul class="ticks">
          <li>Pagare o fare il checkout: una scheda diretta a una pagina di checkout viene chiusa.</li>
          <li>Risolvere CAPTCHA o accedere al posto tuo.</li>
          <li>Tirare a indovinare: titoli ambigui, prezzi cambiati e brani venduti solo con l'album si fermano e vengono segnalati.</li>
          <li>Formattare unità o scrivere nella tua libreria rekordbox.</li>
        </ul>
      </div>
    </div>
    <p><a class="quiet" href={`${repo}/blob/main/PRIVACY.md`}>Leggi l'informativa sulla privacy</a></p>
  </Track>

  <Track id="get" no="06" title="Scegli la tua stampa" label="Solco finale" heading="Scegli la tua stampa">
    <p class="copy">dj-digger {version} è gratuito e open source, senza registrazione.</p>
    <div class="press stack">
      <div class="cta"><a class="button primary" href="/it/download/">Scarica</a></div>
      <ul class="facts" aria-label="Piattaforme">
        <li>Windows 10 (1809 o successivo) e 11</li>
        <li>macOS 15 o successivo</li>
        <li>Linux</li>
      </ul>
    </div>
    <p><a class="quiet" href="/it/liner-notes/">Vuoi sapere come è fatto? Leggi il libretto</a></p>
  </Track>
</Base>

<style>
  /* ---------- 02 the digging loop: four stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .steps h3 {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }
  .steps h3 .no {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each crop keeps its own shape; the frame sits on the image so it hugs narrow and wide crops alike.
     --ar is the crop's width / height (crops/*.png), so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 0.6509;
  }
  .steps > li:nth-child(2) {
    --ar: 4.25;
  }
  .steps > li:nth-child(3) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(4) {
    --ar: 2.1152;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }
  .media :global(.shot figcaption) {
    justify-content: flex-start;
    padding-inline: 0;
    border-top: 0;
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 400svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All four share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
      }
      .media :global(.shot figcaption) {
        display: none;
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 25%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 25% contain 50%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 50% contain 75%;
      }
      #loop .steps > li:nth-child(4),
      #loop .meter li:nth-child(4),
      #loop .meter li:nth-child(4)::after {
        animation-range: contain 75% contain 100%;
      }
    }
  }
  /* z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    20%,
    80% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    80% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    20%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    10%,
    90% {
      color: var(--fg);
    }
  }

  /* ---------- 04 the extension: the portrait panel beside the text, under it on narrow screens ---------- */
  .split {
    display: grid;
    gap: 2rem;
  }
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 46rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) 13rem;
      align-items: start;
      gap: 2.5rem;
    }
  }

  /* ---------- 05 trust: two plain columns ---------- */
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem 2.5rem;
  }

  /* ---------- 06 the run-out groove ---------- */
  .press .facts {
    margin-top: 0.9rem;
  }
</style>
