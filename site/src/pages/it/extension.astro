---
import Base from "../../layouts/Base.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import Icon from "../../components/Icon.astro";
import DataFlow from "../../components/extension/DataFlow.astro";
import panel from "../../assets/screenshots/extension-panel.png";
import { chromeStore } from "../../../site.config.mjs";

const description =
  "Estensione per Chrome, Edge e Brave: completa i gate di download Hypeddit e ToneDen e riempie i tuoi carrelli Bandcamp e Beatport. Il pagamento resta a te.";

// The five jobs of extension 1.4.4 (dj-digger 1.6.0).
const jobs = [
  ["lock-key-open", "Gate di download", "Completa i gate Hypeddit e ToneDen che l'app non riesce a completare da sola. Il file va all'app."],
  ["shopping-cart", "Carrelli degli store", "Aggiunge i brani scelti ai tuoi carrelli Bandcamp e Beatport. Non fa mai il checkout e non paga."],
  ["sign-in", "Accesso a SoundCloud", "Fa accedere l'app con la sessione SoundCloud che il tuo browser ha già."],
  ["play-circle", "Player nella barra degli strumenti", "Riproduci, metti in pausa, salta e scorri il brano dell'app, segui l'operazione in corso, rispondi quando i gate richiedono il tuo intervento."],
  ["soundcloud-logo", "Importa da SoundCloud", "Invia all'app una playlist, un brano o un profilo dal pannello, dal menu del tasto destro o dal pulsante «Import to DJ digger»."],
];
---

<Base title="Estensione per gate di download e carrelli · dj-digger" description={description} label="extension">
  <Track hero sub id="overview" title="L'estensione del browser">
    <Fragment slot="heading">L'estensione del browser</Fragment>
    <p class="lede">
      Le mani dell'app desktop nel browser che usi già. Funziona mentre dj-digger è in esecuzione sullo stesso computer.
    </p>
    <div class="cta">
      <a class="button primary" href={chromeStore}><Icon name="google-chrome-logo" />Aggiungi dal Chrome Web Store</a>
    </div>
    <div class="panel">
      <Shot
        src={panel}
        alt="Il pannello di dj-digger nella barra degli strumenti mentre suona Drift Away di JMHBM: un disco sulla copertina, una barra di avanzamento a 1:25 di 3:01 e i pulsanti precedente, pausa e successivo."
        sizes="(min-width: 44rem) 17rem, 20rem"
        eager
      />
    </div>
  </Track>

  <Track id="does" title="Cosa fa">
    <ul class="cards">
      {
        jobs.map(([icon, name, text]) => (
          <li class="card">
            <h3><Icon name={icon} />{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="browsers" title="Browser supportati">
    <p class="lede">Chrome, Edge e Brave. Edge chiede di consentire le estensioni di altri store.</p>
    <p class="copy">I browser installati come Flatpak o Snap non possono avviare il collegamento con l'app.</p>
  </Track>

  <Track id="data" title="Dove vanno i tuoi dati">
    <div class="split">
      <DataFlow />
      <p class="copy">
        L'estensione comunica solo con l'app dj-digger sul tuo computer. Allo sviluppatore non viene inviato nulla:
        nessuna statistica d'uso, nessuna pubblicità. Conserva solo dati di sessione, cancellati alla chiusura del browser.
      </p>
    </div>
  </Track>

  <Track id="end" title="Inizia dall'app">
    <p class="copy">L'estensione aspetta l'app desktop. Installala e avviala una volta.</p>
    <div class="cta">
      <a class="button primary" href="/it/download/"><Icon name="download-simple" />Scarica l'app desktop</a>
    </div>
  </Track>
</Base>

<style>
  /* Hero: the portrait panel at phone width beside the text, under it on narrow columns. */
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 44rem) {
    :global(#overview) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 34%, 17rem);
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    :global(#overview) > :global(*) {
      grid-column: 1;
      align-self: start;
    }
    :global(#overview) > .panel {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      max-width: none;
    }
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card h3 :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
</style>
