---
import { readdirSync, readFileSync, statSync } from "node:fs";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Loop from "../components/Loop.astro";
import Track from "../components/Track.astro";
import { author, repo } from "../../site.config.mjs";

const description =
  "How dj-digger is built: architecture, the browser-extension trust boundary, untrusted-input guards, the kick light and its validation, tests and releases, and this website.";
const tracks = [
  { id: "notes", no: "01", title: "Liner notes" },
  { id: "architecture", no: "02", title: "Architecture" },
  { id: "browser", no: "03", title: "The browser boundary" },
  { id: "untrusted", no: "04", title: "Untrusted by default" },
  { id: "kick", no: "05", title: "Kick pulse" },
  { id: "releases", no: "06", title: "Tests and releases" },
  { id: "website", no: "07", title: "This website" },
  { id: "credits", no: "08", title: "Credits and sources" },
];

// Figures are counted from the repository at build time, never typed.
// Paths are relative to the working directory (npm runs in site/), as in site.config.mjs.
const testFunctions = readdirSync("../tests", { recursive: true })
  .filter((file) => String(file).endsWith(".py"))
  .reduce((sum, file) => sum + (readFileSync(`../tests/${file}`, "utf8").match(/def test_/g) ?? []).length, 0);
const workflows = readdirSync("../.github/workflows").filter((file) => /\.ya?ml$/.test(file)).length;
const ci = readFileSync("../.github/workflows/ci.yml", "utf8");
const list = (key) => {
  const found = new RegExp(`^\\s*${key}:\\s*\\[([^\\]]+)\\]`, "m").exec(ci);
  if (!found) throw new Error(`ci.yml: no ${key} matrix`); // fail the build rather than print a wrong figure
  return found[1].split(",").map((item) => item.trim().replace(/^["']|["']$/g, ""));
};
const osName = { "ubuntu-latest": "Ubuntu", "macos-latest": "macOS", "windows-latest": "Windows" };
const ciOs = list("os").map((os) => osName[os] ?? os);
const ciPython = list("python-version");
const scriptBytes = statSync("src/scripts/deck.js").size + statSync("src/scripts/geometry.js").size;
const scriptKb = (scriptBytes / 1000).toFixed(1);
const count = new Intl.NumberFormat("en");
const join = (items) => (items.length > 1 ? `${items.slice(0, -1).join(", ")} and ${items.at(-1)}` : items[0]);

const spec = `${repo}/blob/main/PROJECT_SPECIFICATION.md`;
const guide = `${repo}/blob/main/docs/architecture.md`;
const validation = `${repo}/blob/main/docs/kick-pulse-validation.md`;
const workflowsUrl = `${repo}/tree/main/.github/workflows`;
// Anchors are GitHub's slugs of the specification's headings (github-slugger).
const section = {
  urls: { href: `${spec}#111-untrusted-urls-and-ssrf-boundary`, label: "§11.1 Untrusted URLs and SSRF boundary" },
  secrets: { href: `${spec}#112-secret-and-personal-data-handling`, label: "§11.2 Secret and personal-data handling" },
  files: { href: `${spec}#113-file-and-mutation-safety`, label: "§11.3 File and mutation safety" },
};

const guards = [
  ["URL schemes", "Track fields, descriptions, summary files, redirects and gate replies are untrusted, and only HTTP(S) URLs with a host are handed to the browser.", section.urls],
  ["Domain boundaries", "Store and SoundCloud ownership checks match the exact host or a subdomain boundary, never a substring, so a look-alike host is not a store.", section.urls],
  ["SSRF guard", "Before any automatic request, URL credentials, localhost names and literal non-global IP addresses are rejected and every validated redirect is bounded; DNS names are not resolved first, a limitation the specification states.", section.urls],
  ["Download limits", "Declared and observed sizes are capped at 2 GiB, HTML bodies are rejected, and filenames are cut to their basename with invalid characters replaced and Windows reserved names prefixed.", section.files],
  ["Atomic replacement", "HTTP and browser downloads are written to temporary files and published by atomic rename under a shared name lock, and partial files are removed on failure or cancellation.", section.files],
  ["Cart revalidation", "Store-cart writes need an exact-item preflight and immediate revalidation, and network writes that could duplicate a change on another site get no automatic retry.", section.files],
  ["Secrets", "Passwords are typed only on the provider's own pages, the SoundCloud login keeps only the verified oauth_token in the system keyring, token files are written private before an atomic replace, and CLI logs redact URL queries and credential fields.", section.secrets],
];

// The architecture diagram: boxes in the SVG's own units (320 wide), drawn in a column that holds at 328px.
const LINE = 13;
const box = (x, y, w, h, lines, kind = "") => ({ x, y, w, h, lines, kind });
const nodes = [
  box(1, 18, 154, 36, ["CLI"], "ctl"),
  box(165, 18, 154, 36, ["Qt Quick desktop"], "ctl"),
  box(1, 82, 318, 46, ["ApplicationServices", "lazy: imports no Qt, opens nothing until used"], "named"),
  box(1, 154, 110, 62, ["Collection,", "download,", "purchase and", "account services"]),
  box(119, 154, 96, 62, ["Library", "service"]),
  box(223, 154, 96, 62, ["Playback", "service"]),
  box(1, 242, 110, 50, ["SoundCloud,", "gate and store", "adapters"]),
  box(119, 242, 96, 50, ["Repositories"]),
  box(223, 242, 96, 50, ["In-memory", "audio engine"]),
  box(119, 318, 96, 44, ["SQLite", "owner thread"], "owner"),
  box(1, 378, 318, 58, ["OperationCoordinator", "one main slot, one scan slot: admits work", "and tracks cancellation until workers finish"], "named coord"),
];
const wires = [[78, 54, 80], [242, 54, 80], [56, 128, 152], [167, 128, 152], [271, 128, 152], [56, 216, 240], [167, 216, 240], [271, 216, 240], [167, 292, 316]];
const baseline = (node, i) => node.y + node.h / 2 - ((node.lines.length - 1) * LINE) / 2 + 4 + i * LINE;
---

<Base title="Liner notes: how dj-digger is built" description={description} label="notes" tracks={tracks}>
  <Track id="notes" no="01" title="Liner notes" hero sub>
    <Fragment slot="heading">Liner notes: <span class="grad">how dj-digger is built</span></Fragment>
    <p class="lede">
      The back of the sleeve: how the app is put together, where it draws its boundaries and how it is checked. Every
      statement here links to the document or file it comes from.
    </p>
    <p class="copy">
      Written, engineered and pressed by <a href={author.url}>{author.name}</a>.
    </p>
    <ul class="facts">
      <li>Python 3.12+</li>
      <li>Qt Quick</li>
      <li>Manifest V3 extension</li>
      <li>SQLite</li>
      <li>No dj-digger server</li>
    </ul>
  </Track>

  <Track id="architecture" no="02" title="Architecture" heading="Controllers present, services own the effects">
    <p class="lede">
      The CLI and the Qt desktop are controllers over the same application services. Controllers own presentation;
      services own completed effects and resource lifecycles; one coordinator admits work and tracks cancellation
      until workers finish.
    </p>
    <figure class="diagram">
      <svg class="arch" viewBox="0 0 320 438" role="img" aria-labelledby="arch-title arch-desc">
        <title id="arch-title">How dj-digger is composed</title>
        <desc id="arch-desc">
          The CLI and the Qt Quick desktop are controllers over ApplicationServices, which composes the application
          services lazily and imports no Qt. Collection, download, purchase and account services use the SoundCloud,
          gate and store adapters. The library service works through repositories on the SQLite owner thread. The
          playback service drives the in-memory audio engine. The OperationCoordinator, with one main slot and one
          scan slot, admits work and tracks cancellation until workers finish.
        </desc>
        <defs>
          <marker id="arch-tip" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path class="tip" d="M0 0L8 4L0 8z"></path>
          </marker>
        </defs>
        <text class="group" x="1" y="10">CONTROLLERS</text>
        {wires.map(([x, from, to]) => <path class="wire" d={`M${x} ${from}V${to}`} marker-end="url(#arch-tip)" />)}
        {
          nodes.map((node) => (
            <g class={node.kind}>
              <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
              {node.lines.map((line, i) => (
                <text x={node.x + node.w / 2} y={baseline(node, i)} class={node.kind.includes("named") && i > 0 ? "sub" : undefined}>
                  {line}
                </text>
              ))}
            </g>
          ))
        }
      </svg>
    </figure>
    <ul class="ticks rules">
      <li>
        <strong>No blocking work on the UI thread.</strong> The backend, the Qt signal bridge, the table model and the
        QML window split orchestration, signals, rows and rendering; none of them does blocking network or disk work on
        the UI thread, and results are delivered back to it (<a href={`${guide}#ui-ownership`}>UI ownership</a>).
      </li>
      <li>
        <strong>One thread owns SQLite.</strong> Transactions are explicit and short, no network, browser or dialog
        happens inside one, status and file provenance commit together, and in-memory mirrors change only after commit
        (<a href={`${guide}#persistent-effects-and-identity`}>Persistent effects and identity</a>).
      </li>
      <li>
        <strong>Composition imports no Qt.</strong> Constructing <code>ApplicationServices</code> imports no Qt and
        opens no database, device or browser connection; the CLI and the desktop get the same lazy collection service
        from it (<a href={`${guide}#composition-and-execution`}>Composition and execution</a>).
      </li>
    </ul>
    <p class="copy">
      The guide also says what the design does not claim: no DNS pinning, no security audit, and no transaction
      spanning the filesystem and SQLite.
    </p>
    <p><a class="quiet" href={guide}>Read the architecture guide</a></p>
  </Track>

  <Track id="browser" no="03" title="The browser boundary" heading="Driving your browser without owning it">
    <p class="lede">
      Gates and carts run in the user's real, signed-in browser, so the extension enforces its own limits, whatever
      the desktop app sends it.
    </p>
    <div class="movement">
      <h3>One channel, no remote code</h3>
      <p class="copy">
        The only command input is the native-messaging port from the app on the same computer: the manifest has
        no <code>externally_connectable</code> and no <code>web_accessible_resources</code>, and no page script listens
        to <code>window.postMessage</code>. There is no <code>eval</code>; the only functions run in a page are named,
        read-only ones bundled with the extension. On the app's side the socket directory is private to the user and
        peers authenticate with a key in a 0600 file.
      </p>
    </div>
    <div class="movement">
      <h3>A fixed list of sites</h3>
      <p class="copy">
        One <code>allowlist.json</code> drives the background script, and a test compares it with the Python host lists
        and the manifest's host permissions: HTTPS on the default port, without credentials, to Hypeddit, ToneDen,
        Bandcamp and Beatport, and SoundCloud's sign-in page. A navigation anywhere else is refused.
      </p>
    </div>
    <div class="movement">
      <h3>Only its own tabs</h3>
      <p class="copy">
        Commands act on the tabs and work windows the extension created and on their popups, never on the user's
        other tabs. Reading or clicking also needs the tab's current address on the allowlist; any other address is
        cut to <code>https://&lt;host&gt;/</code> before it is reported, and OAuth parameters are stripped. Every owned
        tab is muted.
      </p>
    </div>
    <div class="movement">
      <h3>A hard stop before money</h3>
      <p class="copy">
        An owned Bandcamp or Beatport tab that navigates or is redirected to a checkout, cart-checkout, payment or
        billing path is closed and reported. Clicks on elements named check out, pay, purchase, place order, buy now or
        complete order are refused, and form filling refuses password and payment-card fields.
      </p>
    </div>
    <div class="cta">
      <a class="quiet" href={`${spec}#114-browser-extension-trust-boundary`}>§11.4 Browser-extension trust boundary</a>
      <a class="quiet" href={`${repo}/blob/main/CHROMEWEBSTORE.md`}>Permission justifications</a>
      <a class="quiet" href="/extension/">The extension page</a>
    </div>
  </Track>

  <Track id="untrusted" no="04" title="Untrusted by default" heading="Every link is untrusted">
    <p class="lede">
      Artist links, redirects, provider responses and filenames are treated as hostile input. These guards exist in
      the code; each links to the part of the specification that states it.
    </p>
    <ul class="guards">
      {
        guards.map(([name, text, source]) => (
          <li>
            <h3>{name}</h3>
            <p>{text}</p>
            <a href={source.href}>{source.label}</a>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="kick" no="05" title="Kick pulse" heading="A light that follows the kick, not the bass">
    <p class="lede">
      The player's light follows a continuous kick level, worked out from the audio before it reaches the speaker,
      rather than yes-or-no beat decisions, so a missed decision can never stop it.
    </p>
    <Loop>Captured from the real app with a synthetic demo track. The software renderer used for the capture draws no GPU glow, so the real light is stronger.</Loop>
    <div class="movement">
      <h3>What the light follows</h3>
      <p class="copy">
        <code>beats.py</code> compares each low-frequency band of the decoded audio with its own recent median, so a
        held bass, a sidechain recovery or a pad becomes the reference and only what rises above it counts. That rise
        is weighted by how much it resembles a kick. A track's own kick is learned only from hits that drop in pitch,
        so a repeated bass note never becomes it (<a href={`${spec}#34-audio-preview`}>§3.4 Audio preview</a>).
      </p>
    </div>
    <div class="movement">
      <h3>Ahead of the speaker</h3>
      <p class="copy">
        The player decodes ahead of the audio device, so each level exists before its sound is heard, and the window
        reads it against the time actually reaching the speaker, measured from what the device has taken. On
        2026-10-01, playing one track from 60 s on the development machine (PipeWire, 50 ms periods), levels reached
        184–189 ms beyond the device position while the measured device queue was 46–71 ms; the analysis took about
        0.57 % of real time.
      </p>
    </div>
    <div class="movement">
      <h3>The shape of the light</h3>
      <p class="copy">
        The light is analog: it jumps to the kick's level at once and dies away exponentially, like a lamp, so a full
        kick is dark again before the next and quieter low hits show dimmer and shorter
        (<a href={`${spec}#38-qt-quick-desktop`}>§3.8 Qt Quick desktop</a>). A lighter pastel rest colour once made a
        kick read as the light going out; in the saturated colours measured on 2026-10-01 the neon is 2.1–2.2 times as
        bright as the rest.
      </p>
    </div>
    <div class="movement">
      <h3>Checked in the real window</h3>
      <p class="copy">
        The offline measurements said two reported tracks were fine, so on 2026-10-01 the real stack was run (window,
        bridge, backend, player and audio device; muted, offscreen, on isolated application state) with the window's
        light, clock and levels logged on every frame. It found two bugs outside the analysis. Levels between 0 and 1
        were numpy floats, which Qt hands to QML as opaque objects, not numbers, so only levels of exactly 0 and 1 lit
        anything; levels are now plain floats. And after a start the device took its first 50 ms at once and the next
        only later, so the heard time was clamped to the handed position and ran about 70 ms early in 50 ms steps; the
        queue is now never taken as less than what the last callback handed over.
      </p>
      <div class="table">
        <table>
          <caption>Kalipo – Captain, 45–105 s, live in the real window, 2026-10-01</caption>
          <thead>
            <tr><th scope="col">Measure</th><th scope="col">Before</th><th scope="col">After</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Kicks under 0.3 brightness</th><td>20 of 114</td><td>0</td></tr>
            <tr><th scope="row">Dimmest kick</th><td>0.00</td><td>0.95</td></tr>
            <tr><th scope="row">Frames with the clock stuck at the snapshot position</th><td>54 %</td><td>0 %</td></tr>
            <tr><th scope="row">Jumps over 20 ms in the heard time</th><td>1199</td><td>0</td></tr>
          </tbody>
        </table>
      </div>
      <p class="copy">
        On a second track after the fix, 62 kicks had a median brightness of 0.94 and none fell under 0.3, with the
        window at 63 frames a second and no frame gap over 28 ms.
      </p>
    </div>
    <p><a class="quiet" href={validation}>Read the validation notes</a></p>
  </Track>

  <Track id="releases" no="06" title="Tests and releases" heading="From commit to installer">
    <p class="lede">
      {workflows} workflow files take a change from a commit to the installers and the stores. Each step below is
      what the workflow runs, as the specification records it.
    </p>
    <ol class="steps">
      <li>
        <span class="no">01</span>
        <h3>Offline suite</h3>
        <p>
          {count.format(testFunctions)} test functions in <code>tests/</code>. By default the live markers are
          excluded, an autouse fixture moves config, auth, database and scan folders to a temporary directory, and the
          default HTTP transport is blocked, so no test reaches a live endpoint, user data or music folders. CI runs it
          on every push and pull request on {join(ciOs)} with Python {join(ciPython)} ({ciOs.length * ciPython.length} jobs),
          after the specification-map check and Ruff, and builds and checks an isolated wheel install in each job.
        </p>
      </li>
      <li>
        <span class="no">02</span>
        <h3>Live contract checks</h3>
        <p>
          A weekly workflow runs the separately marked live suite against SoundCloud's API: client-ID discovery, long
          collections, hydration, media availability and socket decoding. It is a monitor, not a release gate. Store
          and gate checks run by hand: public store pages read through the extension without signing in or touching a
          cart, and GET-only gate inspection.
        </p>
      </li>
      <li>
        <span class="no">03</span>
        <h3>Installers</h3>
        <p>
          Desktop contracts and an isolated startup run on Linux, Windows and macOS. Then CI builds the Windows x64
          installer and native macOS arm64 and x86_64 disk images, verifies each one's bundled runtime and
          installation, and uploads each as a test artifact with a SHA-256 file beside it. They are
          unsigned previews; tests on physical devices stay separate.
        </p>
      </li>
      <li>
        <span class="no">04</span>
        <h3>Publishing</h3>
        <p>
          A published stable release runs its own test matrix, then uploads to PyPI through trusted publishing (OIDC);
          only that job may request an identity token, and third-party actions are pinned to commits. The same release
          packages the extension and submits it to the Chrome Web Store through its API, authenticated as a service
          account. Prereleases skip both.
        </p>
      </li>
    </ol>
    <div class="cta">
      <a class="quiet" href={`${spec}#14-verification-ci-and-release`}>§14 Verification, CI, and release</a>
      <a class="quiet" href={workflowsUrl}>The workflows</a>
    </div>
  </Track>

  <Track id="website" no="07" title="This website" heading="This website">
    <p class="lede">The colophon. Figures are counted when the site is built.</p>
    <dl class="spec">
      <dt>Stack</dt>
      <dd>Static Astro pages and plain CSS. No UI framework and no runtime dependencies: Astro runs only at build time.</dd>
      <dt>The record</dt>
      <dd>
        Inline SVG from the same seeded generator as the app icon (<code>scripts/app_icon.py</code>). CSS scroll-driven
        animations turn it and move the tonearm; a small script is the fallback where they are missing.
      </dd>
      <dt>Script weight</dt>
      <dd>
        {scriptKb} kB for the record's script (<code>deck.js</code> and <code>geometry.js</code>): source, before
        minification and compression.
      </dd>
      <dt>Third-party requests</dt>
      <dd>None. No analytics, no cookies, self-hosted fonts.</dd>
      <dt>Screenshots</dt>
      <dd>
        Real UI with demo data, regenerated with the player loop above
        by <code>scripts/site_screenshots.py</code>.
      </dd>
      <dt>Accessibility</dt>
      <dd>Full keyboard use, a text tracklist beside the record, motion off under reduced motion, complete without JavaScript.</dd>
      <dt>Source</dt>
      <dd><a href={`${repo}/tree/main/site`}>The site's folder in the repository</a></dd>
    </dl>
  </Track>

  <Track id="credits" no="08" title="Credits and sources" heading="Credits and sources">
    <ul class="sources">
      <li><a href={repo}>Source code</a> on GitHub. Issues and pull requests welcome.</li>
      <li><a href={spec}>Specification</a>: every shipped behaviour and every security and privacy boundary.</li>
      <li><a href={`${repo}/blob/main/CHANGELOG.md`}>Changelog</a>: what changed in each release.</li>
      <li><a href={guide}>Architecture guide</a>: where an implementation change belongs.</li>
      <li><a href={`${repo}/blob/main/LICENSE`}>Licence</a>: Apache 2.0.</li>
    </ul>
    <p class="signature">
      Made by <a href={author.url}>{author.name}</a>: design, engineering and everything else.
    </p>
  </Track>
</Base>

<style>
  .diagram {
    max-width: 28rem;
  }
  .arch {
    width: 100%;
    font-family: var(--sans);
  }
  .arch rect {
    fill: var(--panel);
    stroke: var(--edge);
    stroke-width: 1;
  }
  .arch .ctl rect {
    stroke: var(--neon-foot);
  }
  .arch .owner rect {
    stroke: var(--neon-top);
  }
  .arch .coord rect {
    stroke-dasharray: 4 3;
  }
  .arch text {
    fill: var(--fg);
    font-size: 11px;
    text-anchor: middle;
  }
  .arch .named text:first-of-type {
    font-family: var(--mono);
    font-weight: 700;
  }
  .arch .sub {
    fill: var(--muted);
    font-size: 10.5px;
  }
  .arch .group {
    fill: var(--muted);
    font: 600 8.5px var(--mono);
    letter-spacing: 0.12em;
    text-anchor: start;
  }
  .arch .wire {
    fill: none;
    stroke: var(--edge);
    stroke-width: 1.2;
  }
  .arch .tip {
    fill: var(--edge);
  }
  .rules strong,
  .guards h3,
  .steps h3 {
    color: var(--fg);
  }
  .rules li + li {
    margin-top: 1rem;
  }
  .rules,
  .guards,
  .steps,
  .sources {
    max-width: 44rem;
  }
  .guards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.6rem 2rem;
  }
  .guards li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .guards h3 {
    font-size: 1rem;
  }
  .guards a {
    font-size: 0.86rem;
    color: var(--fg);
  }
  .steps {
    display: grid;
    gap: 2rem;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.2rem 1rem;
  }
  .steps .no {
    grid-row: span 2;
    color: var(--neon-foot);
    font-size: 0.8rem;
    padding-top: 0.3rem;
  }
  .steps p {
    color: var(--muted);
  }
  .table caption {
    padding: 0.8rem 1rem 0.2rem;
    text-align: left;
    font: 500 0.78rem var(--mono);
    color: var(--muted);
  }
  .table tbody th {
    white-space: normal;
  }
  .table td {
    white-space: nowrap;
  }
  .sources li {
    padding: 0.7rem 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .sources a,
  .signature a {
    font-weight: 600;
    color: var(--fg);
  }
  .signature {
    color: var(--muted);
  }
  @media (max-width: 30rem) {
    .spec {
      grid-template-columns: 1fr;
    }
    .spec dd {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
