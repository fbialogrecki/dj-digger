---
import Base from "../../layouts/Base.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import Icon from "../../components/Icon.astro";
import DataFlow from "../../components/extension/DataFlow.astro";
import panel from "../../assets/screenshots/extension-panel.png";
import { chromeStore } from "../../../site.config.mjs";

const description =
  "Rozszerzenie do Chrome, Edge i Brave: przechodzi bramki pobierania Hypeddit i ToneDen i wypełnia Twoje koszyki Bandcamp i Beatport. Płatność zostaje po Twojej stronie.";

// The five jobs of extension 1.4.4 (dj-digger 1.6.0).
const jobs = [
  ["lock-key-open", "Bramki pobierania", "Kończy bramki Hypeddit i ToneDen, których aplikacja nie przejdzie sama. Plik trafia do aplikacji."],
  ["shopping-cart", "Koszyki w sklepach", "Dodaje Twój wybór do koszyków w Bandcamp i Beatport. Nigdy nie finalizuje zakupu ani nie płaci."],
  ["sign-in", "Logowanie do SoundCloud", "Loguje aplikację sesją SoundCloud, którą Twoja przeglądarka już ma."],
  ["play-circle", "Odtwarzacz na pasku narzędzi", "Odtwarzaj, pauzuj, przełączaj i przewijaj utwór z aplikacji, śledź jej bieżące zadanie i odpowiadaj, gdy bramki czekają na Ciebie."],
  ["soundcloud-logo", "Import z SoundCloud", "Wyślij playlistę, utwór albo profil do aplikacji z panelu, z menu pod prawym przyciskiem myszy albo przyciskiem „Import to DJ digger”."],
];
---

<Base title="Rozszerzenie do bramek pobierania i koszyków · dj-digger" description={description} label="extension">
  <Track hero sub id="overview" title="Rozszerzenie przeglądarki">
    <Fragment slot="heading">Rozszerzenie przeglądarki</Fragment>
    <p class="lede">
      Ręce aplikacji desktopowej w przeglądarce, której już używasz. Działa, gdy dj-digger jest uruchomiony na tym samym
      komputerze.
    </p>
    <div class="cta">
      <a class="button primary" href={chromeStore}><Icon name="google-chrome-logo" />Dodaj z Chrome Web Store</a>
    </div>
    <div class="panel">
      <Shot
        src={panel}
        alt="Panel dj-digger na pasku narzędzi odtwarza Drift Away w wykonaniu JMHBM: płyta na okładce, pasek przewijania na 1:25 z 3:01 oraz przyciski poprzedni, pauza i następny."
        sizes="(min-width: 44rem) 17rem, 20rem"
        eager
      />
    </div>
  </Track>

  <Track id="does" title="Co robi">
    <ul class="cards">
      {
        jobs.map(([icon, name, text]) => (
          <li class="card">
            <h3><Icon name={icon} />{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="browsers" title="Obsługiwane przeglądarki">
    <p class="lede">Chrome, Edge i Brave. Edge zapyta o zezwolenie na rozszerzenia z innych sklepów.</p>
    <p class="copy">Przeglądarki zainstalowane jako Flatpak lub Snap nie mogą uruchomić połączenia z aplikacją.</p>
  </Track>

  <Track id="data" title="Dokąd trafiają Twoje dane">
    <div class="split">
      <DataFlow />
      <p class="copy">
        Rozszerzenie rozmawia tylko z aplikacją dj-digger na Twoim komputerze. Nic nie trafia do twórcy: żadnej
        analityki, żadnych reklam. Przechowuje tylko dane sesji, czyszczone po zamknięciu przeglądarki.
      </p>
    </div>
  </Track>

  <Track id="end" title="Zacznij od aplikacji">
    <p class="copy">Rozszerzenie czeka na aplikację desktopową. Zainstaluj ją i uruchom raz.</p>
    <div class="cta">
      <a class="button primary" href="/pl/download/"><Icon name="download-simple" />Pobierz aplikację desktopową</a>
    </div>
  </Track>
</Base>

<style>
  /* Hero: the portrait panel at phone width beside the text, under it on narrow columns. */
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 44rem) {
    :global(#overview) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 34%, 17rem);
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    :global(#overview) > :global(*) {
      grid-column: 1;
      align-self: start;
    }
    :global(#overview) > .panel {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      max-width: none;
    }
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card h3 :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
</style>
