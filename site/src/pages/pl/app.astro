---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import mainWindow from "../../assets/screenshots/pl/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/pl/desktop-crates-decisions.png";
import storesWindow from "../../assets/screenshots/pl/desktop-store-links.png";
import gatesWindow from "../../assets/screenshots/pl/desktop-jobs-gates.png";
import cartWindow from "../../assets/screenshots/pl/desktop-cart.png";
import libraryWindow from "../../assets/screenshots/pl/desktop-local-library.png";
import exportWindow from "../../assets/screenshots/pl/desktop-export.png";
import sidebar from "../../assets/screenshots/pl/crops/sidebar.png";
import decisions from "../../assets/screenshots/pl/crops/decisions.png";
import stores from "../../assets/screenshots/pl/crops/stores.png";
import gates from "../../assets/screenshots/pl/crops/gates.png";
import cart from "../../assets/screenshots/pl/crops/cart.png";
import library from "../../assets/screenshots/pl/crops/library.png";
import exportDialog from "../../assets/screenshots/pl/crops/export.png";

const description =
  "Importuj całe playlisty, polubienia i profile z SoundCloud, odsłuchuj z BPM i tonacją, oznaczaj, co masz, przechodź bramki Hypeddit i ToneDen i eksportuj pliki pod swoje decki.";
---

<Base title="Aplikacja desktopowa: playlisty SoundCloud jako biblioteka DJ · dj-digger" description={description} label="app">
  <Track hero sub id="overview" title="Cała pętla">
    <Fragment slot="heading">Cała pętla digowania <span class="grad">w jednym oknie</span></Fragment>
    <p class="lede">Każdy obraz na tej stronie to prawdziwa aplikacja na danych demo.</p>
    <div class="cta">
      <a class="button primary" href="/pl/download/"><Icon name="download-simple" />Pobierz</a>
    </div>
    <Shot
      src={mainWindow}
      eager
      alt="Okno główne dj-digger. Panel boczny wymienia trzy playlisty z SoundCloud, z zaznaczoną Late Night Selects, nad folderami Pobrane i Muzyka. Odtwarzacz na górze pokazuje Drift Away w wykonaniu JMHBM na 1:21 z 3:01, z wygenerowaną okładką płyty i magentowym przebiegiem dźwięku. Pod nim pole wyszukiwania, przyciski sklepów (Bandcamp 4, Beatport 3, Hypeddit 3, Traxsource 1, Juno Download 1), filtr statusu i tabela 14 utworów, każdy ze statusem, wykonawcą, nazwą utworu, gatunkiem, rokiem, wytwórnią, czasem i plakietką sklepu."
    />
  </Track>

  <Track id="collect" title="Zbieranie" heading="Całe playlisty, a nie przewinięta strona">
    <div class="beside">
      <div class="beside-grid">
        <div class="stack">
          <p class="lede">Aplikacja czyta całą kolekcję przez API SoundCloud.</p>
          <ul class="ticks">
            <li>Playlisty i sety, polubienia, reposty, profile wykonawców i pojedyncze utwory</li>
            <li>Import wypełnia tabelę partia po partii i zapisuje się, gdy dotrze całość</li>
            <li>Zaloguj się do SoundCloud, by czytać swoje prywatne playlisty</li>
            <li>Odświeżona playlista pokazuje na górze to, co doszło, ze statusem <code>Nowy</code></li>
          </ul>
        </div>
        <Shot
          src={sidebar}
          full={libraryWindow}
          sizes="220px"
          alt="Panel boczny: pole Filtruj playlisty i foldery; trzy playlisty z SoundCloud, Late Night Selects z 14 utworami, Sunday Balcony z 4 i Warehouse Warmups z 6, oraz przycisk plusa do dodania kolejnej; niżej eksplorator Foldery z folderami Pobrane i Muzyka, w którym zaznaczony jest folder Digging 2026 z siedmioma plikami."
        />
      </div>
    </div>
  </Track>

  <Track id="audition" title="Odsłuch" heading="Odsłuch, który czuje stopę">
    <p class="lede">Słuchaj podglądu prosto z SoundCloud albo graj plik z dysku, jeśli go masz.</p>
    <Loop />
    <ul class="ticks">
      <li>Przewijaj po przebiegu dźwięku; następny utwór jest przygotowywany z wyprzedzeniem</li>
      <li>Przy każdej stopie odegrana część przebiegu dźwięku rozbłyska, idąc za stopą, a nie za linią basu</li>
      <li>Podglądy są dekodowane w pamięci i nigdy nie trafiają na dysk</li>
      <li>Szukaj, filtruj i sortuj, nie wychodząc z playlisty; <kbd>?</kbd> pokazuje wszystkie skróty</li>
      <li>Widok → Animacje wyłącza światło</li>
    </ul>
  </Track>

  <Track id="decide" title="Decyzje" heading="Skrzynki, które pamiętają">
    <p class="lede">Mam, pominięty, odtworzony i otwarty: każdy utwór zachowuje swój status.</p>
    <Shot
      src={decisions}
      full={decisionsWindow}
      alt="Tabela utworów z otwartym filtrem statusu, z opcjami Wszystkie statusy, Nieobsłużone, Nowy, Otwarte, Posiadane i Pominięte. Kolumna Status pokazuje Mam, Mam, Odtworzony, Mam, Otwarty i Nowy obok Nightglass, Coral Engine, Sable Fern, Tidewell, Ostra Lumen i Pale Circuit; nad tabelą przyciski sklepów, takie jak Bandcamp 4 i Beatport 3."
    />
    <ul class="ticks">
      <li>Skanuje Twoje foldery z muzyką: pewne dopasowanie wykonawcy i tytułu dostaje status Mam i gra z dysku</li>
      <li><kbd>H</kbd> pokazuje tylko utwory do obsłużenia, a potem znowu wszystko</li>
      <li>Filtruj po statusie, sklepie, gatunku i nie tylko</li>
    </ul>
  </Track>

  <Track id="acquire" title="Zdobywanie" heading="Najbezpieczniejsza droga do każdego utworu">
    <p class="lede">Trzy drogi do pliku. Każda mówi, co zostaje po Twojej stronie.</p>

    <div class="movement stack">
      <h3>Wszystkie linki, posortowane</h3>
      <p class="copy">
        Linki do zakupu i pobrania są klasyfikowane po ścisłym dopasowaniu domeny: Bandcamp, Beatport, Traxsource, Juno
        Download, Apple, sklepy z płytami, bramki pobierania, smart linki i darmowe pobrania z SoundCloud. Link, który
        okazuje się listą sklepów, zostaje otwarty, a stojące za nim linki Bandcamp i Beatport trafiają do utworu.
      </p>
      <p class="manual"><strong>Zostaje po Twojej stronie</strong> Który link otworzyć: <kbd>O</kbd> lub <kbd>Enter</kbd> otwiera linki zaznaczonych utworów w Twojej przeglądarce.</p>
      <Shot
        src={stores}
        full={storesWindow}
        alt="Tabela utworów przefiltrowana przyciskami sklepów Bandcamp 4 i Beatport 3, pokazująca 7 z 14 utworów, każdy z plakietką Bandcamp albo Beatport w kolumnie Sklepy."
      />
    </div>

    <div class="movement stack">
      <h3>Bramki pobierania z głowy</h3>
      <p class="copy">
        Bramki „obserwuj, by pobrać” w Hypeddit, ToneDen, GateRush i Droploud są przechodzone przez ich własne ścieżki
        pobierania. Gdy bramka potrzebuje przeglądarki, rozszerzenie przechodzi jej kroki w tle, a plik trafia do
        aplikacji. Kroki społecznościowe zależą od opcji <em>Zezwalaj na działania społecznościowe</em> w Ustawieniach,
        domyślnie włączonej; wyłącz ją, a takie bramki zostaną dla Ciebie do zrobienia ręcznie.
      </p>
      <p class="manual"><strong>Zostaje po Twojej stronie</strong> CAPTCHA, logowanie u dostawców i pierwsze zgody. Aplikacja najpierw pyta, a okno przeglądarki otwiera się tylko wtedy, gdy tak wybierzesz.</p>
      <Shot
        src={gates}
        full={gatesWindow}
        alt="Okno Bramki czekają na Ciebie: „Te bramki wymagają czegoś, co możesz zrobić tylko Ty, np. logowania albo CAPTCHA.”, nad listą trzech utworów, każdy z adnotacją „the gate wants a CAPTCHA solved”, oraz przyciski Otwórz w przeglądarce, Pomiń te i Zatrzymaj pobieranie."
      />
    </div>

    <div class="movement stack">
      <h3>Koszyki, nigdy kasa</h3>
      <p class="copy">
        Zaznacz utwory, a aplikacja wypełni Twój koszyk w Bandcamp, a w Beatport wtedy, gdy znany jest dokładnie ten
        utwór, w kartach w tle Twojej własnej przeglądarki. Każda strona produktu jest sprawdzana ponownie tuż przed
        kliknięciem; niejednoznaczny tytuł, zmieniona cena albo utwór sprzedawany tylko z albumem zatrzymuje proces,
        zamiast zgadywać.
      </p>
      <p class="manual"><strong>Zostaje po Twojej stronie</strong> Kasa. Jedna karta koszyka na sklep przechodzi w Twoje ręce; aplikacja nigdy nie czyta Twojego hasła, nie wybiera metody płatności i nie płaci.</p>
      <Shot
        src={cart}
        full={cartWindow}
        alt="Okno Wyniki koszyka: „Dodano do koszyków: 4. Nie dodano: 1.”, lista pięciu utworów z wynikami takimi jak „in Bandcamp cart”, „already in Bandcamp cart” i „to playlist” oraz przyciski Otwórz niedodane linki, Pokaż koszyki i Zamknij."
      />
    </div>
  </Track>

  <Track id="prepare" title="Przygotowanie" heading="Gotowe na decki">
    <p class="lede">Foldery z dysku otwierają się w tej samej tabeli i opuszczają ją jako kopie, które Twoje decki odczytają.</p>

    <div class="movement stack">
      <h3>Twoja lokalna biblioteka</h3>
      <p class="copy">
        Przeglądaj foldery obok playlist i twórz z nich lokalne playlisty. BPM i tonacja są szacowane na Twoim
        komputerze i można je poprawić ręcznie; analiza nigdy nie zapisuje tagów audio ani danych rekordbox. WAV, AIFF,
        FLAC, MP3, AAC i M4A.
      </p>
      <Shot
        src={library}
        full={libraryWindow}
        alt="Lokalny folder w tabeli utworów: siedem plików, Drift Away w wykonaniu JMHBM ze statusem Odtworzony, a reszta ze statusem Nowy, z wartościami BPM od 120 do 130 i tonacjami 9A, 8A, 10A, 5A, 7A i 8B."
      />
    </div>

    <div class="movement stack">
      <h3>Eksport pod decki</h3>
      <p class="copy">
        Zaznacz decki, na których pliki mają grać, a aplikacja wybierze najlepszy format, który wszystkie odczytają:
        FLAC, gdy czyta go każdy wybrany deck, a w przeciwnym razie WAV, z najwyższą głębią bitową i częstotliwością
        próbkowania, które obsługują wszystkie. Pliki, które decki już odtwarzają, są kopiowane bez zmian; tylko reszta
        jest konwertowana, do nowego folderu.
      </p>
      <p class="manual"><strong>Gdzie to się kończy</strong> Reguły pochodzą z instrukcji każdego decka: to zgodność plików audio, a nie testy sprzętu ani eksport do rekordbox. Nigdy nie podnosi częstotliwości próbkowania i nigdy nie formatuje dysku.</p>
      <Shot
        src={exportDialog}
        full={exportWindow}
        alt="Okno Eksportuj audio: „Wybierz decki, na których te pliki mają grać; najlepszy format obsługiwany przez wszystkie zostanie dobrany automatycznie.” Dziesięć grup decków jako pola wyboru, od CDJ-350 do OMNIS-DUO i XDJ-AN, z czego pięć zaznaczonych; pusty folder docelowy z przyciskiem Przeglądaj…, Tryb ustawiony na Kopiuj, niezaznaczone Uwzględnij podfoldery oraz przyciski Eksportuj i Anuluj."
      />
    </div>
  </Track>

  <Track id="requirements" title="Wymagania systemowe">
    <p class="copy">Windows 10+, macOS 15+ i Linux.</p>
  </Track>

  <Track id="end" title="Pobierz" heading="Połóż na talerzu">
    <p class="copy">Potem połącz przeglądarkę: bramki pobierania i koszyki w sklepach działają przez rozszerzenie.</p>
    <div class="cta">
      <a class="button primary" href="/pl/download/"><Icon name="download-simple" />Pobierz</a>
      <a class="button" href="/pl/extension/"><Icon name="puzzle-piece" />Poznaj rozszerzenie</a>
    </div>
  </Track>
</Base>

<style>
  /* Collect: the tall sidebar crop stands beside its text once the column has room. */
  .beside {
    container-type: inline-size;
  }
  .beside-grid {
    display: grid;
    gap: 2rem;
  }
  /* The figure is rendered by <Shot>, outside this page's scope. */
  .beside :global(.shot) {
    max-width: 13.75rem;
  }
  @container (min-width: 36rem) {
    .beside-grid {
      grid-template-columns: minmax(0, 1fr) 13.75rem;
      align-items: start;
    }
  }

  /* What each way to a track leaves to you: a margin note, not an alert. */
  .manual {
    max-width: 38rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--edge);
    color: var(--muted);
  }
  .manual strong {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--fg);
  }
</style>
