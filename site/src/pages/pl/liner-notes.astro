---
import { readdirSync, readFileSync, statSync } from "node:fs";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import { author, repo } from "../../../site.config.mjs";

const description =
  "Jak zbudowano dj-digger: architektura, granica zaufania rozszerzenia przeglądarki, zabezpieczenia przed niezaufanymi danymi, światło stopy i jego walidacja, testy i wydania oraz ta strona.";
const tracks = [
  { id: "notes", no: "01", title: "Tył okładki" },
  { id: "architecture", no: "02", title: "Architektura" },
  { id: "browser", no: "03", title: "Granica przeglądarki" },
  { id: "untrusted", no: "04", title: "Domyślnie niezaufane" },
  { id: "kick", no: "05", title: "Puls stopy" },
  { id: "releases", no: "06", title: "Testy i wydania" },
  { id: "website", no: "07", title: "Ta strona" },
  { id: "credits", no: "08", title: "Podziękowania i źródła" },
];

// Figures are counted from the repository at build time, never typed.
// Paths are relative to the working directory (npm runs in site/), as in site.config.mjs.
const testFunctions = readdirSync("../tests", { recursive: true })
  .filter((file) => String(file).endsWith(".py"))
  .reduce((sum, file) => sum + (readFileSync(`../tests/${file}`, "utf8").match(/def test_/g) ?? []).length, 0);
const workflows = readdirSync("../.github/workflows").filter((file) => /\.ya?ml$/.test(file)).length;
const ci = readFileSync("../.github/workflows/ci.yml", "utf8");
const list = (key) => {
  const found = new RegExp(`^\\s*${key}:\\s*\\[([^\\]]+)\\]`, "m").exec(ci);
  if (!found) throw new Error(`ci.yml: no ${key} matrix`); // fail the build rather than print a wrong figure
  return found[1].split(",").map((item) => item.trim().replace(/^["']|["']$/g, ""));
};
const osName = { "ubuntu-latest": "Ubuntu", "macos-latest": "macOS", "windows-latest": "Windows" };
const ciOs = list("os").map((os) => osName[os] ?? os);
const ciPython = list("python-version");
const scriptBytes = statSync("src/scripts/deck.js").size + statSync("src/scripts/geometry.js").size;
const scriptKb = (scriptBytes / 1000).toFixed(1).replace(".", ",");
const count = new Intl.NumberFormat("pl");
const join = (items) => (items.length > 1 ? `${items.slice(0, -1).join(", ")} i ${items.at(-1)}` : items[0]);

const spec = `${repo}/blob/main/PROJECT_SPECIFICATION.md`;
const guide = `${repo}/blob/main/docs/architecture.md`;
const validation = `${repo}/blob/main/docs/kick-pulse-validation.md`;
const workflowsUrl = `${repo}/tree/main/.github/workflows`;
// Anchors are GitHub's slugs of the specification's headings (github-slugger).
const section = {
  urls: { href: `${spec}#111-untrusted-urls-and-ssrf-boundary`, label: "§11.1 Niezaufane adresy URL i granica SSRF" },
  secrets: { href: `${spec}#112-secret-and-personal-data-handling`, label: "§11.2 Obsługa sekretów i danych osobowych" },
  files: { href: `${spec}#113-file-and-mutation-safety`, label: "§11.3 Bezpieczeństwo plików i zmian" },
};

const guards = [
  ["Schematy URL", "Pola utworów, opisy, pliki podsumowań, przekierowania i odpowiedzi bramek są niezaufane, a do przeglądarki trafiają tylko adresy HTTP(S) z hostem.", section.urls],
  ["Granice domen", "Sprawdzanie, czy adres należy do sklepu lub SoundCloud, wymaga dokładnego hosta albo granicy subdomeny, nigdy podciągu, więc łudząco podobny host nie jest sklepem.", section.urls],
  ["Ochrona przed SSRF", "Przed każdym automatycznym żądaniem odrzucane są dane uwierzytelniające w URL, nazwy localhost i dosłowne niepubliczne adresy IP, a każde zweryfikowane przekierowanie jest ograniczone; nazwy DNS nie są wcześniej rozwiązywane, co specyfikacja podaje jako ograniczenie.", section.urls],
  ["Limity pobierania", "Deklarowane i faktyczne rozmiary są ograniczone do 2 GiB, odpowiedzi HTML są odrzucane, a nazwy plików przycinane do samej nazwy, z zamianą niedozwolonych znaków i prefiksem dla nazw zastrzeżonych w Windows.", section.files],
  ["Atomowa podmiana", "Pobrania przez HTTP i przez przeglądarkę są zapisywane do plików tymczasowych i publikowane atomową zmianą nazwy pod wspólną blokadą nazwy, a częściowe pliki są usuwane po błędzie lub anulowaniu.", section.files],
  ["Ponowna walidacja koszyka", "Zapis do koszyka w sklepie wymaga wstępnego sprawdzenia dokładnej pozycji i natychmiastowej ponownej walidacji, a zapisy sieciowe, które mogłyby zdublować zmianę w innym serwisie, nie są automatycznie ponawiane.", section.files],
  ["Sekrety", "Hasła wpisuje się tylko na stronach samego dostawcy, logowanie do SoundCloud zachowuje w systemowym pęku kluczy wyłącznie zweryfikowany oauth_token, pliki tokenów są zapisywane jako prywatne przed atomową podmianą, a logi CLI ukrywają parametry zapytań URL i pola z danymi uwierzytelniającymi.", section.secrets],
];

// The architecture diagram: boxes in the SVG's own units (320 wide), drawn in a column that holds at 328px.
const LINE = 13;
const box = (x, y, w, h, lines, kind = "") => ({ x, y, w, h, lines, kind });
const nodes = [
  box(1, 18, 154, 36, ["CLI"], "ctl"),
  box(165, 18, 154, 36, ["Desktop Qt Quick"], "ctl"),
  box(1, 82, 318, 46, ["ApplicationServices", "leniwe: bez importu Qt, nic nie otwiera przed użyciem"], "named"),
  box(1, 154, 110, 62, ["Usługi", "zbierania,", "pobierania,", "zakupów i kont"]),
  box(119, 154, 96, 62, ["Usługa", "biblioteki"]),
  box(223, 154, 96, 62, ["Usługa", "odtwarzania"]),
  box(1, 242, 110, 50, ["Adaptery", "SoundCloud,", "bramek i sklepów"]),
  box(119, 242, 96, 50, ["Repozytoria"]),
  box(223, 242, 96, 50, ["Silnik audio", "w pamięci"]),
  box(119, 318, 96, 44, ["Wątek", "właściciel", "SQLite"], "owner"),
  box(1, 378, 318, 58, ["OperationCoordinator", "jeden slot główny, jeden do skanowania:", "przyjmuje pracę i śledzi anulowanie do końca"], "named coord"),
];
const wires = [[78, 54, 80], [242, 54, 80], [56, 128, 152], [167, 128, 152], [271, 128, 152], [56, 216, 240], [167, 216, 240], [271, 216, 240], [167, 292, 316]];
const baseline = (node, i) => node.y + node.h / 2 - ((node.lines.length - 1) * LINE) / 2 + 4 + i * LINE;
---

<Base title="Tył okładki: jak zbudowano dj-digger" description={description} label="notes" tracks={tracks}>
  <Track id="notes" no="01" title="Tył okładki" hero sub>
    <Fragment slot="heading">Tył okładki: <span class="grad">jak zbudowano dj-digger</span></Fragment>
    <p class="lede">
      Drobny druk z tyłu okładki: jak złożona jest aplikacja, gdzie wyznacza granice i jak się ją sprawdza. Każde
      stwierdzenie na tej stronie prowadzi do dokumentu lub pliku, z którego pochodzi.
    </p>
    <p class="copy">
      Napisał, zrealizował i wytłoczył <a href={author.url}>{author.name}</a>.
    </p>
    <ul class="facts">
      <li>Python 3.12+</li>
      <li>Qt Quick</li>
      <li>Rozszerzenie Manifest V3</li>
      <li>SQLite</li>
      <li>Bez serwera dj-digger</li>
    </ul>
  </Track>

  <Track id="architecture" no="02" title="Architektura" heading="Kontrolery prezentują, usługi odpowiadają za skutki">
    <p class="lede">
      CLI i desktop w Qt to kontrolery nad tymi samymi usługami aplikacji. Kontrolery odpowiadają za prezentację;
      usługi za ukończone skutki i cykl życia zasobów; jeden koordynator przyjmuje pracę i śledzi anulowanie, aż
      wątki robocze skończą.
    </p>
    <figure class="diagram">
      <svg class="arch" viewBox="0 0 320 438" role="img" aria-labelledby="arch-title arch-desc">
        <title id="arch-title">Z czego składa się dj-digger</title>
        <desc id="arch-desc">
          CLI i desktop w Qt Quick to kontrolery nad ApplicationServices, które leniwie składa usługi aplikacji i nie
          importuje Qt. Usługi zbierania, pobierania, zakupów i kont korzystają z adapterów SoundCloud, bramek
          i sklepów. Usługa biblioteki działa przez repozytoria na wątku, który jest właścicielem SQLite. Usługa
          odtwarzania steruje silnikiem audio w pamięci. OperationCoordinator, z jednym slotem głównym i jednym do
          skanowania, przyjmuje pracę i śledzi anulowanie, aż wątki robocze skończą.
        </desc>
        <defs>
          <marker id="arch-tip" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path class="tip" d="M0 0L8 4L0 8z"></path>
          </marker>
        </defs>
        <text class="group" x="1" y="10">KONTROLERY</text>
        {wires.map(([x, from, to]) => <path class="wire" d={`M${x} ${from}V${to}`} marker-end="url(#arch-tip)" />)}
        {
          nodes.map((node) => (
            <g class={node.kind}>
              <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
              {node.lines.map((line, i) => (
                <text x={node.x + node.w / 2} y={baseline(node, i)} class={node.kind.includes("named") && i > 0 ? "sub" : undefined}>
                  {line}
                </text>
              ))}
            </g>
          ))
        }
      </svg>
    </figure>
    <ul class="ticks rules">
      <li>
        <strong>Żadnej blokującej pracy w wątku UI.</strong> Backend, most sygnałów Qt, model tabeli i okno QML dzielą
        między siebie orkiestrację, sygnały, wiersze i renderowanie; żadne z nich nie wykonuje blokującej pracy
        sieciowej ani dyskowej w wątku UI, a wyniki wracają do niego (<a href={`${guide}#ui-ownership`}>własność UI</a>).
      </li>
      <li>
        <strong>SQLite ma jeden wątek-właściciel.</strong> Transakcje są jawne i krótkie, w żadnej nie dzieje się nic
        z siecią, przeglądarką ani oknem dialogowym, status i pochodzenie pliku są zatwierdzane razem, a kopie
        w pamięci zmieniają się dopiero po zatwierdzeniu
        (<a href={`${guide}#persistent-effects-and-identity`}>trwałe skutki i tożsamość</a>).
      </li>
      <li>
        <strong>Składanie nie importuje Qt.</strong> Utworzenie <code>ApplicationServices</code> nie importuje Qt i nie
        otwiera bazy danych, urządzenia ani połączenia z przeglądarką; CLI i desktop dostają z niego tę samą leniwą
        usługę zbierania (<a href={`${guide}#composition-and-execution`}>składanie i wykonanie</a>).
      </li>
    </ul>
    <p class="copy">
      Przewodnik mówi też, czego projekt nie obiecuje: nie ma przypinania DNS, audytu bezpieczeństwa ani transakcji
      obejmujących jednocześnie system plików i SQLite.
    </p>
    <p><a class="quiet" href={guide}>Przeczytaj przewodnik po architekturze (po angielsku)</a></p>
  </Track>

  <Track id="browser" no="03" title="Granica przeglądarki" heading="Sterować przeglądarką, nie przejmując jej">
    <p class="lede">
      Bramki i koszyki działają w prawdziwej, zalogowanej przeglądarce użytkownika, więc rozszerzenie samo pilnuje
      swoich granic, cokolwiek wyśle mu aplikacja desktopowa.
    </p>
    <div class="movement">
      <h3>Jeden kanał, zero zdalnego kodu</h3>
      <p class="copy">
        Jedynym wejściem poleceń jest port native messaging od aplikacji na tym samym komputerze: manifest nie ma
        <code>externally_connectable</code> ani <code>web_accessible_resources</code>, a żaden skrypt strony nie
        nasłuchuje <code>window.postMessage</code>. Nie ma <code>eval</code>; jedyne funkcje uruchamiane na stronie to
        nazwane, tylko do odczytu, dołączone do rozszerzenia. Po stronie aplikacji katalog gniazda jest prywatny dla
        użytkownika, a strony połączenia uwierzytelniają się kluczem z pliku o uprawnieniach 0600.
      </p>
    </div>
    <div class="movement">
      <h3>Stała lista stron</h3>
      <p class="copy">
        Jeden plik <code>allowlist.json</code> steruje skryptem w tle, a test porównuje go z listami hostów w Pythonie
        i uprawnieniami do hostów w manifeście: HTTPS na domyślnym porcie, bez danych uwierzytelniających, do Hypeddit,
        ToneDen, Bandcamp i Beatport oraz strony logowania SoundCloud. Nawigacja w każde inne miejsce jest odrzucana.
      </p>
    </div>
    <div class="movement">
      <h3>Tylko własne karty</h3>
      <p class="copy">
        Polecenia działają na kartach i oknach roboczych, które utworzyło rozszerzenie, oraz na ich wyskakujących
        oknach, nigdy na innych kartach użytkownika. Odczyt lub kliknięcie wymaga też, by bieżący adres karty był na
        liście dozwolonych; każdy inny adres jest przycinany do <code>https://&lt;host&gt;/</code>, zanim zostanie
        zgłoszony, a parametry OAuth są usuwane. Każda własna karta jest wyciszona.
      </p>
    </div>
    <div class="movement">
      <h3>Twardy stop przed pieniędzmi</h3>
      <p class="copy">
        Własna karta Bandcamp lub Beatport, która przechodzi lub zostaje przekierowana na ścieżkę kasy, finalizacji
        koszyka, płatności lub rozliczeń, jest zamykana i zgłaszana. Kliknięcia w elementy nazwane check out, pay,
        purchase, place order, buy now lub complete order są odrzucane, a wypełnianie formularzy odmawia pól hasła
        i karty płatniczej.
      </p>
    </div>
    <div class="cta">
      <a class="quiet" href={`${spec}#114-browser-extension-trust-boundary`}>§11.4 Granica zaufania rozszerzenia przeglądarki</a>
      <a class="quiet" href={`${repo}/blob/main/CHROMEWEBSTORE.md`}>Uzasadnienia uprawnień</a>
      <a class="quiet" href="/pl/extension/">Strona rozszerzenia</a>
    </div>
  </Track>

  <Track id="untrusted" no="04" title="Domyślnie niezaufane" heading="Każdy link jest niezaufany">
    <p class="lede">
      Linki artystów, przekierowania, odpowiedzi dostawców i nazwy plików są traktowane jako wrogie dane. Te
      zabezpieczenia istnieją w kodzie; każde prowadzi do części specyfikacji, która je opisuje.
    </p>
    <ul class="guards">
      {
        guards.map(([name, text, source]) => (
          <li>
            <h3>{name}</h3>
            <p>{text}</p>
            <a href={source.href}>{source.label}</a>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="kick" no="05" title="Puls stopy" heading="Światło, które idzie za stopą, a nie za basem">
    <p class="lede">
      Światło odtwarzacza podąża za ciągłym poziomem stopy, wyliczanym z dźwięku, zanim dotrze on do głośnika, a nie za
      decyzjami „jest bit albo nie ma”, więc przegapiona decyzja nigdy go nie zatrzyma.
    </p>
    <Loop>Nagrane w prawdziwej aplikacji z syntetycznym utworem demo. Renderer programowy użyty do nagrania nie rysuje poświaty GPU, więc prawdziwe światło jest mocniejsze.</Loop>
    <div class="movement">
      <h3>Za czym idzie światło</h3>
      <p class="copy">
        <code>beats.py</code> porównuje każde pasmo niskich częstotliwości zdekodowanego dźwięku z jego własną niedawną
        medianą, więc trzymany bas, powrót po sidechainie czy pad stają się punktem odniesienia i liczy się tylko to, co
        się ponad nie wybija. Ten wzrost jest ważony tym, jak bardzo przypomina stopę. Własną stopę utworu algorytm
        poznaje tylko z uderzeń, których wysokość opada, więc powtarzana nuta basu nigdy nią nie zostaje
        (<a href={`${spec}#34-audio-preview`}>§3.4 Podgląd audio</a>).
      </p>
    </div>
    <div class="movement">
      <h3>Przed głośnikiem</h3>
      <p class="copy">
        Odtwarzacz dekoduje z wyprzedzeniem względem urządzenia audio, więc każdy poziom istnieje, zanim jego dźwięk
        zostanie usłyszany, a okno odczytuje go względem czasu, który faktycznie dociera do głośnika, mierzonego tym, co
        pobrało urządzenie. 2026-10-01, przy odtwarzaniu jednego utworu od 60 s na maszynie deweloperskiej (PipeWire,
        okresy 50 ms), poziomy wyprzedzały pozycję urządzenia o 184–189 ms, podczas gdy zmierzona kolejka urządzenia
        wynosiła 46–71 ms; analiza zajmowała około 0,57 % czasu rzeczywistego.
      </p>
    </div>
    <div class="movement">
      <h3>Kształt światła</h3>
      <p class="copy">
        Światło jest analogowe: od razu skacze do poziomu stopy i wygasa wykładniczo, jak lampa, więc pełna stopa gaśnie
        przed następną, a cichsze niskie uderzenia świecą słabiej i krócej
        (<a href={`${spec}#38-qt-quick-desktop`}>§3.8 Desktop Qt Quick</a>). Kiedyś jaśniejszy, pastelowy kolor
        spoczynkowy sprawiał, że stopa wyglądała jak gaśnięcie światła; w nasyconych kolorach zmierzonych 2026-10-01
        neon jest 2,1–2,2 raza jaśniejszy od spoczynku.
      </p>
    </div>
    <div class="movement">
      <h3>Sprawdzone w prawdziwym oknie</h3>
      <p class="copy">
        Pomiary offline mówiły, że dwa zgłoszone utwory są w porządku, więc 2026-10-01 uruchomiono prawdziwy stos (okno,
        most, backend, odtwarzacz i urządzenie audio; wyciszone, poza ekranem, na odizolowanym stanie aplikacji),
        logując w każdej klatce światło, zegar i poziomy okna. Znalazły się dwa błędy poza analizą. Poziomy między
        0 a 1 były liczbami zmiennoprzecinkowymi numpy, które Qt przekazuje do QML jako nieprzezroczyste obiekty, a nie
        liczby, więc świeciły tylko poziomy równe dokładnie 0 i 1; teraz poziomy to zwykłe liczby float. Do tego po
        starcie urządzenie pobierało pierwsze 50 ms od razu, a kolejne dopiero później, więc słyszany czas był
        przycinany do przekazanej pozycji i spieszył się o około 70 ms, skacząc co 50 ms; teraz kolejka nigdy nie jest
        przyjmowana jako mniejsza niż to, co przekazało ostatnie wywołanie zwrotne.
      </p>
      <div class="table">
        <table>
          <caption>Kalipo – Captain, 45–105 s, na żywo w prawdziwym oknie, 2026-10-01</caption>
          <thead>
            <tr><th scope="col">Miara</th><th scope="col">Przed</th><th scope="col">Po</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Stopy o jasności poniżej 0,3</th><td>20 ze 114</td><td>0</td></tr>
            <tr><th scope="row">Najciemniejsza stopa</th><td>0,00</td><td>0,95</td></tr>
            <tr><th scope="row">Klatki z zegarem zablokowanym na pozycji migawki</th><td>54 %</td><td>0 %</td></tr>
            <tr><th scope="row">Skoki słyszanego czasu powyżej 20 ms</th><td>1199</td><td>0</td></tr>
          </tbody>
        </table>
      </div>
      <p class="copy">
        Na drugim utworze, już po poprawce, 62 stopy miały medianę jasności 0,94 i żadna nie spadła poniżej 0,3, przy
        oknie działającym w 63 klatkach na sekundę i bez przerwy między klatkami dłuższej niż 28 ms.
      </p>
    </div>
    <p><a class="quiet" href={validation}>Przeczytaj notatki z walidacji (po angielsku)</a></p>
  </Track>

  <Track id="releases" no="06" title="Testy i wydania" heading="Od commita do instalatora">
    <p class="lede">
      Workflowy (plików: {workflows}) prowadzą zmianę od commita do instalatorów i sklepów. Każdy krok poniżej to to, co
      uruchamia workflow, tak jak zapisuje to specyfikacja.
    </p>
    <ol class="steps">
      <li>
        <span class="no">01</span>
        <h3>Zestaw offline</h3>
        <p>
          Funkcje testowe w <code>tests/</code>: {count.format(testFunctions)}. Domyślnie markery live są wyłączone,
          fixture autouse przenosi konfigurację, uwierzytelnianie, bazę danych i foldery skanowania do katalogu
          tymczasowego, a domyślny transport HTTP jest zablokowany, więc żaden test nie dociera do żywego endpointu,
          danych użytkownika ani folderów z muzyką. CI uruchamia go przy każdym pushu i pull requeście na {join(ciOs)}
          z Pythonem {join(ciPython)} (zadań: {ciOs.length * ciPython.length}), po sprawdzeniu mapy specyfikacji i Ruff,
          i w każdym zadaniu buduje i sprawdza odizolowaną instalację wheel.
        </p>
      </li>
      <li>
        <span class="no">02</span>
        <h3>Kontrakty na żywo</h3>
        <p>
          Cotygodniowy workflow uruchamia osobno oznaczony zestaw live na API SoundCloud: wykrywanie client ID, długie
          kolekcje, hydratację, dostępność mediów i dekodowanie gniazd. To monitoring, a nie bramka wydania. Testy
          sklepów i bramek uruchamia się ręcznie: publiczne strony sklepów odczytywane przez rozszerzenie bez logowania
          i bez dotykania koszyka oraz inspekcja bramek wyłącznie żądaniami GET.
        </p>
      </li>
      <li>
        <span class="no">03</span>
        <h3>Instalatory</h3>
        <p>
          Kontrakty desktopu i odizolowany start działają na Linuksie, Windows i macOS. Potem CI buduje instalator
          Windows x64 oraz natywne obrazy dysku macOS arm64 i x86_64, weryfikuje dołączone środowisko uruchomieniowe
          i instalację każdego z nich i wysyła każdy jako artefakt testowy z plikiem SHA-256 obok. To niepodpisane
          wersje przedpremierowe; testy na fizycznych urządzeniach są osobne.
        </p>
      </li>
      <li>
        <span class="no">04</span>
        <h3>Publikacja</h3>
        <p>
          Opublikowane stabilne wydanie uruchamia własną macierz testów, a potem wysyła paczkę do PyPI przez trusted
          publishing (OIDC); tylko to zadanie może zażądać tokenu tożsamości, a akcje zewnętrzne są przypięte do
          commitów. To samo wydanie pakuje rozszerzenie i przesyła je do Chrome Web Store przez jego API,
          uwierzytelnione jako konto usługi. Wydania przedpremierowe pomijają oba kroki.
        </p>
      </li>
    </ol>
