---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Shot from "../../components/Shot.astro";
import Track from "../../components/Track.astro";
import collect from "../../assets/screenshots/pl/crops/collect.png";
import decisions from "../../assets/screenshots/pl/crops/decisions.png";
import panelJob from "../../assets/screenshots/extension-panel-job.png";
import libraryWindow from "../../assets/screenshots/pl/desktop-local-library.png";
import playerWindow from "../../assets/screenshots/pl/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/pl/desktop-crates-decisions.png";
import { version } from "../../../site.config.mjs";

const description =
  "Darmowa, otwartoźródłowa aplikacja dla DJ-ów: importuj playlisty i polubienia z SoundCloud, odsłuchaj je i kup każdy utwór na Bandcamp lub Beatport albo pobierz przez bramkę.";
const loop = [
  {
    name: "Zbierz",
    text: "Wklej link do playlisty, polubień albo profilu. Przychodzi cała lista, a nie tylko wiersze, które wyrenderowała strona.",
    src: collect,
    full: playerWindow,
    alt: "Okno dj-digger: w panelu bocznym otwarta playlista Late Night Selects, odtwarzacz na utworze Drift Away w wykonaniu JMHBM na 1:21 z 3:01 z przebiegiem dźwięku, przyciski sklepów, takie jak Bandcamp 4 i Beatport 3, oraz pierwsze wiersze tabeli utworów.",
  },
  {
    name: "Zdecyduj",
    text: "Oznaczaj utwory jako posiadane albo pominięte. Decyzja idzie za utworem na każdą playlistę, na której się pojawia.",
    src: decisions,
    full: decisionsWindow,
    alt: "Tabela utworów z otwartym filtrem statusu: wiersze ze statusem Mam, Odtworzony, Otwarty i Nowy oraz menu z opcjami Wszystkie statusy, Nieobsłużone, Nowy, Otwarte, Posiadane i Pominięte.",
  },
  {
    name: "Kup lub pobierz",
    text: "Dalej resztę robi rozszerzenie, w Twojej własnej przeglądarce: przechodzi bramki pobierania i wypełnia koszyki w sklepach. Do kasy idziesz już sam.",
    src: panelJob,
    alt: "Panel rozszerzenia przeglądarki dj-digger: Drift Away w wykonaniu JMHBM na 1:27 z 3:01, przyciski sterowania, a pod nimi komunikat „Adding to store carts” z przyciskiem Cancel.",
  },
];
---

<Base title="dj-digger: darmowa aplikacja do digowania z SoundCloud" description={description}>
  <section class="hero" id="start" aria-labelledby="start-title">
    <h1 id="start-title">Od playlisty w SoundCloud do <span class="grad">plików na Twoich deckach</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> to darmowa, otwartoźródłowa aplikacja dla DJ-ów. Zbiera całe playlisty z SoundCloud, pamięta Twoje decyzje i szuka sposobu, by kupić lub pobrać każdy utwór.
    </p>
    <div class="cta">
      <a class="button primary" href="/pl/download/"><Icon name="download-simple" />Pobierz</a>
    </div>
    <ul class="facts">
      <li>Bezpłatny i otwartoźródłowy</li>
      <li>Windows, macOS, Linux</li>
      <li>Bez konta, bez serwera</li>
    </ul>
    <Loop eager />
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the three steps
      one at a time. Everywhere else, and without the CSS below, three stacked steps. */}
  <section id="loop" class="loop" aria-labelledby="loop-title">
    <div class="stage stack">
      <h2 id="loop-title">Jedna pętla, od początku do końca</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step) => (
            <li class="movement">
              <div class="text">
                <h3>{step.name}</h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" title="Aplikacja desktopowa">
    <Shot
      src={libraryWindow}
      alt="Okno główne dj-digger na lokalnym folderze Digging 2026: odtwarzacz na utworze Drift Away w wykonaniu JMHBM na 1:27 z 3:01 i siedem utworów z wartościami BPM od 120 do 130 oraz tonacjami takimi jak 9A, 8A i 5A."
    />
    <ul class="ticks">
      <li>Wie, co już masz</li>
      <li>Szacuje BPM i tonację</li>
      <li>Eksportuje pod Twoje decki</li>
    </ul>
    <div class="cta"><a class="button" href="/pl/app/"><Icon name="desktop" />Poznaj aplikację</a></div>
  </Track>

  <Track id="extension" title="Rozszerzenie przeglądarki">
    <p class="copy">
      W Twoim własnym Chrome, Edge albo Brave przechodzi bramki pobierania, wypełnia koszyki w sklepach i umieszcza
      odtwarzacz na pasku narzędzi.
    </p>
    <div class="cta"><a class="button" href="/pl/extension/"><Icon name="puzzle-piece" />Poznaj rozszerzenie</a></div>
  </Track>

  <Track id="trust" title="Twoja i szczera" heading="Twoja i szczera co do swoich ograniczeń">
    <ul class="ticks">
      <li>Twoje playlisty i decyzje zostają na Twoim komputerze.</li>
      <li>Nigdy nie płaci ani nie finalizuje zakupu za Ciebie.</li>
      <li>Nigdy nie zgaduje: przy niejasnym dopasowaniu zatrzymuje się i to zgłasza.</li>
    </ul>
  </Track>

  <Track id="get" title="Pobierz" heading="Pobierz dj-digger">
    <p class="copy">dj-digger {version}, bezpłatnie na Windows, macOS i Linux.</p>
    <div class="cta"><a class="button primary" href="/pl/download/"><Icon name="download-simple" />Pobierz</a></div>
  </Track>
</Base>

<style>
  /* ---------- the loop: three stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each shot keeps its own shape; the frame sits on the image so it hugs narrow and wide shots alike.
     --ar is the image's width / height, so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 2.3623;
  }
  .steps > li:nth-child(2) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(3) {
    --ar: 0.6413;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 320svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All three share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      /* The whole image fits the stage: as wide as the column allows, never taller than the cell. */
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
        max-height: calc(100cqh - 2px);
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 33.333%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 33.333% contain 66.667%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 66.667% contain 100%;
      }
    }
  }
  /* Full opacity over 90% of a step's range; the hand-over is a short cross-fade.
     z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    5%,
    95% {
      color: var(--fg);
    }
  }
</style>
