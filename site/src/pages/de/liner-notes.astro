---
import { readdirSync, readFileSync, statSync } from "node:fs";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import { author, repo } from "../../../site.config.mjs";

const description =
  "Wie dj-digger gebaut ist: Architektur, die Vertrauensgrenze der Browser-Erweiterung, Schutz vor nicht vertrauenswürdigen Eingaben, das Kick-Licht und seine Validierung, Tests und Releases sowie diese Website.";
const tracks = [
  { id: "notes", no: "01", title: "Liner Notes" },
  { id: "architecture", no: "02", title: "Architektur" },
  { id: "browser", no: "03", title: "Die Browsergrenze" },
  { id: "untrusted", no: "04", title: "Grundsätzlich misstrauisch" },
  { id: "kick", no: "05", title: "Kick-Puls" },
  { id: "releases", no: "06", title: "Tests und Releases" },
  { id: "website", no: "07", title: "Diese Website" },
  { id: "credits", no: "08", title: "Credits und Quellen" },
];

// Figures are counted from the repository at build time, never typed.
// Paths are relative to the working directory (npm runs in site/), as in site.config.mjs.
const testFunctions = readdirSync("../tests", { recursive: true })
  .filter((file) => String(file).endsWith(".py"))
  .reduce((sum, file) => sum + (readFileSync(`../tests/${file}`, "utf8").match(/def test_/g) ?? []).length, 0);
const workflows = readdirSync("../.github/workflows").filter((file) => /\.ya?ml$/.test(file)).length;
const ci = readFileSync("../.github/workflows/ci.yml", "utf8");
const list = (key) => {
  const found = new RegExp(`^\\s*${key}:\\s*\\[([^\\]]+)\\]`, "m").exec(ci);
  if (!found) throw new Error(`ci.yml: no ${key} matrix`); // fail the build rather than print a wrong figure
  return found[1].split(",").map((item) => item.trim().replace(/^["']|["']$/g, ""));
};
const osName = { "ubuntu-latest": "Ubuntu", "macos-latest": "macOS", "windows-latest": "Windows" };
const ciOs = list("os").map((os) => osName[os] ?? os);
const ciPython = list("python-version");
const scriptBytes = statSync("src/scripts/deck.js").size + statSync("src/scripts/geometry.js").size;
const scriptKb = (scriptBytes / 1000).toFixed(1).replace(".", ",");
const count = new Intl.NumberFormat("de");
const join = (items) => (items.length > 1 ? `${items.slice(0, -1).join(", ")} und ${items.at(-1)}` : items[0]);

const spec = `${repo}/blob/main/PROJECT_SPECIFICATION.md`;
const guide = `${repo}/blob/main/docs/architecture.md`;
const validation = `${repo}/blob/main/docs/kick-pulse-validation.md`;
const workflowsUrl = `${repo}/tree/main/.github/workflows`;
// Anchors are GitHub's slugs of the specification's headings (github-slugger).
const section = {
  urls: { href: `${spec}#111-untrusted-urls-and-ssrf-boundary`, label: "§11.1 Nicht vertrauenswürdige URLs und SSRF-Grenze" },
  secrets: { href: `${spec}#112-secret-and-personal-data-handling`, label: "§11.2 Umgang mit Geheimnissen und personenbezogenen Daten" },
  files: { href: `${spec}#113-file-and-mutation-safety`, label: "§11.3 Sicherheit von Dateien und Änderungen" },
};

const guards = [
  ["URL-Schemata", "Track-Felder, Beschreibungen, Übersichtsdateien, Weiterleitungen und Gate-Antworten gelten als nicht vertrauenswürdig, und nur HTTP(S)-URLs mit Host werden an den Browser übergeben.", section.urls],
  ["Domaingrenzen", "Prüfungen, ob etwas zu einem Shop oder zu SoundCloud gehört, vergleichen den exakten Host oder eine Subdomain-Grenze, nie eine Teilzeichenkette, sodass ein ähnlich aussehender Host kein Shop ist.", section.urls],
  ["SSRF-Schutz", "Vor jeder automatischen Anfrage werden Zugangsdaten in URLs, localhost-Namen und literale nicht-globale IP-Adressen abgelehnt, und jede validierte Weiterleitung ist begrenzt; DNS-Namen werden vorher nicht aufgelöst, eine Einschränkung, die die Spezifikation nennt.", section.urls],
  ["Download-Limits", "Angegebene und tatsächliche Größen sind auf 2 GiB begrenzt, HTML-Inhalte werden abgelehnt, und Dateinamen werden auf ihren Basisnamen gekürzt, ungültige Zeichen ersetzt und reservierte Windows-Namen mit einem Präfix versehen.", section.files],
  ["Atomares Ersetzen", "HTTP- und Browser-Downloads werden in temporäre Dateien geschrieben und unter einer gemeinsamen Namenssperre per atomarem Umbenennen veröffentlicht; Teildateien werden bei Fehler oder Abbruch entfernt.", section.files],
  ["Warenkorb-Nachprüfung", "Schreibvorgänge in Shop-Warenkörbe brauchen eine Vorabprüfung des exakten Artikels und eine sofortige Nachprüfung, und Netzwerk-Schreibvorgänge, die eine Änderung auf einer anderen Website verdoppeln könnten, werden nicht automatisch wiederholt.", section.files],
  ["Geheimnisse", "Passwörter werden nur auf den eigenen Seiten des Anbieters eingegeben, die SoundCloud-Anmeldung behält nur das verifizierte oauth_token im Schlüsselbund des Systems, Token-Dateien werden vor einem atomaren Ersetzen privat geschrieben, und CLI-Logs schwärzen URL-Querys und Felder mit Zugangsdaten.", section.secrets],
];

// The architecture diagram: boxes in the SVG's own units (320 wide), drawn in a column that holds at 328px.
const LINE = 13;
const box = (x, y, w, h, lines, kind = "") => ({ x, y, w, h, lines, kind });
const nodes = [
  box(1, 18, 154, 36, ["CLI"], "ctl"),
  box(165, 18, 154, 36, ["Qt-Quick-Desktop"], "ctl"),
  box(1, 82, 318, 46, ["ApplicationServices", "lazy: importiert kein Qt, öffnet nichts vor Gebrauch"], "named"),
  box(1, 154, 110, 62, ["Sammlungs-,", "Download-,", "Kauf- und", "Kontodienste"]),
  box(119, 154, 96, 62, ["Bibliotheks-", "dienst"]),
  box(223, 154, 96, 62, ["Wiedergabe-", "dienst"]),
  box(1, 242, 110, 50, ["SoundCloud-,", "Gate- und", "Shop-Adapter"]),
  box(119, 242, 96, 50, ["Repositorys"]),
  box(223, 242, 96, 50, ["Audio-Engine", "im Speicher"]),
  box(119, 318, 96, 44, ["SQLite-", "Owner-Thread"], "owner"),
  box(1, 378, 318, 58, ["OperationCoordinator", "ein Haupt-Slot, ein Scan-Slot: lässt Arbeit zu", "und verfolgt Abbrüche, bis Worker fertig sind"], "named coord"),
];
const wires = [[78, 54, 80], [242, 54, 80], [56, 128, 152], [167, 128, 152], [271, 128, 152], [56, 216, 240], [167, 216, 240], [271, 216, 240], [167, 292, 316]];
const baseline = (node, i) => node.y + node.h / 2 - ((node.lines.length - 1) * LINE) / 2 + 4 + i * LINE;
---

<Base title="Liner Notes: wie dj-digger gebaut ist" description={description} label="notes" tracks={tracks}>
  <Track id="notes" no="01" title="Liner Notes" hero sub>
    <Fragment slot="heading">Liner Notes: <span class="grad">wie dj-digger gebaut ist</span></Fragment>
    <p class="lede">
      Die Rückseite der Hülle: wie die App aufgebaut ist, wo sie ihre Grenzen zieht und wie sie geprüft wird. Jede Aussage
      hier verlinkt auf das Dokument oder die Datei, aus der sie stammt.
    </p>
    <p class="copy">
      Geschrieben, produziert und gepresst von <a href={author.url}>{author.name}</a>.
    </p>
    <ul class="facts">
      <li>Python 3.12+</li>
      <li>Qt Quick</li>
      <li>Manifest-V3-Erweiterung</li>
      <li>SQLite</li>
      <li>Kein dj-digger-Server</li>
    </ul>
  </Track>

  <Track id="architecture" no="02" title="Architektur" heading="Controller präsentieren, Services verantworten die Effekte">
    <p class="lede">
      Die CLI und der Qt-Desktop sind Controller über denselben Anwendungsservices. Controller verantworten die
      Darstellung; Services verantworten abgeschlossene Effekte und Lebenszyklen von Ressourcen; ein Koordinator lässt
      Arbeit zu und verfolgt Abbrüche, bis die Worker fertig sind.
    </p>
    <figure class="diagram">
      <svg class="arch" viewBox="0 0 320 438" role="img" aria-labelledby="arch-title arch-desc">
        <title id="arch-title">Wie dj-digger zusammengesetzt ist</title>
        <desc id="arch-desc">
          Die CLI und der Qt-Quick-Desktop sind Controller über ApplicationServices, das die Anwendungsservices lazy
          zusammensetzt und kein Qt importiert. Sammlungs-, Download-, Kauf- und Kontodienste nutzen die SoundCloud-, Gate-
          und Shop-Adapter. Der Bibliotheksdienst arbeitet über Repositorys auf dem SQLite-Owner-Thread. Der
          Wiedergabedienst steuert die Audio-Engine im Arbeitsspeicher. Der OperationCoordinator mit einem Haupt-Slot und
          einem Scan-Slot lässt Arbeit zu und verfolgt Abbrüche, bis die Worker fertig sind.
        </desc>
        <defs>
          <marker id="arch-tip" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path class="tip" d="M0 0L8 4L0 8z"></path>
          </marker>
        </defs>
        <text class="group" x="1" y="10">CONTROLLER</text>
        {wires.map(([x, from, to]) => <path class="wire" d={`M${x} ${from}V${to}`} marker-end="url(#arch-tip)" />)}
        {
          nodes.map((node) => (
            <g class={node.kind}>
              <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
              {node.lines.map((line, i) => (
                <text x={node.x + node.w / 2} y={baseline(node, i)} class={node.kind.includes("named") && i > 0 ? "sub" : undefined}>
                  {line}
                </text>
              ))}
            </g>
          ))
        }
      </svg>
    </figure>
    <ul class="ticks rules">
      <li>
        <strong>Keine blockierende Arbeit im UI-Thread.</strong> Backend, Qt-Signal-Bridge, Tabellenmodell und QML-Fenster
        teilen sich Orchestrierung, Signale, Zeilen und Rendering; keines davon erledigt blockierende Netzwerk- oder
        Festplattenarbeit im UI-Thread, und Ergebnisse werden an ihn zurückgegeben (<a href={`${guide}#ui-ownership`}>UI ownership</a>).
      </li>
      <li>
        <strong>Ein Thread besitzt SQLite.</strong> Transaktionen sind explizit und kurz, in keiner passiert Netzwerk,
        Browser oder Dialog, Status und Dateiherkunft werden gemeinsam committet, und Spiegel im Arbeitsspeicher ändern
        sich erst nach dem Commit (<a href={`${guide}#persistent-effects-and-identity`}>Persistent effects and identity</a>).
      </li>
      <li>
        <strong>Die Komposition importiert kein Qt.</strong> Das Erzeugen von <code>ApplicationServices</code> importiert
        kein Qt und öffnet keine Datenbank-, Geräte- oder Browserverbindung; CLI und Desktop bekommen daraus denselben
        lazy Sammlungsdienst (<a href={`${guide}#composition-and-execution`}>Composition and execution</a>).
      </li>
    </ul>
    <p class="copy">
      Die Anleitung sagt auch, was das Design nicht behauptet: kein DNS-Pinning, kein Sicherheitsaudit und keine
      Transaktion, die Dateisystem und SQLite umspannt.
    </p>
    <p><a class="quiet" href={guide}>Zum Architekturleitfaden</a></p>
  </Track>

  <Track id="browser" no="03" title="Die Browsergrenze" heading="Deinen Browser steuern, ohne ihn zu besitzen">
    <p class="lede">
      Gates und Warenkörbe laufen im echten, angemeldeten Browser des Nutzers, deshalb setzt die Erweiterung ihre eigenen
      Grenzen durch, egal, was die Desktop-App ihr schickt.
    </p>
    <div class="movement">
      <h3>Ein Kanal, kein entfernter Code</h3>
      <p class="copy">
        Die einzige Befehlseingabe ist der Native-Messaging-Port der App auf demselben Computer: Das Manifest hat
        kein <code>externally_connectable</code> und keine <code>web_accessible_resources</code>, und kein Seitenskript hört
        auf <code>window.postMessage</code>. Es gibt kein <code>eval</code>; die einzigen Funktionen, die in einer Seite
        laufen, sind benannte, rein lesende, die mit der Erweiterung ausgeliefert werden. Auf der Seite der App ist das
        Socket-Verzeichnis privat für den Nutzer, und Gegenstellen authentifizieren sich mit einem Schlüssel in einer
        0600-Datei.
      </p>
    </div>
    <div class="movement">
      <h3>Eine feste Liste von Websites</h3>
      <p class="copy">
        Eine <code>allowlist.json</code> steuert das Hintergrundskript, und ein Test vergleicht sie mit den Host-Listen in
        Python und den Host-Berechtigungen des Manifests: HTTPS auf dem Standardport, ohne Zugangsdaten, zu Hypeddit,
        ToneDen, Bandcamp und Beatport sowie zur Anmeldeseite von SoundCloud. Eine Navigation irgendwo anders hin wird
        verweigert.
      </p>
    </div>
    <div class="movement">
      <h3>Nur ihre eigenen Tabs</h3>
      <p class="copy">
        Befehle wirken auf die Tabs und Arbeitsfenster, die die Erweiterung erstellt hat, und auf deren Pop-ups, nie auf
        die anderen Tabs des Nutzers. Lesen oder Klicken setzt außerdem voraus, dass die aktuelle Adresse des Tabs auf der
        Allowlist steht; jede andere Adresse wird vor dem Melden auf <code>https://&lt;host&gt;/</code> gekürzt, und
        OAuth-Parameter werden entfernt. Jeder eigene Tab ist stummgeschaltet.
      </p>
    </div>
    <div class="movement">
      <h3>Harter Stopp vor dem Geld</h3>
      <p class="copy">
        Ein eigener Bandcamp- oder Beatport-Tab, der zu einem Checkout-, Cart-Checkout-, Zahlungs- oder Rechnungspfad
        navigiert oder umgeleitet wird, wird geschlossen und gemeldet. Klicks auf Elemente namens check out, pay, purchase,
        place order, buy now oder complete order werden verweigert, und das Ausfüllen von Formularen verweigert Passwort-
        und Zahlungskartenfelder.
      </p>
    </div>
    <div class="cta">
      <a class="quiet" href={`${spec}#114-browser-extension-trust-boundary`}>§11.4 Vertrauensgrenze der Browser-Erweiterung</a>
      <a class="quiet" href={`${repo}/blob/main/CHROMEWEBSTORE.md`}>Begründungen der Berechtigungen</a>
      <a class="quiet" href="/de/extension/">Die Seite zur Erweiterung</a>
    </div>
  </Track>

  <Track id="untrusted" no="04" title="Grundsätzlich misstrauisch" heading="Jeder Link ist nicht vertrauenswürdig">
    <p class="lede">
      Künstlerlinks, Weiterleitungen, Antworten von Anbietern und Dateinamen werden als feindliche Eingabe behandelt.
      Diese Schutzmechanismen stehen im Code; jeder verlinkt auf den Teil der Spezifikation, der ihn festhält.
    </p>
    <ul class="guards">
      {
        guards.map(([name, text, source]) => (
          <li>
            <h3>{name}</h3>
            <p>{text}</p>
            <a href={source.href}>{source.label}</a>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="kick" no="05" title="Kick-Puls" heading="Ein Licht, das der Kick folgt, nicht dem Bass">
    <p class="lede">
      Das Licht des Players folgt einem kontinuierlichen Kick-Pegel, der aus dem Audio berechnet wird, bevor es den
      Lautsprecher erreicht, statt Ja-oder-Nein-Entscheidungen über Beats. So kann eine verpasste Entscheidung es nie
      anhalten.
    </p>
    <Loop>Aufgenommen in der echten App mit einem synthetischen Demo-Track. Der für die Aufnahme genutzte Software-Renderer zeichnet kein GPU-Glühen, das echte Licht ist also stärker.</Loop>
    <div class="movement">
      <h3>Wem das Licht folgt</h3>
      <p class="copy">
        <code>beats.py</code> vergleicht jedes Tieftonband des dekodierten Audios mit seinem eigenen jüngsten Median. So
        werden ein gehaltener Bass, ein Sidechain-Rückgang oder ein Pad zur Referenz, und nur was darüber hinausgeht,
        zählt. Dieser Anstieg wird danach gewichtet, wie sehr er einer Kick ähnelt. Die eigene Kick eines Tracks wird nur
        aus Schlägen gelernt, die in der Tonhöhe abfallen, sodass ein wiederholter Basston nie zur Kick wird
        (<a href={`${spec}#34-audio-preview`}>§3.4 Audiovorschau</a>).
      </p>
    </div>
    <div class="movement">
      <h3>Dem Lautsprecher voraus</h3>
      <p class="copy">
        Der Player dekodiert dem Audiogerät voraus, sodass jeder Pegel existiert, bevor sein Klang zu hören ist, und das
        Fenster liest ihn gegen die Zeit, die tatsächlich den Lautsprecher erreicht, gemessen an dem, was das Gerät
        abgenommen hat. Am 1. Oktober 2026, beim Abspielen eines Tracks ab 60 s auf dem Entwicklungsrechner (PipeWire,
        50-ms-Perioden), lagen die Pegel 184–189 ms vor der Geräteposition, während die gemessene Gerätewarteschlange
        46–71 ms betrug; die Analyse brauchte etwa 0,57 % der Echtzeit.
      </p>
    </div>
    <div class="movement">
      <h3>Die Form des Lichts</h3>
      <p class="copy">
        Das Licht ist analog: Es springt sofort auf den Pegel der Kick und klingt exponentiell ab, wie eine Lampe, sodass
        eine volle Kick vor der nächsten wieder dunkel ist und leisere tiefe Schläge schwächer und kürzer aufleuchten
        (<a href={`${spec}#38-qt-quick-desktop`}>§3.8 Qt-Quick-Desktop</a>). Eine hellere Pastell-Ruhefarbe ließ eine Kick
        früher wirken, als ginge das Licht aus; in den am 1. Oktober 2026 gemessenen gesättigten Farben ist das Neon 2,1-
        bis 2,2-mal so hell wie die Ruhefarbe.
      </p>
    </div>
    <div class="movement">
      <h3>Im echten Fenster geprüft</h3>
      <p class="copy">
        Die Offline-Messungen sagten, zwei gemeldete Tracks seien in Ordnung, also lief am 1. Oktober 2026 der echte Stack
        (Fenster, Bridge, Backend, Player und Audiogerät; stumm, offscreen, mit isoliertem Anwendungszustand), wobei Licht,
        Uhr und Pegel des Fensters bei jedem Frame protokolliert wurden. Dabei kamen zwei Fehler außerhalb der Analyse
        heraus. Pegel zwischen 0 und 1 waren numpy-Floats, die Qt an QML als undurchsichtige Objekte statt als Zahlen
        übergibt, sodass nur Pegel von genau 0 und 1 überhaupt etwas aufleuchten ließen; Pegel sind jetzt einfache Floats.
        Und nach einem Start nahm das Gerät seine ersten 50 ms auf einmal und die nächsten erst später, sodass die gehörte
        Zeit auf die übergebene Position begrenzt wurde und etwa 70 ms zu früh in 50-ms-Schritten lief; die Warteschlange
        wird jetzt nie kürzer angesetzt als das, was der letzte Callback übergeben hat.
      </p>
      <div class="table">
        <table>
          <caption>Kalipo – Captain, 45–105 s, live im echten Fenster, 1. Oktober 2026</caption>
          <thead>
            <tr><th scope="col">Messgröße</th><th scope="col">Vorher</th><th scope="col">Nachher</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Kicks unter 0,3 Helligkeit</th><td>20 von 114</td><td>0</td></tr>
            <tr><th scope="row">Schwächste Kick</th><td>0,00</td><td>0,95</td></tr>
            <tr><th scope="row">Frames, in denen die Uhr auf der Snapshot-Position hing</th><td>54 %</td><td>0 %</td></tr>
            <tr><th scope="row">Sprünge über 20 ms in der gehörten Zeit</th><td>1199</td><td>0</td></tr>
          </tbody>
        </table>
      </div>
      <p class="copy">
        Auf einem zweiten Track nach dem Fix hatten 62 Kicks eine mittlere Helligkeit (Median) von 0,94, keine lag unter 0,3,
        bei 63 Frames pro Sekunde im Fenster und keiner Frame-Lücke über 28 ms.
      </p>
    </div>
    <p><a class="quiet" href={validation}>Zu den Validierungsnotizen</a></p>
  </Track>

  <Track id="releases" no="06" title="Tests und Releases" heading="Vom Commit zum Installer">
    <p class="lede">
      {workflows} Workflow-Dateien bringen eine Änderung vom Commit zu den Installern und in die Stores. Jeder Schritt
      unten ist das, was der Workflow ausführt, so wie die Spezifikation es festhält.
    </p>
    <ol class="steps">
      <li>
        <span class="no">01</span>
        <h3>Offline-Suite</h3>
        <p>
          {count.format(testFunctions)} Testfunktionen in <code>tests/</code>. Standardmäßig sind die Live-Marker
          ausgeschlossen, eine Autouse-Fixture verlegt Konfiguration, Anmeldung, Datenbank und Scan-Ordner in ein
          temporäres Verzeichnis, und der Standard-HTTP-Transport ist blockiert, sodass kein Test einen Live-Endpunkt,
          Nutzerdaten oder Musikordner erreicht. Die CI führt sie bei jedem Push und Pull Request auf {join(ciOs)} mit Python {join(ciPython)} aus ({ciOs.length * ciPython.length} Jobs),
          nach der Prüfung der Spezifikations-Übersicht und Ruff, und baut und prüft in jedem Job eine isolierte Wheel-Installation.
        </p>
      </li>
      <li>
        <span class="no">02</span>
        <h3>Live-Vertragsprüfungen</h3>
        <p>
          Ein wöchentlicher Workflow führt die separat markierte Live-Suite gegen die SoundCloud-API aus: Ermittlung der
          Client-ID, lange Sammlungen, Hydration, Verfügbarkeit von Medien und Socket-Dekodierung. Er ist ein Monitor, keine
          Hürde für Releases. Shop- und Gate-Prüfungen laufen von Hand: öffentliche Shop-Seiten, über die Erweiterung
          gelesen, ohne Anmeldung und ohne einen Warenkorb anzufassen, und eine reine GET-Inspektion der Gates.
        </p>
      </li>
      <li>
        <span class="no">03</span>
        <h3>Installer</h3>
        <p>
          Desktop-Verträge und ein isolierter Start laufen unter Linux, Windows und macOS. Dann baut die CI den Windows-x64-
          Installer und native macOS-Disk-Images für arm64 und x86_64, prüft bei jedem die mitgelieferte Laufzeit und die
          Installation und lädt jedes als Test-Artefakt mit einer SHA-256-Datei daneben hoch. Es sind unsignierte
          Vorschauen; Tests auf physischen Geräten bleiben davon getrennt.
        </p>
      </li>
      <li>
        <span class="no">04</span>
        <h3>Veröffentlichung</h3>
        <p>
          Ein veröffentlichtes stabiles Release führt seine eigene Testmatrix aus und lädt dann per Trusted Publishing
          (OIDC) zu PyPI hoch; nur dieser Job darf ein Identitätstoken anfordern, und Actions von Drittanbietern sind auf
          Commits festgelegt. Dasselbe Release paketiert die Erweiterung und reicht sie über dessen API beim Chrome Web
          Store ein, authentifiziert als Dienstkonto. Vorabversionen überspringen beides.
        </p>
      </li>
    </ol>
    <div class="cta">
      <a class="quiet" href={`${spec}#14-verification-ci-and-release`}>§14 Verifikation, CI und Release</a>
      <a class="quiet" href={workflowsUrl}>Die Workflows</a>
    </div>
  </Track>

  <Track id="website" no="07" title="Diese Website" heading="Diese Website">
    <p class="lede">Das Kolophon. Die Zahlen werden beim Bauen der Website gezählt.</p>
    <dl class="spec">
      <dt>Stack</dt>
      <dd>Statische Astro-Seiten und einfaches CSS. Kein UI-Framework und keine Laufzeitabhängigkeiten: Astro läuft nur beim Build.</dd>
      <dt>Die Platte</dt>
      <dd>
        Inline-SVG aus demselben geseedeten Generator wie das App-Icon (<code>scripts/app_icon.py</code>). Scroll-gesteuerte
        CSS-Animationen drehen sie und bewegen den Tonarm; wo sie fehlen, springt ein kleines Skript ein.
      </dd>
      <dt>Skriptgewicht</dt>
      <dd>
        {scriptKb} kB für das Skript der Platte (<code>deck.js</code> und <code>geometry.js</code>): Quelltext, vor
        Minifizierung und Kompression.
      </dd>
