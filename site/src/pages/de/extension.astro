---
import Base from "../../layouts/Base.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import Icon from "../../components/Icon.astro";
import DataFlow from "../../components/extension/DataFlow.astro";
import panel from "../../assets/screenshots/extension-panel.png";
import { chromeStore } from "../../../site.config.mjs";

const description =
  "Erweiterung für Chrome, Edge und Brave: schließt Download-Gates bei Hypeddit und ToneDen ab und füllt deine Warenkörbe bei Bandcamp und Beatport. Bezahlen bleibt bei dir.";

// The five jobs of extension 1.4.4 (dj-digger 1.6.0).
const jobs = [
  ["lock-key-open", "Download-Gates", "Schließt die Hypeddit- und ToneDen-Gates ab, die die App allein nicht schafft. Die Datei geht an die App."],
  ["shopping-cart", "Shop-Warenkörbe", "Legt deine Auswahl in deine Bandcamp- und Beatport-Warenkörbe. Sie geht nie zur Kasse und bezahlt nie."],
  ["sign-in", "SoundCloud-Anmeldung", "Meldet die App mit der SoundCloud-Sitzung an, die dein Browser schon hat."],
  ["play-circle", "Player in deiner Symbolleiste", "Spielen, pausieren, überspringen und spulen im Track der App, ihren laufenden Auftrag verfolgen, antworten, wenn Gates dich brauchen."],
  ["soundcloud-logo", "Import von SoundCloud", "Schick eine Playlist, einen Track oder ein Profil an die App: aus dem Panel, dem Rechtsklickmenü oder mit der Schaltfläche „Import to DJ digger“."],
];
---

<Base title="Browser-Erweiterung für Download-Gates und Warenkörbe · dj-digger" description={description} label="extension">
  <Track hero sub id="overview" title="Die Browser-Erweiterung">
    <Fragment slot="heading">Die Browser-<span class="grad">Erweiterung</span></Fragment>
    <p class="lede">
      Die Hände der Desktop-App in dem Browser, den du schon nutzt. Sie arbeitet, während dj-digger auf demselben
      Computer läuft.
    </p>
    <div class="cta">
      <a class="button primary" href={chromeStore}><Icon name="google-chrome-logo" />Im Chrome Web Store hinzufügen</a>
    </div>
    <div class="panel">
      <Shot
        src={panel}
        alt="Das dj-digger-Panel in der Symbolleiste spielt Drift Away von JMHBM: eine Platte auf dem Cover, eine Fortschrittsleiste bei 1:25 von 3:01 und die Tasten für zurück, Pause und weiter."
        sizes="(min-width: 44rem) 17rem, 20rem"
        eager
      />
    </div>
  </Track>

  <Track id="does" title="Was sie tut">
    <ul class="cards">
      {
        jobs.map(([icon, name, text]) => (
          <li class="card">
            <h3><Icon name={icon} />{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="browsers" title="Unterstützte Browser">
    <p class="lede">Chrome, Edge und Brave. Edge fragt, ob Erweiterungen aus anderen Stores erlaubt werden sollen.</p>
    <p class="copy">Als Flatpak oder Snap installierte Browser können die Verbindung zur App nicht starten.</p>
  </Track>

  <Track id="data" title="Wohin deine Daten gehen">
    <div class="split">
      <DataFlow />
      <p class="copy">
        Die Erweiterung spricht nur mit der dj-digger-App auf deinem Computer. An den Entwickler wird nichts gesendet:
        keine Analyse-Tools, keine Werbung. Sie speichert nur Sitzungsdaten, die beim Schließen des Browsers gelöscht
        werden.
      </p>
    </div>
  </Track>

  <Track id="end" title="Fang mit der App an">
    <p class="copy">Die Erweiterung wartet auf die Desktop-App. Installiere sie und starte sie einmal.</p>
    <div class="cta">
      <a class="button primary" href="/de/download/"><Icon name="download-simple" />Die Desktop-App holen</a>
    </div>
  </Track>
</Base>

<style>
  /* Hero: the portrait panel at phone width beside the text, under it on narrow columns. */
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 44rem) {
    :global(#overview) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 34%, 17rem);
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    :global(#overview) > :global(*) {
      grid-column: 1;
      align-self: start;
    }
    :global(#overview) > .panel {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      max-width: none;
    }
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card h3 :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
</style>
