---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Shot from "../../components/Shot.astro";
import Track from "../../components/Track.astro";
import collect from "../../assets/screenshots/de/crops/collect.png";
import decisions from "../../assets/screenshots/de/crops/decisions.png";
import panelJob from "../../assets/screenshots/extension-panel-job.png";
import libraryWindow from "../../assets/screenshots/de/desktop-local-library.png";
import playerWindow from "../../assets/screenshots/de/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/de/desktop-crates-decisions.png";
import { version } from "../../../site.config.mjs";

const description =
  "Kostenlose Open-Source-App für DJs: Importiere SoundCloud-Playlists und Likes, hör sie vor und kauf jeden Track bei Bandcamp oder Beatport oder hol ihn übers Download-Gate.";
const loop = [
  {
    name: "Sammeln",
    text: "Füge einen Link zu einer Playlist, deinen Likes oder einem Profil ein. Die ganze Liste kommt an, nicht nur die Zeilen, die eine Seite geladen hat.",
    src: collect,
    full: playerWindow,
    alt: "Das dj-digger-Fenster: die Playlist Late Night Selects in der Seitenleiste geöffnet, der Player auf Drift Away von JMHBM bei 1:21 von 3:01 mit seiner Wellenform, Shop-Filter wie Bandcamp 4 und Beatport 3 und die ersten Zeilen der Tracktabelle.",
  },
  {
    name: "Entscheiden",
    text: "Markiere Tracks als vorhanden oder übersprungen. Die Entscheidung folgt dem Track in jede Playlist, in der er vorkommt.",
    src: decisions,
    full: decisionsWindow,
    alt: "Die Tracktabelle mit geöffnetem Statusfilter: Zeilen mit „Habe ich“, „Gespielt“, „Geöffnet“ und „Neu“ und ein Menü mit „Alle Status“, „Unerledigt“, „Neu“, „Geöffnet“, „Vorhanden“ und „Übersprungen“.",
  },
  {
    name: "Kaufen oder laden",
    text: "Ab hier erledigt die Browser-Erweiterung den Rest, in deinem eigenen Browser: Sie löst Download-Gates und füllt deine Shop-Warenkörbe. Den Checkout machst du selbst.",
    src: panelJob,
    alt: "Das Panel der dj-digger-Browser-Erweiterung: Drift Away von JMHBM bei 1:27 von 3:01, die Transporttasten und darunter „Adding to store carts“ mit einer Schaltfläche „Cancel“.",
  },
];
---

<Base title="dj-digger: kostenlose SoundCloud-App fürs Crate Digging" description={description}>
  <section class="hero" id="start" aria-labelledby="start-title">
    <h1 id="start-title">Von der SoundCloud-Playlist zu <span class="grad">Dateien auf deinen Decks</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> ist eine kostenlose Open-Source-App für DJs. Sie sammelt ganze SoundCloud-Playlists, merkt sich deine Entscheidungen und findet für jeden Track einen Weg zum Kauf oder Download.
    </p>
    <div class="cta">
      <a class="button primary" href="/de/download/"><Icon name="download-simple" />Download</a>
    </div>
    <ul class="facts">
      <li>Kostenlos und Open Source</li>
      <li>Windows, macOS, Linux</li>
      <li>Kein Konto, kein Backend</li>
    </ul>
    <Loop eager />
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the three steps
      one at a time. Everywhere else, and without the CSS below, three stacked steps. */}
  <section id="loop" class="loop" aria-labelledby="loop-title">
    <div class="stage stack">
      <h2 id="loop-title">Ein Loop, von Anfang bis Ende</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step) => (
            <li class="movement">
              <div class="text">
                <h3>{step.name}</h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" title="Die Desktop-App">
    <Shot
      src={libraryWindow}
      alt="Das dj-digger-Hauptfenster mit dem lokalen Ordner Digging 2026: der Player auf Drift Away von JMHBM bei 1:27 von 3:01 und sieben Tracks mit BPM-Chips von 120 bis 130 und Tonarten wie 9A, 8A und 5A."
    />
    <ul class="ticks">
      <li>Weiß, was du schon hast</li>
      <li>Schätzt BPM und Tonart</li>
      <li>Exportiert für deine Decks</li>
    </ul>
    <div class="cta"><a class="button" href="/de/app/"><Icon name="desktop" />Die App ansehen</a></div>
  </Track>

  <Track id="extension" title="Die Browser-Erweiterung">
    <p class="copy">
      In deinem eigenen Chrome, Edge oder Brave löst sie Download-Gates, füllt deine Shop-Warenkörbe und holt den
      Player in die Symbolleiste.
    </p>
    <div class="cta"><a class="button" href="/de/extension/"><Icon name="puzzle-piece" />Die Erweiterung ansehen</a></div>
  </Track>

  <Track id="trust" title="Deins, und ehrlich" heading="Deins, und ehrlich zu seinen Grenzen">
    <ul class="ticks">
      <li>Deine Playlists und Entscheidungen bleiben auf deinem Computer.</li>
      <li>Es bezahlt nie für dich und geht nie für dich zur Kasse.</li>
      <li>Es rät nie: Ein unklarer Treffer hält an und wird gemeldet.</li>
    </ul>
  </Track>

  <Track id="get" title="Download" heading="dj-digger herunterladen">
    <p class="copy">dj-digger {version}, kostenlos für Windows, macOS und Linux.</p>
    <div class="cta"><a class="button primary" href="/de/download/"><Icon name="download-simple" />Download</a></div>
  </Track>
</Base>

<style>
  /* ---------- the loop: three stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each shot keeps its own shape; the frame sits on the image so it hugs narrow and wide shots alike.
     --ar is the image's width / height, so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 2.3623;
  }
  .steps > li:nth-child(2) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(3) {
    --ar: 0.6413;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 320svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All three share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      /* The whole image fits the stage: as wide as the column allows, never taller than the cell. */
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
        max-height: calc(100cqh - 2px);
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 33.333%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 33.333% contain 66.667%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 66.667% contain 100%;
      }
    }
  }
  /* Full opacity over 90% of a step's range; the hand-over is a short cross-fade.
     z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    5%,
    95% {
      color: var(--fg);
    }
  }
</style>
