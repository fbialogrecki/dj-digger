---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Shot from "../../components/Shot.astro";
import Track from "../../components/Track.astro";
import collect from "../../assets/screenshots/es/crops/collect.png";
import decisions from "../../assets/screenshots/es/crops/decisions.png";
import panelJob from "../../assets/screenshots/extension-panel-job.png";
import libraryWindow from "../../assets/screenshots/es/desktop-local-library.png";
import playerWindow from "../../assets/screenshots/es/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/es/desktop-crates-decisions.png";
import { version } from "../../../site.config.mjs";

const description =
  "Una app de crate digging para DJs que trabaja en local: convierte playlists, likes y perfiles de SoundCloud en una biblioteca que puedes escuchar y luego encuentra la forma más segura de descargar o comprar cada pista.";
const loop = [
  {
    name: "Recopilar",
    text: "Pega un enlace de una playlist, likes o un perfil. Llega la lista completa, no solo las filas que mostró una página.",
    src: collect,
    full: playerWindow,
    alt: "La ventana de dj-digger: la playlist Late Night Selects abierta en la barra lateral, el reproductor en Drift Away de JMHBM en 1:21 de 3:01 con su forma de onda, píldoras de tiendas como Bandcamp 4 y Beatport 3, y las primeras filas de la tabla de pistas.",
  },
  {
    name: "Decidir",
    text: "Marca pistas como conseguidas u omitidas. La decisión acompaña a la pista en todas las playlists en las que aparece.",
    src: decisions,
    full: decisionsWindow,
    alt: "La tabla de pistas con el filtro de estado abierto: filas marcadas La tengo, Reproducida, Abierta y Nueva, y un menú con Todos los estados, Sin gestionar, Nueva, Abiertas, Conseguidas y Omitidas.",
  },
  {
    name: "Comprar o descargar",
    text: "A partir de aquí, la extensión del navegador hace el resto en tu propio navegador: resuelve los gates de descarga y llena tus carritos. El pago sigue siendo cosa tuya.",
    src: panelJob,
    alt: "El panel de la extensión dj-digger: Drift Away de JMHBM en 1:27 de 3:01, los botones de transporte y, debajo, «Adding to store carts» con un botón Cancel.",
  },
];
---

<Base title="dj-digger: crate digging para DJs" description={description}>
  <section class="hero" id="start" aria-labelledby="start-title">
    <h1 id="start-title">De una playlist de SoundCloud a <span class="grad">archivos en tus decks</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> recopila playlists completas, recuerda lo que decidiste y encuentra la forma de comprar
      o descargar cada pista.
    </p>
    <div class="cta">
      <a class="button primary" href="/es/download/"><Icon name="download-simple" />Descargar</a>
    </div>
    <ul class="facts">
      <li>Gratis y de código abierto</li>
      <li>Windows, macOS, Linux</li>
      <li>Sin cuenta, sin servidor</li>
    </ul>
    <Loop eager />
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the three steps
      one at a time. Everywhere else, and without the CSS below, three stacked steps. */}
  <section id="loop" class="loop" aria-labelledby="loop-title">
    <div class="stage stack">
      <h2 id="loop-title">Un solo ciclo, de principio a fin</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step) => (
            <li class="movement">
              <div class="text">
                <h3>{step.name}</h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" title="La app de escritorio">
    <Shot
      src={libraryWindow}
      alt="La ventana principal de dj-digger en una carpeta local, Digging 2026: el reproductor en Drift Away de JMHBM en 1:27 de 3:01, y siete pistas con chips de BPM de 120 a 130 y tonalidades como 9A, 8A y 5A."
    />
    <ul class="ticks">
      <li>Sabe lo que ya tienes</li>
      <li>Estima el BPM y la tonalidad</li>
      <li>Exporta para tus decks</li>
    </ul>
    <div class="cta"><a class="button" href="/es/app/"><Icon name="desktop" />Descubre la app</a></div>
  </Track>

  <Track id="extension" title="La extensión del navegador">
    <p class="copy">
      En tu propio Chrome, Edge o Brave resuelve los gates de descarga, llena tus carritos y pone el reproductor en la
      barra de herramientas.
    </p>
    <div class="cta"><a class="button" href="/es/extension/"><Icon name="puzzle-piece" />Descubre la extensión</a></div>
  </Track>

  <Track id="trust" title="Tuyo, y honesto" heading="Tuyo, y honesto con sus límites">
    <ul class="ticks">
      <li>Tus playlists y decisiones se quedan en tu equipo.</li>
      <li>Nunca paga ni finaliza la compra por ti.</li>
      <li>Nunca adivina: una coincidencia dudosa se detiene y se informa.</li>
    </ul>
  </Track>

  <Track id="get" title="Descargar" heading="Ponla a sonar">
    <p class="copy">dj-digger {version}, gratis para Windows, macOS y Linux.</p>
    <div class="cta"><a class="button primary" href="/es/download/"><Icon name="download-simple" />Descargar</a></div>
  </Track>
</Base>

<style>
  /* ---------- the loop: three stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each shot keeps its own shape; the frame sits on the image so it hugs narrow and wide shots alike.
     --ar is the image's width / height, so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 2.3623;
  }
  .steps > li:nth-child(2) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(3) {
    --ar: 0.6413;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 320svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All three share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      /* The whole image fits the stage: as wide as the column allows, never taller than the cell. */
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
        max-height: calc(100cqh - 2px);
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 33.333%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 33.333% contain 66.667%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 66.667% contain 100%;
      }
    }
  }
  /* Full opacity over 90% of a step's range; the hand-over is a short cross-fade.
     z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    5%,
    95% {
      color: var(--fg);
    }
  }
</style>
