---
import Base from "../../layouts/Base.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import Icon from "../../components/Icon.astro";
import DataFlow from "../../components/extension/DataFlow.astro";
import panel from "../../assets/screenshots/extension-panel.png";
import { chromeStore } from "../../../site.config.mjs";

const description =
  "Extensión para Chrome, Edge y Brave: completa los gates de descarga de Hypeddit y ToneDen y llena tus carritos de Bandcamp y Beatport. El pago sigue siendo cosa tuya.";

// The five jobs of extension 1.4.4 (dj-digger 1.6.0).
const jobs = [
  ["lock-key-open", "Gates de descarga", "Completa los gates de Hypeddit y ToneDen que la app no puede terminar sola. El archivo va a la app."],
  ["shopping-cart", "Carritos de tiendas", "Añade lo que eliges a tus carritos de Bandcamp y Beatport. Nunca finaliza la compra ni paga."],
  ["sign-in", "Inicio de sesión en SoundCloud", "Inicia la sesión de la app con la sesión de SoundCloud que ya tiene tu navegador."],
  ["play-circle", "Reproductor en tu barra de herramientas", "Reproduce, pausa, salta y busca en la pista de la app, sigue su tarea en curso y responde cuando los gates te necesitan."],
  ["soundcloud-logo", "Importar desde SoundCloud", "Envía una playlist, una pista o un perfil a la app desde el panel, el menú contextual o el botón «Import to DJ digger»."],
];
---

<Base title="Extensión para gates de descarga y carritos · dj-digger" description={description} label="extension">
  <Track hero sub id="overview" title="La extensión del navegador">
    <Fragment slot="heading">La <span class="grad">extensión</span> del navegador</Fragment>
    <p class="lede">
      Las manos de la app de escritorio en el navegador que ya usas. Funciona mientras dj-digger está abierto en el
      mismo equipo.
    </p>
    <div class="cta">
      <a class="button primary" href={chromeStore}><Icon name="google-chrome-logo" />Añadir desde Chrome Web Store</a>
    </div>
    <div class="panel">
      <Shot
        src={panel}
        alt="El panel de dj-digger en la barra de herramientas reproduciendo Drift Away de JMHBM: un disco en la portada, una barra de progreso en 1:25 de 3:01 y los botones anterior, pausa y siguiente."
        sizes="(min-width: 44rem) 17rem, 20rem"
        eager
      />
    </div>
  </Track>

  <Track id="does" title="Qué hace">
    <ul class="cards">
      {
        jobs.map(([icon, name, text]) => (
          <li class="card">
            <h3><Icon name={icon} />{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="browsers" title="Navegadores compatibles">
    <p class="lede">Chrome, Edge y Brave. Edge pide permitir extensiones de otras tiendas.</p>
    <p class="copy">Los navegadores instalados como Flatpak o Snap no pueden iniciar el enlace con la app.</p>
  </Track>

  <Track id="data" title="Adónde van tus datos">
    <div class="split">
      <DataFlow />
      <p class="copy">
        La extensión solo se comunica con la app dj-digger de tu equipo. No se envía nada al desarrollador: ni
        analíticas ni anuncios. Solo guarda datos de sesión, que se borran al cerrar el navegador.
      </p>
    </div>
  </Track>

  <Track id="end" title="Empieza por la app">
    <p class="copy">La extensión espera a la app de escritorio. Instálala y ábrela una vez.</p>
    <div class="cta">
      <a class="button primary" href="/es/download/"><Icon name="download-simple" />Consigue la app de escritorio</a>
    </div>
  </Track>
</Base>

<style>
  /* Hero: the portrait panel at phone width beside the text, under it on narrow columns. */
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 44rem) {
    :global(#overview) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 34%, 17rem);
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    :global(#overview) > :global(*) {
      grid-column: 1;
      align-self: start;
    }
    :global(#overview) > .panel {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      max-width: none;
    }
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card h3 :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
</style>
