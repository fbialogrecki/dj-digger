---
import { readdirSync, readFileSync, statSync } from "node:fs";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import { author, repo } from "../../../site.config.mjs";

const description =
  "Cómo está hecho dj-digger: arquitectura, el límite de confianza de la extensión del navegador, las protecciones frente a entradas no confiables, la luz del bombo y su validación, pruebas y versiones, y este sitio web.";
const tracks = [
  { id: "notes", no: "01", title: "Notas del disco" },
  { id: "architecture", no: "02", title: "Arquitectura" },
  { id: "browser", no: "03", title: "El límite del navegador" },
  { id: "untrusted", no: "04", title: "No confiable por defecto" },
  { id: "kick", no: "05", title: "El pulso del bombo" },
  { id: "releases", no: "06", title: "Pruebas y versiones" },
  { id: "website", no: "07", title: "Este sitio web" },
  { id: "credits", no: "08", title: "Créditos y fuentes" },
];

// Figures are counted from the repository at build time, never typed.
// Paths are relative to the working directory (npm runs in site/), as in site.config.mjs.
const testFunctions = readdirSync("../tests", { recursive: true })
  .filter((file) => String(file).endsWith(".py"))
  .reduce((sum, file) => sum + (readFileSync(`../tests/${file}`, "utf8").match(/def test_/g) ?? []).length, 0);
const workflows = readdirSync("../.github/workflows").filter((file) => /\.ya?ml$/.test(file)).length;
const ci = readFileSync("../.github/workflows/ci.yml", "utf8");
const list = (key) => {
  const found = new RegExp(`^\\s*${key}:\\s*\\[([^\\]]+)\\]`, "m").exec(ci);
  if (!found) throw new Error(`ci.yml: no ${key} matrix`); // fail the build rather than print a wrong figure
  return found[1].split(",").map((item) => item.trim().replace(/^["']|["']$/g, ""));
};
const osName = { "ubuntu-latest": "Ubuntu", "macos-latest": "macOS", "windows-latest": "Windows" };
const ciOs = list("os").map((os) => osName[os] ?? os);
const ciPython = list("python-version");
const scriptBytes = statSync("src/scripts/deck.js").size + statSync("src/scripts/geometry.js").size;
const scriptKb = (scriptBytes / 1000).toFixed(1).replace(".", ",");
const count = new Intl.NumberFormat("es");
const join = (items) => (items.length > 1 ? `${items.slice(0, -1).join(", ")} y ${items.at(-1)}` : items[0]);

const spec = `${repo}/blob/main/PROJECT_SPECIFICATION.md`;
const guide = `${repo}/blob/main/docs/architecture.md`;
const validation = `${repo}/blob/main/docs/kick-pulse-validation.md`;
const workflowsUrl = `${repo}/tree/main/.github/workflows`;
// Anchors are GitHub's slugs of the specification's headings (github-slugger).
const section = {
  urls: { href: `${spec}#111-untrusted-urls-and-ssrf-boundary`, label: "§11.1 URL no confiables y límite SSRF" },
  secrets: { href: `${spec}#112-secret-and-personal-data-handling`, label: "§11.2 Tratamiento de secretos y datos personales" },
  files: { href: `${spec}#113-file-and-mutation-safety`, label: "§11.3 Seguridad de archivos y modificaciones" },
};

const guards = [
  ["Esquemas de URL", "Los campos de las pistas, las descripciones, los archivos de resumen, las redirecciones y las respuestas de los gates no son de confianza, y al navegador solo se le pasan URL HTTP(S) con host.", section.urls],
  ["Límites de dominio", "Las comprobaciones de pertenencia a una tienda o a SoundCloud exigen el host exacto o un límite de subdominio, nunca una subcadena, así que un host de aspecto parecido no es una tienda.", section.urls],
  ["Protección SSRF", "Antes de cualquier petición automática se rechazan las credenciales en la URL, los nombres localhost y las direcciones IP literales no globales, y cada redirección validada tiene un límite; los nombres DNS no se resuelven antes, una limitación que la especificación indica.", section.urls],
  ["Límites de descarga", "Los tamaños declarados y observados tienen un tope de 2 GiB, los cuerpos HTML se rechazan y los nombres de archivo se reducen a su nombre base, con los caracteres no válidos sustituidos y un prefijo ante los nombres reservados de Windows.", section.files],
  ["Sustitución atómica", "Las descargas HTTP y del navegador se escriben en archivos temporales y se publican con un renombrado atómico bajo un bloqueo de nombre compartido, y los archivos parciales se eliminan si algo falla o se cancela.", section.files],
  ["Revalidación del carrito", "Las escrituras en el carrito de una tienda exigen una comprobación previa del artículo exacto y una revalidación inmediata, y las escrituras de red que podrían duplicar un cambio en otro sitio no se reintentan automáticamente.", section.files],
  ["Secretos", "Las contraseñas solo se escriben en las páginas del propio proveedor, la sesión de SoundCloud guarda solo el oauth_token verificado en el llavero del sistema, los archivos de token se escriben como privados antes de una sustitución atómica y los registros de la CLI ocultan las consultas de las URL y los campos de credenciales.", section.secrets],
];

// The architecture diagram: boxes in the SVG's own units (320 wide), drawn in a column that holds at 328px.
const LINE = 13;
const box = (x, y, w, h, lines, kind = "") => ({ x, y, w, h, lines, kind });
const nodes = [
  box(1, 18, 154, 36, ["CLI"], "ctl"),
  box(165, 18, 154, 36, ["Escritorio Qt Quick"], "ctl"),
  box(1, 82, 318, 46, ["ApplicationServices", "diferido: no importa Qt ni abre nada hasta usarse"], "named"),
  box(1, 154, 110, 62, ["Servicios de", "recopilación,", "descarga, compra", "y cuenta"]),
  box(119, 154, 96, 62, ["Servicio de", "biblioteca"]),
  box(223, 154, 96, 62, ["Servicio de", "reproducción"]),
  box(1, 242, 110, 50, ["Adaptadores", "de SoundCloud,", "gates y tiendas"]),
  box(119, 242, 96, 50, ["Repositorios"]),
  box(223, 242, 96, 50, ["Motor de audio", "en memoria"]),
  box(119, 318, 96, 44, ["Hilo dueño", "de SQLite"], "owner"),
  box(1, 378, 318, 58, ["OperationCoordinator", "una ranura principal y una de escaneo: admite", "trabajo y sigue la cancelación hasta que acaba"], "named coord"),
];
const wires = [[78, 54, 80], [242, 54, 80], [56, 128, 152], [167, 128, 152], [271, 128, 152], [56, 216, 240], [167, 216, 240], [271, 216, 240], [167, 292, 316]];
const baseline = (node, i) => node.y + node.h / 2 - ((node.lines.length - 1) * LINE) / 2 + 4 + i * LINE;
---

<Base title="Notas del disco: cómo está hecho dj-digger" description={description} label="notes" tracks={tracks}>
  <Track id="notes" no="01" title="Notas del disco" hero sub>
    <Fragment slot="heading">Notas del disco: <span class="grad">cómo está hecho dj-digger</span></Fragment>
    <p class="lede">
      El reverso de la funda: cómo está montada la app, dónde traza sus límites y cómo se comprueba. Cada afirmación de
      esta página enlaza al documento o archivo del que procede.
    </p>
    <p class="copy">
      Escrito, producido y prensado por <a href={author.url}>{author.name}</a>.
    </p>
    <ul class="facts">
      <li>Python 3.12+</li>
      <li>Qt Quick</li>
      <li>Extensión Manifest V3</li>
      <li>SQLite</li>
      <li>Sin servidor de dj-digger</li>
    </ul>
  </Track>

  <Track id="architecture" no="02" title="Arquitectura" heading="Los controladores presentan, los servicios se encargan de los efectos">
    <p class="lede">
      La CLI y el escritorio Qt son controladores sobre los mismos servicios de la aplicación. Los controladores se
      encargan de la presentación; los servicios, de los efectos completados y del ciclo de vida de los recursos; un
      coordinador admite el trabajo y sigue la cancelación hasta que terminan los workers.
    </p>
    <figure class="diagram">
      <svg class="arch" viewBox="0 0 320 438" role="img" aria-labelledby="arch-title arch-desc">
        <title id="arch-title">Cómo se compone dj-digger</title>
        <desc id="arch-desc">
          La CLI y el escritorio Qt Quick son controladores sobre ApplicationServices, que compone los servicios de la
          aplicación de forma diferida y no importa Qt. Los servicios de recopilación, descarga, compra y cuenta usan los
          adaptadores de SoundCloud, gates y tiendas. El servicio de biblioteca trabaja mediante repositorios en el hilo
          dueño de SQLite. El servicio de reproducción controla el motor de audio en memoria. El OperationCoordinator, con
          una ranura principal y una de escaneo, admite el trabajo y sigue la cancelación hasta que terminan los workers.
        </desc>
        <defs>
          <marker id="arch-tip" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path class="tip" d="M0 0L8 4L0 8z"></path>
          </marker>
        </defs>
        <text class="group" x="1" y="10">CONTROLADORES</text>
        {wires.map(([x, from, to]) => <path class="wire" d={`M${x} ${from}V${to}`} marker-end="url(#arch-tip)" />)}
        {
          nodes.map((node) => (
            <g class={node.kind}>
              <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
              {node.lines.map((line, i) => (
                <text x={node.x + node.w / 2} y={baseline(node, i)} class={node.kind.includes("named") && i > 0 ? "sub" : undefined}>
                  {line}
                </text>
              ))}
            </g>
          ))
        }
      </svg>
    </figure>
    <ul class="ticks rules">
      <li>
        <strong>Nada bloqueante en el hilo de la interfaz.</strong> El backend, el puente de señales de Qt, el modelo de
        la tabla y la ventana QML se reparten la orquestación, las señales, las filas y el renderizado; ninguno hace
        trabajo de red o de disco bloqueante en el hilo de la interfaz, y los resultados se le devuelven
        (<a href={`${guide}#ui-ownership`}>Propiedad de la interfaz</a>).
      </li>
      <li>
        <strong>Un solo hilo es dueño de SQLite.</strong> Las transacciones son explícitas y cortas, dentro de ellas no
        ocurre nada de red, navegador ni diálogos, el estado y la procedencia de los archivos se confirman juntos, y las
        copias en memoria solo cambian después de la confirmación
        (<a href={`${guide}#persistent-effects-and-identity`}>Efectos persistentes e identidad</a>).
      </li>
      <li>
        <strong>La composición no importa Qt.</strong> Construir <code>ApplicationServices</code> no importa Qt ni abre
        ninguna base de datos, dispositivo ni conexión con el navegador; la CLI y el escritorio obtienen de ahí el mismo
        servicio de recopilación diferido (<a href={`${guide}#composition-and-execution`}>Composición y ejecución</a>).
      </li>
    </ul>
    <p class="copy">
      La guía también dice lo que el diseño no afirma: no hay fijación de DNS, ni auditoría de seguridad, ni
      transacciones que abarquen a la vez el sistema de archivos y SQLite.
    </p>
    <p><a class="quiet" href={guide}>Lee la guía de arquitectura</a></p>
  </Track>

  <Track id="browser" no="03" title="El límite del navegador" heading="Manejar tu navegador sin adueñarse de él">
    <p class="lede">
      Los gates y los carritos se ejecutan en el navegador real del usuario, con sus sesiones iniciadas, así que la
      extensión impone sus propios límites, mande lo que mande la app de escritorio.
    </p>
    <div class="movement">
      <h3>Un canal, sin código remoto</h3>
      <p class="copy">
        La única entrada de órdenes es el puerto de mensajería nativa de la app en el mismo equipo: el manifiesto no
        tiene <code>externally_connectable</code> ni <code>web_accessible_resources</code>, y ningún script de página
        escucha <code>window.postMessage</code>. No hay <code>eval</code>; las únicas funciones que se ejecutan en una
        página son funciones con nombre, de solo lectura, incluidas en la extensión. Del lado de la app, el directorio del
        socket es privado del usuario y los pares se autentican con una clave guardada en un archivo 0600.
      </p>
    </div>
    <div class="movement">
      <h3>Una lista fija de sitios</h3>
      <p class="copy">
        Un único <code>allowlist.json</code> rige el script en segundo plano, y una prueba lo compara con las listas de
        hosts de Python y con los permisos de host del manifiesto: HTTPS en el puerto por defecto, sin credenciales, a
        Hypeddit, ToneDen, Bandcamp y Beatport, y la página de inicio de sesión de SoundCloud. Cualquier navegación a otro
        sitio se rechaza.
      </p>
    </div>
    <div class="movement">
      <h3>Solo sus propias pestañas</h3>
      <p class="copy">
        Las órdenes actúan sobre las pestañas y ventanas de trabajo que creó la extensión y sobre sus ventanas
        emergentes, nunca sobre las demás pestañas del usuario. Para leer o hacer clic, además, la dirección actual de la
        pestaña tiene que estar en la lista de permitidos; cualquier otra dirección se recorta a
        <code>https://&lt;host&gt;/</code> antes de notificarla, y se eliminan los parámetros de OAuth. Todas las pestañas
        propias están silenciadas.
      </p>
    </div>
    <div class="movement">
      <h3>Un freno en seco antes del dinero</h3>
      <p class="copy">
        Una pestaña propia de Bandcamp o Beatport que navega o es redirigida a una ruta de finalización de compra, de
        pago del carrito, de pago o de facturación se cierra y se notifica. Se rechazan los clics en elementos llamados
        check out, pay, purchase, place order, buy now o complete order, y al rellenar formularios se rechazan los campos
        de contraseña y de tarjeta de pago.
      </p>
    </div>
    <div class="cta">
      <a class="quiet" href={`${spec}#114-browser-extension-trust-boundary`}>§11.4 Límite de confianza de la extensión del navegador</a>
      <a class="quiet" href={`${repo}/blob/main/CHROMEWEBSTORE.md`}>Justificación de los permisos</a>
      <a class="quiet" href="/es/extension/">La página de la extensión</a>
    </div>
  </Track>

  <Track id="untrusted" no="04" title="No confiable por defecto" heading="Ningún enlace es de confianza">
    <p class="lede">
      Los enlaces de artistas, las redirecciones, las respuestas de los proveedores y los nombres de archivo se tratan
      como entradas hostiles. Estas protecciones existen en el código; cada una enlaza a la parte de la especificación
      que la recoge.
    </p>
    <ul class="guards">
      {
        guards.map(([name, text, source]) => (
          <li>
            <h3>{name}</h3>
            <p>{text}</p>
            <a href={source.href}>{source.label}</a>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="kick" no="05" title="El pulso del bombo" heading="Una luz que sigue al bombo, no al bajo">
    <p class="lede">
      La luz del reproductor sigue un nivel continuo de bombo, calculado a partir del audio antes de que llegue al
      altavoz, en lugar de decisiones de sí o no sobre cada golpe, así que una decisión fallida nunca puede detenerla.
    </p>
    <Loop>Grabado en la app real con una pista de demostración sintética. El renderizador por software usado para la captura no dibuja el resplandor de la GPU, así que la luz real es más intensa.</Loop>
    <div class="movement">
      <h3>Lo que sigue la luz</h3>
      <p class="copy">
        <code>beats.py</code> compara cada banda de baja frecuencia del audio decodificado con su propia mediana reciente,
        así que un bajo sostenido, la recuperación de un sidechain o un pad se convierten en la referencia y solo cuenta lo
        que sobresale. Ese aumento se pondera según cuánto se parece a un bombo. El bombo propio de una pista se aprende
        solo de golpes que bajan de tono, así que una nota de bajo repetida nunca llega a serlo
        (<a href={`${spec}#34-audio-preview`}>§3.4 Vista previa de audio</a>).
      </p>
    </div>
    <div class="movement">
      <h3>Por delante del altavoz</h3>
      <p class="copy">
        El reproductor decodifica por delante del dispositivo de audio, así que cada nivel existe antes de que se oiga su
        sonido, y la ventana lo lee frente al tiempo que de verdad llega al altavoz, medido a partir de lo que ha tomado
        el dispositivo. El 1 de octubre de 2026, reproduciendo una pista desde los 60 s en la máquina de desarrollo
        (PipeWire, periodos de 50 ms), los niveles iban 184–189 ms por delante de la posición del dispositivo, mientras
        que la cola medida del dispositivo era de 46–71 ms; el análisis ocupó alrededor del 0,57 % del tiempo real.
      </p>
    </div>
    <div class="movement">
      <h3>La forma de la luz</h3>
      <p class="copy">
        La luz es analógica: salta de inmediato al nivel del bombo y se apaga de forma exponencial, como una lámpara, así
        que un bombo completo vuelve a oscuridad antes del siguiente y los golpes graves más suaves se ven más tenues y
        más breves (<a href={`${spec}#38-qt-quick-desktop`}>§3.8 Escritorio Qt Quick</a>). Un color de reposo pastel más
        claro hacía que un bombo pareciera la luz apagándose; con los colores saturados medidos el 1 de octubre de 2026,
        el neón es entre 2,1 y 2,2 veces más brillante que el reposo.
      </p>
    </div>
    <div class="movement">
      <h3>Comprobado en la ventana real</h3>
      <p class="copy">
        Las mediciones sin conexión decían que dos pistas reportadas estaban bien, así que el 1 de octubre de 2026 se
        ejecutó la pila real (ventana, puente, backend, reproductor y dispositivo de audio; en silencio, fuera de
        pantalla, con un estado de la aplicación aislado) registrando en cada fotograma la luz, el reloj y los niveles de
        la ventana. Encontró dos errores fuera del análisis. Los niveles entre 0 y 1 eran floats de numpy, que Qt pasa a
        QML como objetos opacos, no como números, así que solo encendían algo los niveles de exactamente 0 y 1; ahora los
        niveles son floats normales. Y tras un arranque, el dispositivo tomaba de golpe sus primeros 50 ms y los
        siguientes solo más tarde, así que el tiempo oído quedaba limitado a la posición entregada e iba unos 70 ms
        adelantado, a saltos de 50 ms; ahora la cola nunca se toma como menor que lo que entregó la última llamada.
      </p>
      <div class="table">
        <table>
          <caption>Kalipo – Captain, 45–105 s, en directo en la ventana real, 2026-10-01</caption>
          <thead>
            <tr><th scope="col">Medida</th><th scope="col">Antes</th><th scope="col">Después</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Bombos con brillo inferior a 0,3</th><td>20 de 114</td><td>0</td></tr>
            <tr><th scope="row">Bombo más tenue</th><td>0,00</td><td>0,95</td></tr>
            <tr><th scope="row">Fotogramas con el reloj parado en la posición de la instantánea</th><td>54 %</td><td>0 %</td></tr>
            <tr><th scope="row">Saltos de más de 20 ms en el tiempo oído</th><td>1199</td><td>0</td></tr>
          </tbody>
        </table>
      </div>
      <p class="copy">
        En una segunda pista, tras la corrección, 62 bombos tuvieron un brillo mediano de 0,94 y ninguno bajó de 0,3, con
        la ventana a 63 fotogramas por segundo y ningún hueco entre fotogramas de más de 28 ms.
      </p>
    </div>
    <p><a class="quiet" href={validation}>Lee las notas de validación</a></p>
  </Track>

  <Track id="releases" no="06" title="Pruebas y versiones" heading="Del commit al instalador">
    <p class="lede">
      {workflows} archivos de workflow llevan un cambio desde un commit hasta los instaladores y las tiendas. Cada paso de
      abajo es lo que ejecuta el workflow, tal como lo recoge la especificación.
    </p>
    <ol class="steps">
      <li>
        <span class="no">01</span>
        <h3>Suite sin conexión</h3>
        <p>
          {count.format(testFunctions)} funciones de prueba en <code>tests/</code>. Por defecto se excluyen los marcadores
          live, un fixture autouse traslada la configuración, la autenticación, la base de datos y las carpetas de
          escaneo a un directorio temporal, y el transporte HTTP por defecto está bloqueado, así que ninguna prueba llega
          a un endpoint real, a datos del usuario ni a carpetas de música. La CI la ejecuta en cada push y pull request en
          {" "}{join(ciOs)} con Python {join(ciPython)} ({ciOs.length * ciPython.length} jobs), después de la
          comprobación del mapa de la especificación y de Ruff, y en cada job construye y comprueba la instalación de un
          wheel aislado.
        </p>
      </li>
      <li>
        <span class="no">02</span>
        <h3>Comprobaciones de contrato en vivo</h3>
        <p>
          Un workflow semanal ejecuta contra la API de SoundCloud la suite live, marcada aparte: detección del client ID,
          colecciones largas, hidratación, disponibilidad de medios y decodificación por socket. Es un monitor, no una
          condición para publicar. Las comprobaciones de tiendas y gates se ejecutan a mano: páginas públicas de tiendas
          leídas a través de la extensión sin iniciar sesión ni tocar ningún carrito, e inspección de gates solo con GET.
        </p>
      </li>
      <li>
        <span class="no">03</span>
        <h3>Instaladores</h3>
        <p>
          Los contratos de escritorio y un arranque aislado se ejecutan en Linux, Windows y macOS. Después la CI construye
          el instalador de Windows x64 y las imágenes de disco nativas de macOS arm64 y x86_64, verifica en cada una el
          runtime incluido y la instalación, y sube cada una como artefacto de prueba con un archivo SHA-256 al lado. Son
          versiones preliminares sin firmar; las pruebas en dispositivos físicos van aparte.
        </p>
      </li>
      <li>
        <span class="no">04</span>
        <h3>Publicación</h3>
        <p>
          Una versión estable publicada ejecuta su propia matriz de pruebas y luego se sube a PyPI mediante trusted
          publishing (OIDC); solo ese job puede pedir un token de identidad, y las acciones de terceros están fijadas a
          commits. La misma versión empaqueta la extensión y la envía a la Chrome Web Store mediante su API, autenticada
          como cuenta de servicio. Las versiones previas se saltan ambos pasos.
        </p>
      </li>
    </ol>
    <div class="cta">
      <a class="quiet" href={`${spec}#14-verification-ci-and-release`}>§14 Verificación, CI y publicación</a>
      <a class="quiet" href={workflowsUrl}>Los workflows</a>
    </div>
  </Track>

  <Track id="website" no="07" title="Este sitio web" heading="Este sitio web">
    <p class="lede">El colofón. Las cifras se cuentan al construir el sitio.</p>
    <dl class="spec">
      <dt>Tecnología</dt>
      <dd>Páginas estáticas de Astro y CSS sin más. Sin framework de interfaz y sin dependencias en tiempo de ejecución: Astro solo se ejecuta al construir.</dd>
      <dt>El disco</dt>
      <dd>
        SVG en línea del mismo generador con semilla que el icono de la app (<code>scripts/app_icon.py</code>). Las
        animaciones CSS controladas por el scroll lo hacen girar y mueven el brazo; un pequeño script hace de respaldo
        donde no están disponibles.
      </dd>
      <dt>Peso del script</dt>
      <dd>
        {scriptKb} kB para el script del disco (<code>deck.js</code> y <code>geometry.js</code>): código fuente, antes de
        minificar y comprimir.
      </dd>
      <dt>Peticiones a terceros</dt>
