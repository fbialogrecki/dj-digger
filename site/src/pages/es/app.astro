---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import mainWindow from "../../assets/screenshots/es/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/es/desktop-crates-decisions.png";
import storesWindow from "../../assets/screenshots/es/desktop-store-links.png";
import gatesWindow from "../../assets/screenshots/es/desktop-jobs-gates.png";
import cartWindow from "../../assets/screenshots/es/desktop-cart.png";
import libraryWindow from "../../assets/screenshots/es/desktop-local-library.png";
import exportWindow from "../../assets/screenshots/es/desktop-export.png";
import sidebar from "../../assets/screenshots/es/crops/sidebar.png";
import decisions from "../../assets/screenshots/es/crops/decisions.png";
import stores from "../../assets/screenshots/es/crops/stores.png";
import gates from "../../assets/screenshots/es/crops/gates.png";
import cart from "../../assets/screenshots/es/crops/cart.png";
import library from "../../assets/screenshots/es/crops/library.png";
import exportDialog from "../../assets/screenshots/es/crops/export.png";

const description =
  "Importa playlists, likes y perfiles completos de SoundCloud, escucha con BPM y tonalidad, marca lo que ya tienes, completa gates de Hypeddit y ToneDen y exporta para tus decks.";
---

<Base title="App de escritorio: de playlists de SoundCloud a tu biblioteca DJ · dj-digger" description={description} label="app">
  <Track hero sub id="overview" title="Todo el ciclo">
    <Fragment slot="heading">Todo el ciclo del digging en una sola ventana</Fragment>
    <p class="lede">Cada imagen de esta página es la app real, con datos de demostración.</p>
    <div class="cta">
      <a class="button primary" href="/es/download/"><Icon name="download-simple" />Descargar</a>
    </div>
    <Shot
      src={mainWindow}
      eager
      alt="La ventana principal de dj-digger. Una barra lateral muestra tres playlists de SoundCloud, con Late Night Selects seleccionada, sobre las carpetas Descargas y Música. El reproductor, arriba, muestra Drift Away de JMHBM en 1:21 de 3:01, con una portada de disco generada y una forma de onda magenta. Debajo, un campo de búsqueda, píldoras de tiendas (Bandcamp 4, Beatport 3, Hypeddit 3, Traxsource 1, Juno Download 1), un filtro de estado y una tabla de 14 pistas, cada una con estado, artista, título, género, año, sello, duración y un distintivo de tienda."
    />
  </Track>

  <Track id="collect" title="Recopilar" heading="Playlists completas de SoundCloud, no una página desplazada">
    <div class="beside">
      <div class="beside-grid">
        <div class="stack">
          <p class="lede">La app lee la colección completa a través de la API de SoundCloud.</p>
          <ul class="ticks">
            <li>Playlists y sets, likes, reposts, perfiles de artista y pistas sueltas</li>
            <li>La importación llena la tabla por tandas y se guarda cuando ha llegado todo</li>
            <li>Inicia sesión en SoundCloud para leer tus propias playlists privadas</li>
            <li>Al actualizar una playlist, lo nuevo aparece arriba, marcado como <code>NEW</code></li>
          </ul>
        </div>
        <Shot
          src={sidebar}
          full={libraryWindow}
          sizes="220px"
          alt="La barra lateral: un campo para filtrar playlists y carpetas; tres playlists de SoundCloud, Late Night Selects con 14 pistas, Sunday Balcony con 4 y Warehouse Warmups con 6, y un botón más para añadir otra; debajo, el explorador de Carpetas con Descargas y Música, donde está seleccionada la carpeta Digging 2026, con siete archivos."
        />
      </div>
    </div>
  </Track>

  <Track id="audition" title="Escuchar" heading="Escucha sobre una forma de onda que siente el bombo">
    <p class="lede">Escucha desde SoundCloud, o reproduce el archivo del disco cuando lo tienes.</p>
    <Loop />
    <ul class="ticks">
      <li>Salta a cualquier punto de la forma de onda; la siguiente pista se prepara de antemano</li>
      <li>Con cada bombo se ilumina la parte reproducida de la forma de onda, siguiendo el bombo, no la línea de bajo</li>
      <li>Las escuchas se decodifican en memoria y nunca se guardan en el disco</li>
      <li>Busca, filtra y ordena sin salir de la playlist; <kbd>?</kbd> muestra todos los atajos</li>
      <li>Ver → Animaciones apaga la luz</li>
    </ul>
  </Track>

  <Track id="decide" title="Decidir" heading="Cajas que recuerdan lo que tienes y lo que descartaste">
    <p class="lede">La tengo, omitida, reproducida y abierta: cada pista conserva su estado.</p>
    <Shot
      src={decisions}
      full={decisionsWindow}
      alt="La tabla de pistas con su filtro de estado abierto, que ofrece Todos los estados, Sin gestionar, Nueva, Abiertas, Conseguidas y Omitidas. La columna Estado indica La tengo, La tengo, Reproducida, La tengo, Abierta y Nueva junto a Nightglass, Coral Engine, Sable Fern, Tidewell, Ostra Lumen y Pale Circuit; sobre la tabla, píldoras de tiendas como Bandcamp 4 y Beatport 3."
    />
    <ul class="ticks">
      <li>Escanea tus carpetas de música: una coincidencia segura de artista y título se marca como conseguida y suena desde el disco</li>
      <li><kbd>H</kbd> muestra solo las pistas sin gestionar, y de nuevo todas</li>
      <li>Filtra por estado, tienda, género y más</li>
    </ul>
  </Track>

  <Track id="acquire" title="Conseguir" heading="Cómprala o descárgala gratis: la forma más segura de llegar a cada pista">
    <p class="lede">Tres caminos hasta el archivo. Cada uno dice qué queda en tus manos.</p>

    <div class="movement stack">
      <h3>Cada enlace, clasificado</h3>
      <p class="copy">
        Los enlaces de compra y descarga se clasifican por coincidencia estricta de dominio: Bandcamp, Beatport,
        Traxsource, Juno Download, Apple, tiendas de discos, gates de descarga, smart links y descargas gratuitas de
        SoundCloud. Si un enlace resulta ser una lista de tiendas, se abre, y los enlaces de Bandcamp y Beatport que
        contiene pasan a la pista.
      </p>
      <p class="manual"><strong>Queda en tus manos</strong> Qué enlace abrir: <kbd>O</kbd> o <kbd>Enter</kbd> abre en tu navegador los enlaces de las pistas seleccionadas.</p>
      <Shot
        src={stores}
        full={storesWindow}
        alt="La tabla de pistas filtrada por las píldoras de tiendas Bandcamp 4 y Beatport 3, con 7 de 14 pistas, cada una con un distintivo de Bandcamp o Beatport en la columna Tiendas."
      />
    </div>

    <div class="movement stack">
      <h3>Gates de descarga, resueltos</h3>
      <p class="copy">
        Los gates de «sigue para descargar» de Hypeddit, ToneDen, GateRush y Droploud se resuelven con sus propios
        flujos de descarga. Cuando un gate necesita el navegador, la extensión recorre sus pasos sin que lo veas y el
        archivo llega a la app. Los pasos sociales dependen de <em>Permitir acciones sociales</em> en Ajustes, activado
        por defecto; si lo desactivas, esos gates quedan en tus manos.
      </p>
      <p class="manual"><strong>Queda en tus manos</strong> Los CAPTCHA, los inicios de sesión en los proveedores y las primeras aprobaciones. La app pregunta antes, y una ventana del navegador solo se abre si tú lo eliges.</p>
      <Shot
        src={gates}
        full={gatesWindow}
        alt="El diálogo Los gates te necesitan: «Estos gates piden algo que solo tú puedes hacer, como iniciar sesión o resolver un CAPTCHA», sobre una lista de tres pistas, cada una marcada con «the gate wants a CAPTCHA solved», y los botones Abrir en el navegador, Omitir estos y Detener descarga."
      />
    </div>

    <div class="movement stack">
      <h3>Carritos, nunca el pago</h3>
      <p class="copy">
        Marca pistas y la app llena tu carrito de Bandcamp, y el de Beatport cuando se conoce la pista exacta, en
        pestañas en segundo plano de tu propio navegador. Cada página de producto se vuelve a comprobar justo antes de
        su clic; un título ambiguo, un precio cambiado o una pista que solo se vende con el álbum detienen el proceso en
        lugar de adivinar.
      </p>
      <p class="manual"><strong>Queda en tus manos</strong> El pago. Una pestaña de carrito por tienda pasa a ser tuya; la app nunca lee tu contraseña, elige un método de pago ni paga.</p>
      <Shot
        src={cart}
        full={cartWindow}
        alt="El diálogo Resultados del carrito: «Añadidos a los carritos: 4. No añadidos: 1», una lista de cinco pistas con resultados como «in Bandcamp cart», «already in Bandcamp cart» y «to playlist», y los botones Abrir enlaces no añadidos, Mostrar carritos y Cerrar."
      />
    </div>
  </Track>

  <Track id="prepare" title="Preparar" heading="Lista para los decks: archivos que leen tus CDJ y XDJ">
    <p class="lede">Las carpetas del disco se abren en la misma tabla y salen de ella como copias que tus decks pueden leer.</p>

    <div class="movement stack">
      <h3>Tu biblioteca local</h3>
      <p class="copy">
        Explora carpetas junto a tus playlists y crea playlists locales a partir de ellas. El BPM y la tonalidad se
        estiman en tu equipo y puedes corregirlos a mano; el análisis nunca escribe etiquetas de audio ni datos de
        rekordbox. WAV, AIFF, FLAC, MP3, AAC y M4A.
      </p>
      <p class="copy"><a href="/guides/organize-downloaded-dj-tracks/" hreflang="en">Cómo organizar las pistas descargadas para tus sesiones (en inglés)</a></p>
      <Shot
        src={library}
        full={libraryWindow}
        alt="Una carpeta local en la tabla de pistas: siete archivos, Drift Away de JMHBM marcada como Reproducida y el resto como Nueva, con chips de BPM de 120 a 130 y chips de tonalidad 9A, 8A, 10A, 5A, 7A y 8B."
      />
    </div>

    <div class="movement stack">
      <h3>Exportar para los decks</h3>
      <p class="copy">
        Marca los decks en los que deben sonar los archivos y la app elige el mejor formato que leen todos: FLAC cuando
        todos los decks elegidos lo leen, si no WAV, con la mayor profundidad de bits y frecuencia de muestreo que
        compartan. Los archivos que los decks ya reproducen se copian tal cual; solo el resto se convierte, en una
        carpeta nueva.
      </p>
      <p class="manual"><strong>Dónde se detiene</strong> Las reglas salen del manual de cada deck: es compatibilidad de archivos de audio, no pruebas en hardware ni una exportación de rekordbox. Nunca sube la frecuencia de muestreo y nunca formatea una unidad.</p>
      <p class="copy"><a href="/guides/flac-vs-wav-for-djs/" hreflang="en">Cómo elegir entre FLAC y WAV para tus reproductores (en inglés)</a></p>
      <Shot
        src={exportDialog}
        full={exportWindow}
        alt="El diálogo Exportar audio: «Elige los decks en los que deben sonar estos archivos; se elegirá el mejor formato que reproduzcan todos». Diez grupos de decks como casillas, de CDJ-350 a OMNIS-DUO y XDJ-AN, cinco de ellas marcadas; una carpeta de destino vacía con Examinar…, Modo en Copiar, Incluir subcarpetas sin marcar y los botones Exportar y Cancelar."
      />
    </div>
  </Track>

  <Track id="requirements" title="Requisitos del sistema">
    <p class="copy">Windows 10+, macOS 15+ y Linux.</p>
  </Track>

  <Track id="end" title="Consíguela" heading="Descarga dj-digger">
    <p class="copy">Después conecta tu navegador: los gates de descarga y los carritos funcionan a través de la extensión.</p>
    <div class="cta">
      <a class="button primary" href="/es/download/"><Icon name="download-simple" />Descargar</a>
      <a class="button" href="/es/extension/"><Icon name="puzzle-piece" />Descubre la extensión</a>
    </div>
  </Track>
</Base>

<style>
  /* Collect: the tall sidebar crop stands beside its text once the column has room. */
  .beside {
    container-type: inline-size;
  }
  .beside-grid {
    display: grid;
    gap: 2rem;
  }
  /* The figure is rendered by <Shot>, outside this page's scope. */
  .beside :global(.shot) {
    max-width: 13.75rem;
  }
  @container (min-width: 36rem) {
    .beside-grid {
      grid-template-columns: minmax(0, 1fr) 13.75rem;
      align-items: start;
    }
  }

  /* What each way to a track leaves to you: a margin note, not an alert. */
  .manual {
    max-width: 38rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--edge);
    color: var(--muted);
  }
  .manual strong {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--fg);
  }
</style>
