---
import Base from "../../layouts/Base.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import Icon from "../../components/Icon.astro";
import DataFlow from "../../components/extension/DataFlow.astro";
import HowItWorks from "../../components/about/HowItWorks.astro";
import BrowserFlow from "../../components/about/BrowserFlow.astro";
import { author, repo, version } from "../../../site.config.mjs";

const description =
  "Как устроен dj-digger, как приложение и его расширение для браузера справляются со скачиванием и корзинами, куда уходят ваши данные, и благодарности.";
// Sources at the released tag, so they describe what has shipped.
const release = `${repo}/blob/v${version}`;
---

<Base title="О проекте · dj-digger" description={description} label="about">
  <Track id="about" title="О проекте" hero sub>
    <Fragment slot="heading">О проекте <span class="grad">dj-digger</span></Fragment>
    <p class="lede">
      Бесплатное настольное приложение с открытым кодом для диггинга, с расширением для браузера. Сделал {author.name}.
    </p>
  </Track>

  <Track id="how" title="Как это работает">
    <p class="copy">Всё работает на вашем компьютере. Нет ни сервера dj-digger, ни аккаунта.</p>
    <HowItWorks
      title="Как работает dj-digger"
      desc="Плейлист SoundCloud попадает в приложение dj-digger на вашем компьютере. Приложение собирает весь список через API SoundCloud, запоминает ваши решения в локальной базе данных и сверяет ваши музыкальные папки. Оно ведёт к ссылкам на магазины, разобранным по магазинам, таким как Bandcamp, Beatport и Traxsource, к гейтам скачивания на Hypeddit и ToneDen и к копиям, экспортированным для ваших дек."
      playlist="Плейлист SoundCloud"
      computer="Ваш компьютер"
      app="Приложение dj-digger"
      steps={[
        ["Собирает весь список", "через API SoundCloud"],
        ["Помнит ваши решения", "в локальной базе данных"],
        ["Сверяет музыкальные папки", "чтобы видеть, что у вас уже есть"],
      ]}
      outs={[
        ["Ссылки на магазины", "Bandcamp, Beatport, Traxsource и др."],
        ["Гейты скачивания", "Hypeddit, ToneDen"],
        ["Ваши деки", "экспорт копий для ваших плееров"],
      ]}
    />
  </Track>

  <Track id="browser" title="Скачивание и корзины">
    <p class="copy">У гейта или корзины приложение передаёт каждый шаг расширению, а оно работает только во вкладках, которые открыло само.</p>
    <BrowserFlow
      title="Приложение и расширение у гейтов и корзин"
      desc="Приложение dj-digger и расширение dj-digger связаны через native messaging, свой единственный канал. Расширение работает только во вкладках, которые открыло само: на SoundCloud оно подключает приложение, на Hypeddit и ToneDen проходит гейт, и файл уходит в приложение, на Bandcamp и Beatport добавляет выбранное в вашу корзину. Вкладка, которая направляется на страницу оформления заказа или оплаты, закрывается; вкладку корзины вы проверяете и оплачиваете сами."
      app="Приложение dj-digger"
      appNote="передаёт каждый шаг"
      native="Native messaging"
      nativeNote="единственный канал"
      extension="Расширение dj-digger"
      extensionNote="работает только в своих вкладках"
      signin={["SoundCloud", "подключает приложение"]}
      gates={["Hypeddit, ToneDen", "проходит гейт, файл — в приложение"]}
      cart={["Bandcamp, Beatport", "добавляет выбранное в корзину"]}
      closed="Заказ или оплата: вкладка закрыта"
      yours="Корзина: проверяете и платите вы"
    />
  </Track>

  <Track id="data" title="Куда уходят ваши данные">
    <div class="split">
      <DataFlow />
      <p class="copy">
        Ваша библиотека, решения и настройки остаются на вашем компьютере. Расширение общается только с приложением, и
        разработчику ничего не отправляется.
      </p>
    </div>
  </Track>

  <Track id="kick" title="Подсветка по бочке">
    <p class="copy">
      Подсветка плеера следует за бочкой. Её уровень вычисляется из звука ещё до воспроизведения, а саму подсветку
      проверили кадр за кадром в настоящем окне.
    </p>
    <Loop />
    <div class="cta">
      <a class="button" href={`${release}/docs/kick-pulse-validation.md`}><Icon name="book-open" />Заметки о проверке</a>
    </div>
  </Track>

  <Track id="credits" title="Благодарности и источники">
    <p class="copy">dj-digger распространяется с открытым кодом по лицензии Apache License 2.0.</p>
    <div class="cta">
      <a class="button" href={repo}><Icon name="github-logo" />Исходный код</a>
      <a class="button" href={`${release}/PROJECT_SPECIFICATION.md`}><Icon name="book-open" />Спецификация</a>
      <a class="button" href={`${release}/CHANGELOG.md`}><Icon name="clock-counter-clockwise" />Журнал изменений</a>
    </div>
    <dl class="spec sources">
      <dt>Шрифты</dt>
      <dd>Archivo и JetBrains Mono, SIL Open Font License.</dd>
      <dt>Значки</dt>
      <dd><a href="https://phosphoricons.com">Phosphor Icons</a>, лицензия MIT.</dd>
      <dt>Снимки экрана</dt>
      <dd>
        Демо-трек на снимках экрана приложения и расширения — «Drift Away» от JMHBM (Johnathon M. Horner, Beat
        Mekanik), <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, через{" "}
        <a href="https://freemusicarchive.org/music/beat-mekanik/single/drift-away/">Free Music Archive</a>.
      </dd>
    </dl>
  </Track>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
  .sources dd {
    color: var(--muted);
  }
  .sources a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .sources a:hover,
  .sources a:focus-visible {
    text-decoration: underline;
  }
  @media (max-width: 30rem) {
    .spec {
      grid-template-columns: 1fr;
    }
    .spec dd {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
