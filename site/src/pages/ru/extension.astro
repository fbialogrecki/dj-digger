---
import Base from "../../layouts/Base.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import Icon from "../../components/Icon.astro";
import DataFlow from "../../components/extension/DataFlow.astro";
import panel from "../../assets/screenshots/extension-panel.png";
import { chromeStore } from "../../../site.config.mjs";

const description =
  "Расширение dj-digger для браузера проходит страницы скачивания, наполняет корзины магазинов и подключает настольное приложение к SoundCloud в твоём собственном браузере. Что оно делает, в каких браузерах работает и куда уходят твои данные.";

// The five jobs of extension 1.4.4 (dj-digger 1.6.0).
const jobs = [
  ["lock-key-open", "Страницы скачивания", "Проходит страницы скачивания Hypeddit и ToneDen, которые приложение не может пройти само. Файл уходит в приложение."],
  ["shopping-cart", "Корзины магазинов", "Добавляет выбранное в твои корзины Bandcamp и Beatport. Никогда не оформляет заказ и не платит."],
  ["sign-in", "Вход в SoundCloud", "Подключает приложение к SoundCloud через сеанс, который уже есть в твоём браузере."],
  ["play-circle", "Плеер на панели инструментов", "Воспроизведение, пауза, пропуск и перемотка трека приложения, ход текущей задачи и ответ, когда странице скачивания нужна твоя помощь."],
  ["soundcloud-logo", "Импорт из SoundCloud", "Отправь плейлист, трек или профиль в приложение из панели, контекстного меню или кнопкой Import to DJ digger."],
];
---

<Base title="Расширение для браузера · dj-digger" description={description} label="extension">
  <Track hero sub id="overview" title="Расширение для браузера">
    <Fragment slot="heading">Расширение <span class="grad">для браузера</span></Fragment>
    <p class="lede">
      Руки настольного приложения в браузере, которым ты уже пользуешься. Оно работает, пока dj-digger запущен на том же
      компьютере.
    </p>
    <div class="cta">
      <a class="button primary" href={chromeStore}><Icon name="google-chrome-logo" />Установить из Chrome Web Store</a>
    </div>
    <div class="panel">
      <Shot
        src={panel}
        alt="Панель dj-digger на панели инструментов воспроизводит Drift Away от JMHBM: пластинка на обложке, полоса перемотки на 1:25 из 3:01 и кнопки предыдущего трека, паузы и следующего трека."
        sizes="(min-width: 44rem) 17rem, 20rem"
        eager
      />
    </div>
  </Track>

  <Track id="does" title="Что оно делает">
    <ul class="cards">
      {
        jobs.map(([icon, name, text]) => (
          <li class="card">
            <h3><Icon name={icon} />{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="browsers" title="Поддерживаемые браузеры">
    <p class="lede">Chrome, Edge и Brave. Edge спросит, разрешить ли расширения из других магазинов.</p>
    <p class="copy">Браузеры, установленные как Flatpak или Snap, не могут установить связь с приложением.</p>
  </Track>

  <Track id="data" title="Куда уходят твои данные">
    <div class="split">
      <DataFlow />
      <p class="copy">
        Расширение общается только с приложением dj-digger на твоём компьютере. Разработчику ничего не отправляется: ни
        аналитики, ни рекламы. Оно хранит только данные сеанса, которые стираются при закрытии браузера.
      </p>
    </div>
  </Track>

  <Track id="end" title="Начни с приложения">
    <p class="copy">Расширение ждёт настольное приложение. Установи его и запусти один раз.</p>
    <div class="cta">
      <a class="button primary" href="/ru/download/"><Icon name="download-simple" />Скачать настольное приложение</a>
    </div>
  </Track>
</Base>

<style>
  /* Hero: the portrait panel at phone width beside the text, under it on narrow columns. */
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 44rem) {
    :global(#overview) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 34%, 17rem);
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    :global(#overview) > :global(*) {
      grid-column: 1;
      align-self: start;
    }
    :global(#overview) > .panel {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      max-width: none;
    }
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card h3 :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
</style>
