---
import Base from "../../layouts/Base.astro";
import Track from "../../components/Track.astro";
import Code from "../../components/Code.astro";
import Icon from "../../components/Icon.astro";
import { asset, repo, version } from "../../../site.config.mjs";

const fileName = (url) => url.split("/").pop();
const windows = asset("windows-x64-test.exe");
const arm = asset("macos-arm64-test.dmg");
const intel = asset("macos-x86_64-test.dmg");
const guide = `${repo}/blob/main/docs/installation.md`;
const script = new URL("install.sh", Astro.site).href;

const description = `Скачайте dj-digger ${version} для Windows 10 и 11 или macOS 15 и новее либо установите на Linux одной командой. У каждого файла есть контрольная сумма SHA-256.`;
---

<Base title={`Скачать dj-digger ${version}`} description={description} label="download">
  <Track id="download" title="Скачать dj-digger" hero sub>
    <p class="lede"><strong>Версия {version}</strong>, бесплатно и с открытым кодом.</p>

    {/* Without a script the three systems stand one under another; the script below makes them tabs. */}
    <div class="systems" data-systems>
      <div class="tabs" role="tablist" aria-label="Система" hidden>
        <button class="button compact" type="button" role="tab" id="tab-windows" aria-controls="windows" aria-selected="false" tabindex="-1">
          <Icon name="windows-logo" />Windows
        </button>
        <button class="button compact" type="button" role="tab" id="tab-macos" aria-controls="macos" aria-selected="false" tabindex="-1">
          <Icon name="apple-logo" />macOS
        </button>
        <button class="button compact" type="button" role="tab" id="tab-linux" aria-controls="linux" aria-selected="false" tabindex="-1">
          <Icon name="linux-logo" />Linux
        </button>
      </div>

      <div class="panel stack" id="windows">
        <h2><Icon name="windows-logo" />Windows</h2>
        <p class="copy">Windows 10 (версия 1809 или новее) или Windows 11, 64-бит.</p>
        <div class="cta">
          <a class="button primary" href={windows}><Icon name="download-simple" />Скачать для Windows</a>
        </div>
        <p class="note">
          <Icon name="info" />
          <span>
            Неподписанная предварительная сборка: если SmartScreen пишет <strong>Система Windows защитила ваш компьютер</strong>,
            нажмите <strong>Подробнее</strong>, затем <strong>Выполнить в любом случае</strong>.
          </span>
        </p>
        <div class="cta">
          <a class="button" href={`${guide}#windows`}><Icon name="book-open" />Руководство по установке</a>
        </div>
      </div>

      <div class="panel stack" id="macos">
        <h2><Icon name="apple-logo" />macOS</h2>
        <p class="copy">macOS 15 или новее. <strong>Об этом Mac</strong> показывает чип Apple или процессор Intel.</p>
        <div class="cta">
          <a class="button" href={arm}><Icon name="download-simple" />Apple Silicon</a>
          <a class="button" href={intel}><Icon name="download-simple" />Intel</a>
        </div>
        <p class="note">
          <Icon name="info" />
          <span>
            Неподписанная предварительная сборка: если macOS не может проверить приложение, откройте
            <strong>Системные настройки, Конфиденциальность и безопасность</strong> и нажмите <strong>Всё равно открыть</strong>.
          </span>
        </p>
        <div class="cta">
          <a class="button" href={`${guide}#mac`}><Icon name="book-open" />Руководство по установке</a>
        </div>
      </div>

      <div class="panel stack" id="linux">
        <h2><Icon name="linux-logo" />Linux</h2>
        <Code code={`wget -qO- ${script} | sh`} />
        <p class="copy">
          Вставьте эту команду в терминал: она установит dj-digger со всем необходимым, спросит перед всем, что требует
          <code>sudo</code>, и обновит его при повторном запуске.
        </p>
        <div class="cta">
          <a class="button" href="/install.sh"><Icon name="terminal-window" />Прочитать скрипт</a>
        </div>
      </div>
    </div>
  </Track>

  <Track id="verify" title="Проверьте загрузку">
    <p class="copy">Сравните результат с файлом <code>.sha256</code> рядом с вашим файлом на странице релиза.</p>
    <Code label="Windows, PowerShell" code={`Get-FileHash .\\${fileName(windows)} -Algorithm SHA256`} />
    <Code label="macOS, Терминал" code={`shasum -a 256 dj-digger-${version}-macos-*.dmg`} />
    <div class="cta">
      <a class="button" href={`${repo}/releases`}><Icon name="github-logo" />Все релизы и контрольные суммы</a>
    </div>
  </Track>

  <Track id="next" title="После установки" heading="Затем подключите браузер">
    <p class="copy">Гейты скачивания и корзины магазинов работают через расширение dj-digger в Chrome, Edge и Brave.</p>
    <div class="cta">
      <a class="button" href="/ru/extension/"><Icon name="puzzle-piece" />Установить расширение</a>
    </div>
  </Track>
</Base>

<script>
  // Turns the stacked systems into tabs (WAI-ARIA tabs pattern), this computer's system first
  // and selected. Detected here only, nothing is sent. Phones, tablets and unknown systems keep the given order.
  const list = document.querySelector("[data-systems] [role=tablist]");
  if (list) {
    const ua = navigator.userAgent;
    const name = (navigator as any).userAgentData?.platform || navigator.platform || ua;
    const mobile = /android|iphone|ipad|ipod|cros|chrome os/i.test(`${name} ${ua}`);
    const ipad = /mac/i.test(name) && navigator.maxTouchPoints > 1; // iPadOS reports itself as a Mac
    const os = mobile || ipad ? "" : /win/i.test(name) ? "windows" : /mac/i.test(name) ? "macos" : /linux/i.test(name) ? "linux" : "";
    const mine = list.querySelector(`[aria-controls="${os}"]`);
    if (mine) list.prepend(mine); // in the DOM, so focus and reading order follow
    const tabs = [...list.querySelectorAll<HTMLElement>("[role=tab]")];
    const panel = (tab: HTMLElement) => document.getElementById(tab.getAttribute("aria-controls")!)!;
    const select = (tab: HTMLElement) => {
      for (const other of tabs) {
        other.setAttribute("aria-selected", String(other === tab));
        other.tabIndex = other === tab ? 0 : -1;
        panel(other).hidden = other !== tab;
      }
    };
    for (const tab of tabs) {
      const box = panel(tab);
      box.setAttribute("role", "tabpanel");
      box.setAttribute("aria-labelledby", tab.id);
      box.querySelector("h2")?.classList.add("sr"); // the tab names it now
      tab.addEventListener("click", () => select(tab));
    }
    list.addEventListener("keydown", (event) => {
      const at = tabs.indexOf(document.activeElement as HTMLElement);
      const to = { ArrowRight: at + 1, ArrowLeft: at - 1, Home: 0, End: tabs.length - 1 }[event.key];
      if (at < 0 || to === undefined) return;
      event.preventDefault();
      const tab = tabs[(to + tabs.length) % tabs.length];
      select(tab);
      tab.focus();
    });
    select(tabs[0]);
    list.hidden = false;
  }
</script>

<style>
  /* One box: the tabs across its top, the selected system under them. */
  .systems {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* lets the command scroll inside instead of widening the box */
    gap: 1.25rem;
    max-width: 44rem;
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
  }
  .tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .tabs[hidden] {
    display: none;
  }
  .tabs .button {
    min-width: 0;
    padding-inline: 0.4rem;
  }
  /* Selected: raised, with its edge lit, so it never rests on colour alone. */
  .tabs [aria-selected="true"] {
    --bar: var(--accent-2);
    border-color: var(--edge);
    background: var(--raise);
  }
  /* Without the tabs: a rule between the stacked systems. */
  .tabs[hidden] ~ .panel + .panel {
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .panel h2 {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: 1.8rem;
  }
  .panel .button {
    white-space: normal;
    text-align: center;
  }
  .note {
    display: flex;
    gap: 0.6rem;
    max-width: 38rem;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .note .icon {
    margin-top: 0.15em;
    color: var(--accent-2);
  }
  .note strong,
  .panel .copy strong {
    color: var(--fg);
    font-weight: 600;
  }
</style>
