---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Shot from "../../components/Shot.astro";
import Track from "../../components/Track.astro";
import collect from "../../assets/screenshots/ru/crops/collect.png";
import decisions from "../../assets/screenshots/ru/crops/decisions.png";
import panelJob from "../../assets/screenshots/extension-panel-job.png";
import libraryWindow from "../../assets/screenshots/ru/desktop-local-library.png";
import playerWindow from "../../assets/screenshots/ru/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/ru/desktop-crates-decisions.png";
import { version } from "../../../site.config.mjs";

const description =
  "Локальное приложение для диггинга для диджеев: превращает плейлисты, лайки и профили SoundCloud в библиотеку, которую можно прослушать, и находит самый безопасный способ скачать или купить каждый трек.";
const loop = [
  {
    name: "Собрать",
    text: "Вставьте ссылку на плейлист, лайки или профиль. Приходит весь список, а не только строки, которые успела показать страница.",
    src: collect,
    full: playerWindow,
    alt: "Окно dj-digger: на боковой панели открыт плейлист Late Night Selects, плеер на треке Drift Away от JMHBM на 1:21 из 3:01 с формой волны, кнопки магазинов, например Bandcamp 4 и Beatport 3, и первые строки таблицы треков.",
  },
  {
    name: "Решить",
    text: "Отмечайте треки как имеющиеся или пропущенные. Решение следует за треком в каждый плейлист, где он встречается.",
    src: decisions,
    full: decisionsWindow,
    alt: "Таблица треков с открытым фильтром статуса: строки со статусами «Есть», «Прослушан», «Открыт» и «Новый» и меню с пунктами «Все статусы», «Необработанные», «Новый», «Открытые», «Имеющиеся» и «Пропущенные».",
  },
  {
    name: "Купить или скачать",
    text: "Дальше всё делает расширение для браузера, в вашем собственном браузере: проходит гейты скачивания и наполняет корзины магазинов. Оформление заказа остаётся за вами.",
    src: panelJob,
    alt: "Панель расширения dj-digger для браузера: Drift Away от JMHBM на 1:27 из 3:01, кнопки управления, а под ними надпись о добавлении в корзины магазинов и кнопка отмены.",
  },
];
---

<Base title="dj-digger: диггинг для диджеев" description={description}>
  <section class="hero" id="start" aria-labelledby="start-title">
    <h1 id="start-title">От плейлиста SoundCloud до <span class="grad">файлов на ваших деках</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> собирает плейлисты целиком, запоминает ваши решения и находит способ купить или
      скачать каждый трек.
    </p>
    <div class="cta">
      <a class="button primary" href="/ru/download/"><Icon name="download-simple" />Скачать</a>
    </div>
    <ul class="facts">
      <li>Бесплатно и с открытым кодом</li>
      <li>Windows, macOS, Linux</li>
      <li>Без аккаунта и без сервера</li>
    </ul>
    <Loop eager />
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the three steps
      one at a time. Everywhere else, and without the CSS below, three stacked steps. */}
  <section id="loop" class="loop" aria-labelledby="loop-title">
    <div class="stage stack">
      <h2 id="loop-title">Один цикл, от начала до конца</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step) => (
            <li class="movement">
              <div class="text">
                <h3>{step.name}</h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" title="Настольное приложение">
    <Shot
      src={libraryWindow}
      alt="Главное окно dj-digger с локальной папкой Digging 2026: плеер на треке Drift Away от JMHBM на 1:27 из 3:01 и семь треков со значениями BPM от 120 до 130 и тональностями вроде 9A, 8A и 5A."
    />
    <ul class="ticks">
      <li>Знает, что у вас уже есть</li>
      <li>Определяет BPM и тональность</li>
      <li>Экспортирует для ваших дек</li>
    </ul>
    <div class="cta"><a class="button" href="/ru/app/"><Icon name="desktop" />Подробнее о приложении</a></div>
  </Track>

  <Track id="extension" title="Расширение для браузера">
    <p class="copy">
      В вашем собственном Chrome, Edge или Brave оно проходит гейты скачивания, наполняет корзины магазинов и выносит
      плеер на панель инструментов.
    </p>
    <div class="cta"><a class="button" href="/ru/extension/"><Icon name="puzzle-piece" />Подробнее о расширении</a></div>
  </Track>

  <Track id="trust" title="Ваше и честное" heading="Ваше и честное о своих границах">
    <ul class="ticks">
      <li>Ваши плейлисты и решения остаются на вашем компьютере.</li>
      <li>Оно никогда не платит и не оформляет заказ за вас.</li>
      <li>Оно никогда не гадает: неясное совпадение останавливает работу, и об этом сообщается.</li>
    </ul>
  </Track>

  <Track id="get" title="Скачать" heading="Поставьте пластинку">
    <p class="copy">dj-digger {version}, бесплатно для Windows, macOS и Linux.</p>
    <div class="cta"><a class="button primary" href="/ru/download/"><Icon name="download-simple" />Скачать</a></div>
  </Track>
</Base>

<style>
  /* ---------- the loop: three stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each shot keeps its own shape; the frame sits on the image so it hugs narrow and wide shots alike.
     --ar is the image's width / height, so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 2.3623;
  }
  .steps > li:nth-child(2) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(3) {
    --ar: 0.6413;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 320svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All three share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      /* The whole image fits the stage: as wide as the column allows, never taller than the cell. */
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
        max-height: calc(100cqh - 2px);
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 33.333%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 33.333% contain 66.667%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 66.667% contain 100%;
      }
    }
  }
  /* Full opacity over 90% of a step's range; the hand-over is a short cross-fade.
     z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    5%,
    95% {
      color: var(--fg);
    }
  }
</style>
