---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import mainWindow from "../../assets/screenshots/ru/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/ru/desktop-crates-decisions.png";
import storesWindow from "../../assets/screenshots/ru/desktop-store-links.png";
import gatesWindow from "../../assets/screenshots/ru/desktop-jobs-gates.png";
import cartWindow from "../../assets/screenshots/ru/desktop-cart.png";
import libraryWindow from "../../assets/screenshots/ru/desktop-local-library.png";
import exportWindow from "../../assets/screenshots/ru/desktop-export.png";
import sidebar from "../../assets/screenshots/ru/crops/sidebar.png";
import decisions from "../../assets/screenshots/ru/crops/decisions.png";
import stores from "../../assets/screenshots/ru/crops/stores.png";
import gates from "../../assets/screenshots/ru/crops/gates.png";
import cart from "../../assets/screenshots/ru/crops/cart.png";
import library from "../../assets/screenshots/ru/crops/library.png";
import exportDialog from "../../assets/screenshots/ru/crops/export.png";

const description =
  "Импортируй плейлисты, лайки и профили SoundCloud целиком, слушай с BPM и тональностью, отмечай, что у тебя есть, проходи страницы скачивания Hypeddit и ToneDen, экспортируй под свои деки.";
---

<Base title="Десктопное приложение: плейлисты SoundCloud в библиотеку диджея · dj-digger" description={description} label="app">
  <Track hero sub id="overview" title="Весь цикл">
    <Fragment slot="heading">Весь цикл диггинга <span class="grad">в одном окне</span></Fragment>
    <p class="lede">Каждая картинка на этой странице — настоящее приложение на демо-данных.</p>
    <div class="cta">
      <a class="button primary" href="/ru/download/"><Icon name="download-simple" />Скачать</a>
    </div>
    <Shot
      src={mainWindow}
      eager
      alt="Главное окно dj-digger. На боковой панели три плейлиста SoundCloud, выбран Late Night Selects, а под ними папки «Загрузки» и «Музыка». Плеер вверху показывает Drift Away от JMHBM на 1:21 из 3:01 со сгенерированной обложкой-пластинкой и пурпурной формой волны. Ниже поле поиска, кнопки магазинов (Bandcamp 4, Beatport 3, Hypeddit 3, Traxsource 1, Juno Download 1), фильтр статуса и таблица из 14 треков, у каждого статус, исполнитель, название, жанр, год, лейбл, длительность и значок магазина."
    />
  </Track>

  <Track id="collect" title="Собрать" heading="Плейлисты SoundCloud целиком, а не прокрученная страница">
    <div class="beside">
      <div class="beside-grid">
        <div class="stack">
          <p class="lede">Приложение читает всю коллекцию через API SoundCloud.</p>
          <ul class="ticks">
            <li>Плейлисты и сеты, лайки, репосты, профили исполнителей и отдельные треки</li>
            <li>Импорт наполняет таблицу партиями и сохраняется, когда придёт всё целиком</li>
            <li>Войди в SoundCloud, чтобы читать свои приватные плейлисты</li>
            <li>При обновлении плейлиста новые треки встают наверх с пометкой <code>NEW</code></li>
          </ul>
        </div>
        <Shot
          src={sidebar}
          full={libraryWindow}
          sizes="220px"
          alt="Боковая панель: поле фильтра плейлистов и папок; три плейлиста SoundCloud — Late Night Selects с 14 треками, Sunday Balcony с 4 и Warehouse Warmups с 6 — и кнопка «плюс», чтобы добавить новый; ниже обозреватель «Папки» с «Загрузками» и «Музыкой», где выбрана папка Digging 2026 с семью файлами."
        />
      </div>
    </div>
  </Track>

  <Track id="audition" title="Прослушать" heading="Превью с волновой формой, которая чувствует бочку">
    <p class="lede">Слушай превью из SoundCloud или играй файл с диска, если он у тебя есть.</p>
    <Loop />
    <ul class="ticks">
      <li>Перематывай по форме волны; следующий трек готовится заранее</li>
      <li>На каждой бочке сыгранная часть формы волны вспыхивает — вслед за бочкой, а не басовой линией</li>
      <li>Превью декодируются в памяти и никогда не сохраняются на диск</li>
      <li>Поиск, фильтры и сортировка, не уходя из плейлиста; <kbd>?</kbd> показывает все сочетания клавиш</li>
      <li>«Вид → Анимация» выключает подсветку</li>
    </ul>
  </Track>

  <Track id="decide" title="Решить" heading="Ящики, которые помнят, что у тебя есть, а что пропущено">
    <p class="lede">«Есть», «Пропущен», «Прослушан» и «Открыт»: каждый трек хранит свой статус.</p>
    <Shot
      src={decisions}
      full={decisionsWindow}
      alt="Таблица треков с открытым фильтром статуса: «Все статусы», «Необработанные», «Новый», «Открытые», «Имеющиеся» и «Пропущенные». В столбце «Статус» значатся «Есть», «Есть», «Прослушан», «Есть», «Открыт» и «Новый» рядом с Nightglass, Coral Engine, Sable Fern, Tidewell, Ostra Lumen и Pale Circuit; над таблицей кнопки магазинов, например Bandcamp 4 и Beatport 3."
    />
    <ul class="ticks">
      <li>Сканирует твои музыкальные папки: при уверенном совпадении исполнителя и названия трек получает статус «Есть» и играет с диска</li>
      <li><kbd>H</kbd> показывает только треки, которые ещё предстоит обработать, и снова все</li>
      <li>Фильтры по статусу, магазину, жанру и не только</li>
    </ul>
  </Track>

  <Track id="acquire" title="Получить" heading="Купи или скачай бесплатно: самый безопасный путь к каждому треку">
    <p class="lede">Три пути к файлу. У каждого сказано, что остаётся за тобой.</p>

    <div class="movement stack">
      <h3>Все ссылки по полочкам</h3>
      <p class="copy">
        Ссылки на покупку и скачивание распознаются по строгому совпадению домена: Bandcamp, Beatport, Traxsource, Juno
        Download, Apple, музыкальные магазины, страницы скачивания (так называемые гейты, например Hypeddit), смартлинки и
        бесплатные скачивания SoundCloud. Если
        ссылка оказывается списком магазинов, она открывается, и стоящие за ней ссылки Bandcamp и Beatport попадают к
        треку.
      </p>
      <p class="manual"><strong>Остаётся за тобой</strong> Какую ссылку открыть: <kbd>O</kbd> или <kbd>Enter</kbd> открывает ссылки выбранных треков в твоём браузере.</p>
      <Shot
        src={stores}
        full={storesWindow}
        alt="Таблица треков, отфильтрованная кнопками магазинов Bandcamp 4 и Beatport 3: показано 7 из 14 треков, у каждого значок Bandcamp или Beatport в столбце «Магазины»."
      />
    </div>

    <div class="movement stack">
      <h3>Страницы скачивания — пройдены</h3>
      <p class="copy">
        Страницы скачивания Hypeddit, ToneDen, GateRush и Droploud, где за скачивание нужно подписаться, проходятся
        через их собственные механизмы скачивания. Если странице нужен браузер, расширение незаметно проходит её шаги, и
        файл приходит в приложение. Социальные шаги подчиняются параметру <em>«Разрешить социальные действия»</em> в
        настройках, по умолчанию он включён; выключи его, и такие страницы останутся ручными.
      </p>
      <p class="manual"><strong>Остаётся за тобой</strong> CAPTCHA, вход на сайты сервисов и первые подтверждения. Приложение сначала спрашивает, а окно браузера открывается только по твоему желанию.</p>
      <Shot
        src={gates}
        full={gatesWindow}
        alt="Диалог «Гейтам нужна ваша помощь»: «Эти гейты требуют того, что можете сделать только вы, например войти в аккаунт или пройти CAPTCHA», под ним список из трёх треков, у каждого пометка, что гейт требует пройти CAPTCHA, и кнопки «Открыть в браузере», «Пропустить эти» и «Остановить скачивание»."
      />
    </div>

    <div class="movement stack">
      <h3>Корзины, но не оплата</h3>
      <p class="copy">
        Отметь треки, и приложение наполнит твою корзину Bandcamp, а если точный трек известен, то и корзину
        Beatport — в фоновых вкладках твоего собственного браузера. Каждая страница товара перепроверяется прямо перед
        нажатием; неоднозначное название, изменившаяся цена или трек, который продаётся только с альбомом, останавливают
        работу вместо догадок.
      </p>
      <p class="manual"><strong>Остаётся за тобой</strong> Оформление заказа. Одна вкладка корзины на каждый магазин переходит к тебе; приложение никогда не читает твой пароль, не выбирает способ оплаты и не платит.</p>
      <Shot
        src={cart}
        full={cartWindow}
        alt="Диалог «Результаты корзины»: «Добавлено в корзины: 4. Не добавлено: 1», список из пяти треков с результатами вроде «в корзине Bandcamp», «уже в корзине Bandcamp» и «в плейлист» и кнопки «Открыть недобавленные ссылки», «Показать корзины» и «Закрыть»."
      />
    </div>
  </Track>

  <Track id="prepare" title="Подготовить" heading="Готово для дек: файлы, которые читают твои CDJ и XDJ">
    <p class="lede">Папки на диске открываются в той же таблице и покидают её копиями, которые читают твои деки.</p>

    <div class="movement stack">
      <h3>Твоя локальная библиотека</h3>
      <p class="copy">
        Просматривай папки рядом с плейлистами и собирай из них локальные плейлисты. BPM и тональность
        определяются на твоём компьютере и правятся вручную; анализ никогда не записывает аудиотеги и данные rekordbox.
        WAV, AIFF, FLAC, MP3, AAC и M4A.
      </p>
      <Shot
        src={library}
        full={libraryWindow}
        alt="Локальная папка в таблице треков: семь файлов, Drift Away от JMHBM со статусом «Прослушан», остальные «Новый», значения BPM от 120 до 130 и тональности 9A, 8A, 10A, 5A, 7A и 8B."
      />
    </div>

    <div class="movement stack">
      <h3>Экспорт для дек</h3>
      <p class="copy">
        Отметь деки, на которых должны играть файлы, и приложение выберет лучший формат, который читают все они: FLAC,
        если его читает каждая выбранная дека, иначе WAV — с наибольшей общей для них разрядностью и частотой
        дискретизации. Файлы, которые деки уже воспроизводят, копируются как есть; конвертируются только остальные, в
        новую папку.
      </p>
      <p class="manual"><strong>Где граница</strong> Правила взяты из руководства каждой деки: это совместимость аудиофайлов, а не проверка на железе и не экспорт rekordbox. Приложение никогда не повышает частоту дискретизации и никогда не форматирует накопители.</p>
      <Shot
        src={exportDialog}
        full={exportWindow}
        alt="Диалог «Экспортировать аудио»: «Выберите деки, на которых должны играть эти файлы; лучший формат, который поддерживают все, будет выбран автоматически». Десять групп дек флажками, от CDJ-350 до OMNIS-DUO и XDJ-AN, пять из них отмечены; пустая папка назначения с кнопкой «Обзор…», режим «Копировать», флажок «Включить подпапки» снят, кнопки «Экспортировать» и «Отмена»."
      />
    </div>
  </Track>

  <Track id="requirements" title="Системные требования">
    <p class="copy">Windows 10+, macOS 15+ и Linux.</p>
  </Track>

  <Track id="end" title="Установить" heading="Скачай dj-digger">
    <p class="copy">Затем подключи браузер: страницы скачивания и корзины магазинов работают через расширение.</p>
    <div class="cta">
      <a class="button primary" href="/ru/download/"><Icon name="download-simple" />Скачать</a>
      <a class="button" href="/ru/extension/"><Icon name="puzzle-piece" />Подробнее о расширении</a>
    </div>
  </Track>
</Base>

<style>
  /* Collect: the tall sidebar crop stands beside its text once the column has room. */
  .beside {
    container-type: inline-size;
  }
  .beside-grid {
    display: grid;
    gap: 2rem;
  }
  /* The figure is rendered by <Shot>, outside this page's scope. */
  .beside :global(.shot) {
    max-width: 13.75rem;
  }
  @container (min-width: 36rem) {
    .beside-grid {
      grid-template-columns: minmax(0, 1fr) 13.75rem;
      align-items: start;
    }
  }

  /* What each way to a track leaves to you: a margin note, not an alert. */
  .manual {
    max-width: 38rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--edge);
    color: var(--muted);
  }
  .manual strong {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--fg);
  }
</style>
