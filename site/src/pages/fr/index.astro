---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Shot from "../../components/Shot.astro";
import Track from "../../components/Track.astro";
import collect from "../../assets/screenshots/fr/crops/collect.png";
import decisions from "../../assets/screenshots/fr/crops/decisions.png";
import panelJob from "../../assets/screenshots/extension-panel-job.png";
import libraryWindow from "../../assets/screenshots/fr/desktop-local-library.png";
import playerWindow from "../../assets/screenshots/fr/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/fr/desktop-crates-decisions.png";
import { version } from "../../../site.config.mjs";

const description =
  "Une application de crate digging pour DJ, qui garde tout en local : transformez vos playlists, likes et profils SoundCloud en une bibliothèque à écouter, puis trouvez le moyen le plus sûr de télécharger ou d'acheter chaque morceau.";
const loop = [
  {
    name: "Collecter",
    text: "Collez le lien d'une playlist, de vos likes ou d'un profil. La liste entière arrive, pas seulement les lignes qu'une page a affichées.",
    src: collect,
    full: playerWindow,
    alt: "La fenêtre de dj-digger : la playlist Late Night Selects ouverte dans la barre latérale, le lecteur sur Drift Away de JMHBM à 1:21 sur 3:01 avec sa forme d'onde, des pastilles de boutiques comme Bandcamp 4 et Beatport 3, et les premières lignes du tableau des morceaux.",
  },
  {
    name: "Décider",
    text: "Marquez les morceaux comme possédés ou passés. La décision suit le morceau dans toutes les playlists où il figure.",
    src: decisions,
    full: decisionsWindow,
    alt: "Le tableau des morceaux avec le filtre de statut ouvert : des lignes marquées Je l'ai, Écouté, Ouvert et Nouveau, et un menu proposant Tous les statuts, Non traités, Nouveau, Ouverts, Possédés et Passés.",
  },
  {
    name: "Acheter ou télécharger",
    text: "Ensuite, l'extension de navigateur fait le reste, dans votre propre navigateur : elle vient à bout des gates de téléchargement et remplit vos paniers. Le paiement reste entre vos mains.",
    src: panelJob,
    alt: "Le panneau de l'extension de navigateur dj-digger : Drift Away de JMHBM à 1:27 sur 3:01, les boutons de lecture et, en dessous, l'ajout aux paniers des boutiques en cours, avec un bouton pour l'annuler.",
  },
];
---

<Base title="dj-digger : le crate digging pour DJ" description={description}>
  <section class="hero" id="start" aria-labelledby="start-title">
    <h1 id="start-title">D'une playlist SoundCloud <span class="grad">aux fichiers sur vos platines</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> récupère des playlists entières, retient vos décisions et trouve un moyen d'acheter ou
      de télécharger chaque morceau.
    </p>
    <div class="cta">
      <a class="button primary" href="/fr/download/"><Icon name="download-simple" />Télécharger</a>
    </div>
    <ul class="facts">
      <li>Libre et gratuit</li>
      <li>Windows, macOS, Linux</li>
      <li>Sans compte, sans serveur</li>
    </ul>
    <Loop eager />
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the three steps
      one at a time. Everywhere else, and without the CSS below, three stacked steps. */}
  <section id="loop" class="loop" aria-labelledby="loop-title">
    <div class="stage stack">
      <h2 id="loop-title">Une seule boucle, du début à la fin</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step) => (
            <li class="movement">
              <div class="text">
                <h3>{step.name}</h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" title="L'application de bureau">
    <Shot
      src={libraryWindow}
      alt="La fenêtre principale de dj-digger sur un dossier local, Digging 2026 : le lecteur sur Drift Away de JMHBM à 1:27 sur 3:01, et sept morceaux avec des pastilles de BPM de 120 à 130 et des tonalités comme 9A, 8A et 5A."
    />
    <ul class="ticks">
      <li>Sait ce que vous possédez déjà</li>
      <li>Estime le BPM et la tonalité</li>
      <li>Exporte pour vos platines</li>
    </ul>
    <div class="cta"><a class="button" href="/fr/app/"><Icon name="desktop" />Découvrir l'application</a></div>
  </Track>

  <Track id="extension" title="L'extension de navigateur">
    <p class="copy">
      Dans votre propre Chrome, Edge ou Brave, elle vient à bout des gates de téléchargement, remplit vos paniers et
      place le lecteur dans la barre d'outils.
    </p>
    <div class="cta"><a class="button" href="/fr/extension/"><Icon name="puzzle-piece" />Découvrir l'extension</a></div>
  </Track>

  <Track id="trust" title="À vous, et honnête" heading="À vous, et honnête sur ses limites">
    <ul class="ticks">
      <li>Vos playlists et vos décisions restent sur votre ordinateur.</li>
      <li>dj-digger ne paie jamais et ne valide jamais de commande à votre place.</li>
      <li>Rien n'est deviné : une correspondance douteuse s'arrête et est signalée.</li>
    </ul>
  </Track>

  <Track id="get" title="Télécharger" heading="Posez le disque">
    <p class="copy">dj-digger {version}, gratuit pour Windows, macOS et Linux.</p>
    <div class="cta"><a class="button primary" href="/fr/download/"><Icon name="download-simple" />Télécharger</a></div>
  </Track>
</Base>

<style>
  /* ---------- the loop: three stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each shot keeps its own shape; the frame sits on the image so it hugs narrow and wide shots alike.
     --ar is the image's width / height, so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 2.3623;
  }
  .steps > li:nth-child(2) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(3) {
    --ar: 0.6413;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 320svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All three share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      /* The whole image fits the stage: as wide as the column allows, never taller than the cell. */
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
        max-height: calc(100cqh - 2px);
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 33.333%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 33.333% contain 66.667%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 66.667% contain 100%;
      }
    }
  }
  /* Full opacity over 90% of a step's range; the hand-over is a short cross-fade.
     z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    5%,
    95% {
      color: var(--fg);
    }
  }
</style>
