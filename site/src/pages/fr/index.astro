---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Loop from "../../components/Loop.astro";
import Shot from "../../components/Shot.astro";
import Track from "../../components/Track.astro";
import sidebar from "../../assets/screenshots/fr/crops/sidebar.png";
import playerCrop from "../../assets/screenshots/fr/crops/player.png";
import decisions from "../../assets/screenshots/fr/crops/decisions.png";
import cart from "../../assets/screenshots/fr/crops/cart.png";
import libraryWindow from "../../assets/screenshots/fr/desktop-local-library.png";
import playerWindow from "../../assets/screenshots/fr/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/fr/desktop-crates-decisions.png";
import cartWindow from "../../assets/screenshots/fr/desktop-cart.png";
import panel from "../../assets/screenshots/extension-panel.png";
import { repo, version } from "../../../site.config.mjs";

const description =
  "Une application de crate digging pour DJ, qui garde tout en local : transformez vos playlists, likes et profils SoundCloud en une bibliothèque à écouter, puis trouvez le moyen le plus sûr de télécharger ou d'acheter chaque morceau.";
const tracks = [
  { id: "start", no: "01", title: "De la playlist aux platines" },
  { id: "loop", no: "02", title: "La boucle du digging" },
  { id: "app", no: "03", title: "L'application de bureau" },
  { id: "extension", no: "04", title: "L'extension de navigateur" },
  { id: "trust", no: "05", title: "À vous, et honnête" },
  { id: "get", no: "06", title: "Choisissez votre pressage" },
];
const loop = [
  {
    name: "Collecter",
    text: "Collez le lien d'une playlist, de vos likes, de vos reposts, d'un profil ou d'un morceau. La liste entière arrive par l'API de SoundCloud, pas seulement les lignes qu'une page a bien voulu afficher.",
    src: sidebar,
    full: libraryWindow,
    alt: "La barre latérale de dj-digger : trois playlists SoundCloud, Late Night Selects avec 14 morceaux, Sunday Balcony avec 4 et Warehouse Warmups avec 6, et en dessous les dossiers Téléchargements et Musique, avec Digging 2026 ouvert.",
  },
  {
    name: "Écouter",
    text: "Pré-écoutez, naviguez dans le morceau, cherchez, filtrez et triez sans quitter la playlist. La partie lue de la forme d'onde s'allume à chaque kick.",
    src: playerCrop,
    full: playerWindow,
    alt: "Le lecteur de dj-digger : Slow Orbit de Nightglass à 1:04 sur 3:20, sa pochette générée, une forme d'onde allumée en magenta jusqu'à la tête de lecture, les boutons de lecture et un curseur de volume.",
  },
  {
    name: "Décider",
    text: "Marquez les morceaux comme possédés ou passés. La décision suit le morceau dans toutes les playlists où il figure.",
    src: decisions,
    full: decisionsWindow,
    alt: "Le tableau des morceaux avec le filtre de statut ouvert : des lignes marquées « Je l'ai », « Écouté », « Ouvert » et « Nouveau », et un menu proposant Tous les statuts, Non traités, Nouveau, Ouverts, Possédés et Passés.",
  },
  {
    name: "Acheter ou télécharger",
    text: "Suivez les liens de boutiques classés, venez à bout des gates de téléchargement, remplissez vos paniers Bandcamp et Beatport. Le paiement reste entre vos mains.",
    src: cart,
    full: cartWindow,
    alt: "La fenêtre Résultats du panier : ajoutés aux paniers 4, non ajoutés 1. Quatre morceaux sont dans le panier Bandcamp ou y étaient déjà, un est parti dans une playlist, avec des boutons pour envoyer la playlist à Soundiiz, ouvrir les liens non ajoutés, afficher les paniers ou fermer.",
  },
];
---

<Base title="dj-digger : le crate digging pour DJ" description={description} tracks={tracks}>
  <section class="hero" id="start" data-track="01" data-title="De la playlist aux platines" aria-labelledby="start-title">
    <p class="eyebrow"><span class="no">01</span>Le crate digging pour DJ</p>
    <h1 id="start-title">D'une playlist SoundCloud <span class="grad">aux fichiers sur vos platines</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> est une application de bureau qui garde tout en local. Elle récupère des playlists entières,
      vous les fait écouter, retient vos décisions et trouve le moyen le plus sûr d'acheter ou de télécharger chaque morceau.
    </p>
    <div class="cta">
      <a class="button primary" href="/fr/download/">Télécharger</a>
      <a class="quiet" href="#loop">Voir comment se déroule une session</a>
    </div>
    <ul class="facts">
      <li>Libre et gratuit</li>
      <li>Windows, macOS, Linux</li>
      <li>Sans compte, sans serveur</li>
    </ul>
    <Loop eager>Capturé dans la vraie application, morceaux de démo, pochettes générées</Loop>
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the four steps
      one at a time. Everywhere else, and without the CSS below, four stacked steps. */}
  <section id="loop" class="loop" data-track="02" data-title="La boucle du digging" aria-labelledby="loop-title">
    <div class="stage stack">
      <p class="eyebrow"><span class="no">02</span>Le déroulé d'une session</p>
      <h2 id="loop-title">Une seule boucle, du début à la fin</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step, i) => (
            <li class="movement">
              <div class="text">
                <h3>
                  <span class="no">{`0${i + 1}`}</span>{" "}{step.name}
                </h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" no="03" title="L'application de bureau" label="Sur votre ordinateur" heading="L'application de bureau">
    <p class="copy">
      Une application de bureau qui se pilote au clavier : les playlists dans la barre latérale, un tableau des morceaux
      avec des badges de boutiques, un lecteur avec forme d'onde.
    </p>
    <Shot
      src={playerWindow}
      caption="La fenêtre principale"
      alt="La fenêtre principale de dj-digger : la barre latérale avec trois playlists SoundCloud et les dossiers de musique, le lecteur sur Slow Orbit de Nightglass à 1:04 sur 3:20, et le tableau de Late Night Selects avec les colonnes Statut, Artiste, Nom du morceau, Genre, Année, Label, Durée et des badges de boutiques comme Bandcamp, Beatport et Hypeddit."
    />
    <ul class="ticks">
      <li>Sait ce que vous possédez déjà : elle analyse vos dossiers et lit les fichiers depuis le disque</li>
      <li>Estime le BPM et la tonalité, et exporte des copies vérifiées selon les profils audio documentés des platines</li>
      <li>Une CLI sans interface pour vos propres scripts</li>
    </ul>
    <div class="cta"><a class="button" href="/fr/app/">Découvrir l'application</a></div>
  </Track>

  <Track id="extension" no="04" title="L'extension de navigateur" label="Dans votre navigateur" heading="L'extension de navigateur">
    <div class="split">
      <div class="stack">
        <p class="copy">
          Elle ne fonctionne que si l'application de bureau tourne sur le même ordinateur : ce sont les mains de
          l'application dans votre propre navigateur. Elle termine les gates de téléchargement, remplit vos paniers
          Bandcamp et Beatport dans des onglets en arrière-plan et place le lecteur de l'application dans votre barre
          d'outils.
        </p>
        <ul class="ticks">
          <li>Fonctionne dans le navigateur et avec les comptes que vous utilisez déjà</li>
          <li>Ne parle qu'à dj-digger sur votre ordinateur</li>
          <li>Chrome, Edge, Brave, Chromium ; Firefox à part</li>
        </ul>
        <div class="cta"><a class="button" href="/fr/extension/">Découvrir l'extension</a></div>
      </div>
      <div class="panel">
        <Shot
          src={panel}
          sizes="(min-width: 46rem) 13rem, 18rem"
          alt="Le panneau de dj-digger dans la barre d'outils : la pochette de Slow Orbit de Nightglass, une barre de progression à 1:08 sur 3:20 et les boutons précédent, pause et suivant."
        />
      </div>
    </div>
  </Track>

  <Track id="trust" no="05" title="À vous, et honnête" label="Tout en local" heading="À vous, et honnête sur ses limites">
    <div class="columns">
      <div class="stack">
        <h3>Ce qui reste chez vous</h3>
        <ul class="ticks">
          <li>Pas de compte dj-digger ni de serveur dj-digger.</li>
          <li>Playlists, décisions et réglages sont stockés dans une base de données locale sur votre ordinateur.</li>
          <li>La connexion SoundCloud est conservée dans le trousseau de votre système ; les mots de passe ne sont jamais lus.</li>
          <li>Ce site ne dépose aucun cookie et ne charge rien depuis d'autres serveurs.</li>
        </ul>
      </div>
      <div class="stack">
        <h3>Ce qu'elle ne fera pas</h3>
        <ul class="ticks">
          <li>Payer ou valider une commande : un onglet qui se dirige vers une page de paiement est fermé.</li>
          <li>Résoudre des CAPTCHA ou se connecter à votre place.</li>
          <li>Deviner : face à un titre ambigu, un prix modifié ou un morceau vendu seulement en album, elle s'arrête et le signale.</li>
          <li>Formater des disques ou écrire dans votre bibliothèque rekordbox.</li>
        </ul>
      </div>
    </div>
    <p><a class="quiet" href={`${repo}/blob/main/PRIVACY.md`}>Lire la politique de confidentialité</a></p>
  </Track>

  <Track id="get" no="06" title="Choisissez votre pressage" label="Sillon final" heading="Choisissez votre pressage">
    <p class="copy">dj-digger {version} est libre et gratuit, sans inscription.</p>
    <div class="press stack">
      <div class="cta"><a class="button primary" href="/fr/download/">Télécharger</a></div>
      <ul class="facts" aria-label="Plateformes">
        <li>Windows 10 (1809 ou plus récent) et 11</li>
        <li>macOS 15 ou plus récent</li>
        <li>Linux</li>
      </ul>
    </div>
    <p><a class="quiet" href="/fr/liner-notes/">Curieux de savoir comment elle est construite ? Lisez le livret</a></p>
  </Track>
</Base>

<style>
  /* ---------- 02 the digging loop: four stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .steps h3 {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }
  .steps h3 .no {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each crop keeps its own shape; the frame sits on the image so it hugs narrow and wide crops alike.
     --ar is the crop's width / height (crops/*.png), so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 0.6509;
  }
  .steps > li:nth-child(2) {
    --ar: 4.25;
  }
  .steps > li:nth-child(3) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(4) {
    --ar: 2.1152;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }
  .media :global(.shot figcaption) {
    justify-content: flex-start;
    padding-inline: 0;
    border-top: 0;
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 400svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All four share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
      }
      .media :global(.shot figcaption) {
        display: none;
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 25%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 25% contain 50%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 50% contain 75%;
      }
      #loop .steps > li:nth-child(4),
      #loop .meter li:nth-child(4),
      #loop .meter li:nth-child(4)::after {
        animation-range: contain 75% contain 100%;
      }
    }
  }
  /* z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    20%,
    80% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    80% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    20%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    10%,
    90% {
      color: var(--fg);
    }
  }

  /* ---------- 04 the extension: the portrait panel beside the text, under it on narrow screens ---------- */
  .split {
    display: grid;
    gap: 2rem;
  }
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 46rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) 13rem;
      align-items: start;
      gap: 2.5rem;
    }
  }

  /* ---------- 05 trust: two plain columns ---------- */
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem 2.5rem;
  }

  /* ---------- 06 the run-out groove ---------- */
  .press .facts {
    margin-top: 0.9rem;
  }
</style>
