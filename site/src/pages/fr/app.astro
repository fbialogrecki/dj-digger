---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Loop from "../../components/Loop.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import mainWindow from "../../assets/screenshots/fr/desktop-player.png";
import decisionsWindow from "../../assets/screenshots/fr/desktop-crates-decisions.png";
import storesWindow from "../../assets/screenshots/fr/desktop-store-links.png";
import gatesWindow from "../../assets/screenshots/fr/desktop-jobs-gates.png";
import cartWindow from "../../assets/screenshots/fr/desktop-cart.png";
import libraryWindow from "../../assets/screenshots/fr/desktop-local-library.png";
import exportWindow from "../../assets/screenshots/fr/desktop-export.png";
import sidebar from "../../assets/screenshots/fr/crops/sidebar.png";
import decisions from "../../assets/screenshots/fr/crops/decisions.png";
import stores from "../../assets/screenshots/fr/crops/stores.png";
import gates from "../../assets/screenshots/fr/crops/gates.png";
import cart from "../../assets/screenshots/fr/crops/cart.png";
import library from "../../assets/screenshots/fr/crops/library.png";
import exportDialog from "../../assets/screenshots/fr/crops/export.png";

const description =
  "Importez des playlists, likes et profils SoundCloud entiers, écoutez avec BPM et tonalité, marquez ce que vous avez, passez les gates Hypeddit et ToneDen, exportez pour vos platines.";
---

<Base title="Application de bureau : vos playlists SoundCloud en bibliothèque DJ · dj-digger" description={description} label="app">
  <Track hero sub id="overview" title="Toute la boucle">
    <Fragment slot="heading">Toute la boucle du digging <span class="grad">dans une seule fenêtre</span></Fragment>
    <p class="lede">Chaque image de cette page montre la vraie application, avec des données de démo.</p>
    <div class="cta">
      <a class="button primary" href="/fr/download/"><Icon name="download-simple" />Télécharger</a>
    </div>
    <Shot
      src={mainWindow}
      eager
      alt="La fenêtre principale de dj-digger. Une barre latérale liste trois playlists SoundCloud, Late Night Selects sélectionnée, au-dessus des dossiers Téléchargements et Musique. Le lecteur, en haut, affiche Drift Away de JMHBM à 1:21 sur 3:01, avec une pochette de disque générée et une forme d'onde magenta. En dessous, un champ de recherche, des pastilles de boutiques (Bandcamp 4, Beatport 3, Hypeddit 3, Traxsource 1, Juno Download 1), un filtre de statut et un tableau de 14 morceaux avec, pour chacun, statut, artiste, nom du morceau, genre, année, label, durée et un badge de boutique."
    />
  </Track>

  <Track id="collect" title="Collecter" heading="Des playlists SoundCloud entières, pas une page défilée">
    <div class="beside">
      <div class="beside-grid">
        <div class="stack">
          <p class="lede">L'application lit toute la collection par l'API de SoundCloud.</p>
          <ul class="ticks">
            <li>Playlists et sets, likes, reposts, profils d'artistes et morceaux seuls</li>
            <li>L'import remplit le tableau lot par lot, et n'est enregistré qu'une fois tout arrivé</li>
            <li>Connectez-vous à SoundCloud pour lire vos propres playlists privées</li>
            <li>Actualiser une playlist place ses nouveautés en haut, marquées <code>NEW</code></li>
          </ul>
        </div>
        <Shot
          src={sidebar}
          full={libraryWindow}
          sizes="220px"
          alt="La barre latérale : un champ pour filtrer les playlists et les dossiers ; trois playlists SoundCloud, Late Night Selects avec 14 morceaux, Sunday Balcony avec 4 et Warehouse Warmups avec 6, et un bouton plus pour en ajouter une ; en dessous, l'explorateur Dossiers avec Téléchargements et Musique, où le dossier Digging 2026 et ses sept fichiers est sélectionné."
        />
      </div>
    </div>
  </Track>

  <Track id="audition" title="Écouter" heading="Une pré-écoute sur une forme d'onde qui sent le kick">
    <p class="lede">Écoutez un extrait SoundCloud en streaming, ou lisez le fichier sur le disque quand vous l'avez.</p>
    <Loop />
    <ul class="ticks">
      <li>Déplacez-vous sur la forme d'onde ; le morceau suivant est préparé à l'avance</li>
      <li>À chaque kick, la partie lue de la forme d'onde s'allume, en suivant la grosse caisse, pas la ligne de basse</li>
      <li>Les extraits sont décodés en mémoire et jamais enregistrés sur le disque</li>
      <li>Cherchez, filtrez et triez sans quitter la playlist ; <kbd>?</kbd> liste tous les raccourcis</li>
      <li>Affichage → Animations éteint la lumière</li>
    </ul>
  </Track>

  <Track id="decide" title="Décider" heading="Des crates qui retiennent ce que vous avez et ce que vous avez écarté">
    <p class="lede">Je l'ai, passé, écouté, ouvert : chaque morceau garde son statut.</p>
    <Shot
      src={decisions}
      full={decisionsWindow}
      alt="Le tableau des morceaux avec son filtre de statut ouvert, qui propose Tous les statuts, Non traités, Nouveau, Ouverts, Possédés et Passés. La colonne Statut indique Je l'ai, Je l'ai, Écouté, Je l'ai, Ouvert et Nouveau à côté de Nightglass, Coral Engine, Sable Fern, Tidewell, Ostra Lumen et Pale Circuit ; au-dessus du tableau, des pastilles de boutiques comme Bandcamp 4 et Beatport 3."
    />
    <ul class="ticks">
      <li>Analyse vos dossiers de musique : une correspondance sûre sur l'artiste et le titre est marquée comme possédée et se lit depuis le disque</li>
      <li><kbd>H</kbd> n'affiche que les morceaux encore à traiter, puis tout à nouveau</li>
      <li>Filtrez par statut, boutique, genre et plus encore</li>
    </ul>
  </Track>

  <Track id="acquire" title="Obtenir" heading="Acheter ou télécharger gratuitement : le moyen le plus sûr d'obtenir chaque morceau">
    <p class="lede">Trois chemins vers le fichier. Chacun dit ce qui reste entre vos mains.</p>

    <div class="movement stack">
      <h3>Chaque lien, classé</h3>
      <p class="copy">
        Les liens d'achat et de téléchargement sont classés par correspondance stricte du domaine : Bandcamp, Beatport,
        Traxsource, Juno Download, Apple, disquaires, gates de téléchargement, smart links et téléchargements gratuits
        SoundCloud. Un lien qui s'avère être une liste de boutiques est ouvert, et les liens Bandcamp et Beatport qu'il
        contient arrivent sur le morceau.
      </p>
      <p class="manual"><strong>Reste entre vos mains</strong> Le lien à ouvrir : <kbd>O</kbd> ou <kbd>Entrée</kbd> ouvre dans votre navigateur les liens des morceaux sélectionnés.</p>
      <Shot
        src={stores}
        full={storesWindow}
        alt="Le tableau des morceaux filtré par les pastilles de boutiques Bandcamp 4 et Beatport 3, qui affiche 7 morceaux sur 14, chacun avec un badge Bandcamp ou Beatport dans la colonne Boutiques."
      />
    </div>

    <div class="movement stack">
      <h3>Les gates de téléchargement, gérés</h3>
      <p class="copy">
        Les gates qui demandent un follow pour télécharger, sur Hypeddit, ToneDen, GateRush et Droploud, sont
        résolus par leurs propres parcours de téléchargement. Quand un gate a besoin du navigateur, l'extension en suit les étapes hors de vue et
        le fichier arrive dans l'application. Les étapes sociales suivent <em>Autoriser les actions sociales</em> dans les
        Paramètres, activé par défaut ; désactivez-le et ces gates restent manuels.
      </p>
      <p class="manual"><strong>Reste entre vos mains</strong> Les CAPTCHA, les connexions aux fournisseurs et les premières autorisations. L'application demande d'abord, et une fenêtre de navigateur ne s'ouvre que si vous le choisissez.</p>
      <Shot
        src={gates}
        full={gatesWindow}
        alt="La fenêtre Des gates ont besoin de vous : « Ces gates demandent une action que vous seul pouvez faire, comme une connexion ou un CAPTCHA », au-dessus d'une liste de trois morceaux dont le gate attend chacun un CAPTCHA résolu, et les boutons Ouvrir dans le navigateur, Passer ceux-ci et Arrêter le téléchargement."
      />
    </div>

    <div class="movement stack">
      <h3>Les paniers, jamais le paiement</h3>
      <p class="copy">
        Cochez des morceaux et l'application remplit votre panier Bandcamp, et votre panier Beatport quand le morceau
        exact est connu, dans des onglets en arrière-plan de votre propre navigateur. Chaque page produit est revérifiée
        juste avant son clic ; un titre ambigu, un prix modifié ou un morceau vendu seulement avec l'album arrête tout au
        lieu de deviner.
      </p>
      <p class="manual"><strong>Reste entre vos mains</strong> Le paiement. Un onglet de panier par boutique vous revient ; l'application ne lit jamais votre mot de passe, ne choisit pas de moyen de paiement et ne paie pas.</p>
      <Shot
        src={cart}
        full={cartWindow}
        alt="La fenêtre Résultats du panier : « Ajoutés aux paniers : 4. Non ajoutés : 1. », une liste de cinq morceaux avec des résultats comme dans le panier Bandcamp, déjà dans le panier Bandcamp ou vers une playlist, et les boutons Ouvrir les liens non ajoutés, Afficher les paniers et Fermer."
      />
    </div>
  </Track>

  <Track id="prepare" title="Préparer" heading="Prêt pour les platines : des fichiers que lisent vos CDJ et XDJ">
    <p class="lede">Les dossiers du disque s'ouvrent dans le même tableau, et en ressortent en copies que vos platines savent lire.</p>

    <div class="movement stack">
      <h3>Votre bibliothèque locale</h3>
      <p class="copy">
        Parcourez vos dossiers à côté de vos playlists et créez-en des playlists locales. Le BPM et la tonalité sont
        estimés sur votre ordinateur et se corrigent à la main ; l'analyse n'écrit jamais de tags audio ni de données
        rekordbox. WAV, AIFF, FLAC, MP3, AAC et M4A.
      </p>
      <Shot
        src={library}
        full={libraryWindow}
        alt="Un dossier local dans le tableau des morceaux : sept fichiers, Drift Away de JMHBM marqué Écouté et les autres Nouveau, avec des pastilles de BPM de 120 à 130 et des tonalités 9A, 8A, 10A, 5A, 7A et 8B."
      />
    </div>

    <div class="movement stack">
      <h3>Exporter pour les platines</h3>
      <p class="copy">
        Cochez les platines sur lesquelles les fichiers doivent être lus et l'application choisit le meilleur format
        qu'elles lisent toutes : FLAC quand chaque platine choisie le lit, sinon WAV, à la plus haute profondeur de bits
        et fréquence d'échantillonnage qu'elles partagent. Les fichiers que les platines lisent déjà sont copiés tels
        quels ; seuls les autres sont convertis, dans un nouveau dossier.
      </p>
      <p class="manual"><strong>Ses limites</strong> Les règles viennent du manuel de chaque platine : il s'agit de compatibilité des fichiers audio, pas de tests sur le matériel ni d'un export rekordbox. L'export ne suréchantillonne jamais et ne formate jamais de disque.</p>
      <Shot
        src={exportDialog}
        full={exportWindow}
        alt="La fenêtre Exporter l'audio : « Choisissez les platines sur lesquelles ces fichiers doivent être lus ; le meilleur format compatible avec toutes est choisi pour vous. » Dix groupes de platines en cases à cocher, du CDJ-350 aux OMNIS-DUO et XDJ-AN, dont cinq cochés ; un dossier de destination vide avec Parcourir, le mode réglé sur Copier, Inclure les sous-dossiers décoché, et les boutons Exporter et Annuler."
      />
    </div>
  </Track>

  <Track id="requirements" title="Configuration requise">
    <p class="copy">Windows 10+, macOS 15+ et Linux.</p>
  </Track>

  <Track id="end" title="L'obtenir" heading="Téléchargez dj-digger">
    <p class="copy">Connectez ensuite votre navigateur : les gates de téléchargement et les paniers passent par l'extension.</p>
    <div class="cta">
      <a class="button primary" href="/fr/download/"><Icon name="download-simple" />Télécharger</a>
      <a class="button" href="/fr/extension/"><Icon name="puzzle-piece" />Découvrir l'extension</a>
    </div>
  </Track>
</Base>

<style>
  /* Collect: the tall sidebar crop stands beside its text once the column has room. */
  .beside {
    container-type: inline-size;
  }
  .beside-grid {
    display: grid;
    gap: 2rem;
  }
  /* The figure is rendered by <Shot>, outside this page's scope. */
  .beside :global(.shot) {
    max-width: 13.75rem;
  }
  @container (min-width: 36rem) {
    .beside-grid {
      grid-template-columns: minmax(0, 1fr) 13.75rem;
      align-items: start;
    }
  }

  /* What each way to a track leaves to you: a margin note, not an alert. */
  .manual {
    max-width: 38rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--edge);
    color: var(--muted);
  }
  .manual strong {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--fg);
  }
</style>
