---
import Base from "../../layouts/Base.astro";
import Track from "../../components/Track.astro";
import Shot from "../../components/Shot.astro";
import Icon from "../../components/Icon.astro";
import DataFlow from "../../components/extension/DataFlow.astro";
import panel from "../../assets/screenshots/extension-panel.png";
import { chromeStore } from "../../../site.config.mjs";

const description =
  "Extension pour Chrome, Edge et Brave : termine les gates de téléchargement Hypeddit et ToneDen et remplit vos paniers Bandcamp et Beatport. Le paiement reste à vous.";

// The five jobs of extension 1.4.4 (dj-digger 1.6.0).
const jobs = [
  ["lock-key-open", "Gates de téléchargement", "Termine les gates Hypeddit et ToneDen que l'application ne peut pas terminer seule. Le fichier part vers l'application."],
  ["shopping-cart", "Paniers des boutiques", "Ajoute vos choix à vos paniers Bandcamp et Beatport. Elle ne valide jamais de commande et ne paie jamais."],
  ["sign-in", "Connexion à SoundCloud", "Connecte l'application avec la session SoundCloud que votre navigateur a déjà."],
  ["play-circle", "Le lecteur dans la barre d'outils", "Lisez, mettez en pause, passez et déplacez-vous dans le morceau de l'application, suivez sa tâche en cours, répondez quand des gates ont besoin de vous."],
  ["soundcloud-logo", "Importer depuis SoundCloud", "Envoyez une playlist, un morceau ou un profil à l'application depuis le panneau, le menu du clic droit ou le bouton Import to DJ digger."],
];
---

<Base title="Extension pour gates de téléchargement et paniers · dj-digger" description={description} label="extension">
  <Track hero sub id="overview" title="L'extension de navigateur">
    <Fragment slot="heading">L'extension de navigateur</Fragment>
    <p class="lede">
      Les mains de l'application de bureau, dans le navigateur que vous utilisez déjà. Elle fonctionne tant que
      dj-digger tourne sur le même ordinateur.
    </p>
    <div class="cta">
      <a class="button primary" href={chromeStore}><Icon name="google-chrome-logo" />Ajouter depuis le Chrome Web Store</a>
    </div>
    <div class="panel">
      <Shot
        src={panel}
        alt="Le panneau de dj-digger dans la barre d'outils, qui lit Drift Away de JMHBM : un disque sur la pochette, une barre de progression à 1:25 sur 3:01, et les boutons précédent, pause et suivant."
        sizes="(min-width: 44rem) 17rem, 20rem"
        eager
      />
    </div>
  </Track>

  <Track id="does" title="Ce qu'elle fait">
    <ul class="cards">
      {
        jobs.map(([icon, name, text]) => (
          <li class="card">
            <h3><Icon name={icon} />{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </Track>

  <Track id="browsers" title="Navigateurs compatibles">
    <p class="lede">Chrome, Edge et Brave. Edge demande d'autoriser les extensions provenant d'autres boutiques.</p>
    <p class="copy">Les navigateurs installés en Flatpak ou en Snap ne peuvent pas établir le lien avec l'application.</p>
  </Track>

  <Track id="data" title="Où vont vos données">
    <div class="split">
      <DataFlow />
      <p class="copy">
        L'extension ne parle qu'à l'application dj-digger sur votre ordinateur. Rien n'est envoyé au développeur : ni
        statistiques, ni publicité. Elle ne garde que des données de session, effacées à la fermeture du navigateur.
      </p>
    </div>
  </Track>

  <Track id="end" title="Commencez par l'application">
    <p class="copy">L'extension attend l'application de bureau. Installez-la et lancez-la une fois.</p>
    <div class="cta">
      <a class="button primary" href="/fr/download/"><Icon name="download-simple" />Obtenir l'application de bureau</a>
    </div>
  </Track>
</Base>

<style>
  /* Hero: the portrait panel at phone width beside the text, under it on narrow columns. */
  .panel {
    max-width: 18rem;
  }
  @media (min-width: 44rem) {
    :global(#overview) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 34%, 17rem);
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    :global(#overview) > :global(*) {
      grid-column: 1;
      align-self: start;
    }
    :global(#overview) > .panel {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      max-width: none;
    }
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card h3 :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2.5rem;
    align-items: center;
  }
</style>
