---
import Base from "../layouts/Base.astro";
import Track from "../components/Track.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Page not found | dj-digger" description="This page is not on the record." noindex>
  <Track id="empty" title="This groove is empty" hero sub>
    <p class="lede">The page you asked for is not on this record.</p>
    <div class="cta">
      <a class="button primary" href="/"><Icon name="house" />Back to the start</a>
    </div>
  </Track>
</Base>

<style is:global>
  /* Nothing to play here: the needle sits in the run-out groove and the record is still. */
  .tonearm .arm {
    animation: none !important;
    rotate: var(--arm-end) !important;
  }
  .record .disc,
  .record .spin-up,
  .tonearm .drop {
    animation: none !important;
  }
</style>
