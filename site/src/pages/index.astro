---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Loop from "../components/Loop.astro";
import Shot from "../components/Shot.astro";
import Track from "../components/Track.astro";
import collect from "../assets/screenshots/crops/collect.png";
import decisions from "../assets/screenshots/crops/decisions.png";
import panelJob from "../assets/screenshots/extension-panel-job.png";
import libraryWindow from "../assets/screenshots/desktop-local-library.png";
import playerWindow from "../assets/screenshots/desktop-player.png";
import decisionsWindow from "../assets/screenshots/desktop-crates-decisions.png";
import { version } from "../../site.config.mjs";

const description =
  "A local-first crate-digging app for DJs: turn SoundCloud playlists, likes and profiles into an auditionable library, then find the safest way to download or buy each track.";
const loop = [
  {
    name: "Collect",
    text: "Paste a playlist, likes or profile link. The whole list arrives, not just the rows a page rendered.",
    src: collect,
    full: playerWindow,
    alt: "The dj-digger window: the playlist Late Night Selects open in the sidebar, the player on Drift Away by JMHBM at 1:21 of 3:01 with its waveform, store pills such as Bandcamp 4 and Beatport 3, and the first rows of the track table.",
  },
  {
    name: "Decide",
    text: "Mark tracks got or skipped. The decision follows the track into every playlist it appears in.",
    src: decisions,
    full: decisionsWindow,
    alt: "The track table with the status filter open: rows marked Got, Played, Opened and New, and a menu offering All statuses, Unhandled, New, Opened, Owned and Skipped.",
  },
  {
    name: "Buy or download",
    text: "From here the browser extension does the rest, in your own browser: it clears download gates and fills your store carts. Checkout stays yours.",
    src: panelJob,
    alt: "The dj-digger browser extension's panel: Drift Away by JMHBM at 1:27 of 3:01, the transport buttons, and below them “Adding to store carts” with a Cancel button.",
  },
];
---

<Base title="dj-digger: crate digging for DJs" description={description}>
  <section class="hero" id="start" aria-labelledby="start-title">
    <h1 id="start-title">From a SoundCloud playlist to <span class="grad">files on your decks</span></h1>
    <p class="lede">
      <strong>dj-digger</strong> collects whole playlists, remembers what you decided and finds a way to buy or
      download each track.
    </p>
    <div class="cta">
      <a class="button primary" href="/download/"><Icon name="download-simple" />Download</a>
    </div>
    <ul class="facts">
      <li>Free and open source</li>
      <li>Windows, macOS, Linux</li>
      <li>No account, no backend</li>
    </ul>
    <Loop eager />
  </section>

  {/* Wide screens with scroll-driven animations: a tall section whose stage pins and plays the three steps
      one at a time. Everywhere else, and without the CSS below, three stacked steps. */}
  <section id="loop" class="loop" aria-labelledby="loop-title">
    <div class="stage stack">
      <h2 id="loop-title">One loop, start to finish</h2>
      <ol class="meter" aria-hidden="true">
        {loop.map((step) => <li>{step.name}</li>)}
      </ol>
      <ol class="steps">
        {
          loop.map((step) => (
            <li class="movement">
              <div class="text">
                <h3>{step.name}</h3>
                <p class="copy">{step.text}</p>
              </div>
              <div class="media">
                <Shot src={step.src} alt={step.alt} full={step.full} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Track id="app" title="The desktop app">
    <Shot
      src={libraryWindow}
      alt="The dj-digger main window on a local folder, Digging 2026: the player on Drift Away by JMHBM at 1:27 of 3:01, and seven tracks with BPM chips from 120 to 130 and keys such as 9A, 8A and 5A."
    />
    <ul class="ticks">
      <li>Knows what you already own</li>
      <li>Estimates BPM and key</li>
      <li>Exports for your decks</li>
    </ul>
    <div class="cta"><a class="button" href="/app/"><Icon name="desktop" />Explore the app</a></div>
  </Track>

  <Track id="extension" title="The browser extension">
    <p class="copy">
      In your own Chrome, Edge or Brave it clears download gates, fills your store carts and puts the player in the
      toolbar.
    </p>
    <div class="cta"><a class="button" href="/extension/"><Icon name="puzzle-piece" />Explore the extension</a></div>
  </Track>

  <Track id="trust" title="Yours, and honest" heading="Yours, and honest about its limits">
    <ul class="ticks">
      <li>Your playlists and decisions stay on your computer.</li>
      <li>It never pays or checks out for you.</li>
      <li>It never guesses: an unclear match stops and is reported.</li>
    </ul>
  </Track>

  <Track id="get" title="Download" heading="Put it on">
    <p class="copy">dj-digger {version}, free for Windows, macOS and Linux.</p>
    <div class="cta"><a class="button primary" href="/download/"><Icon name="download-simple" />Download</a></div>
  </Track>
</Base>

<style>
  /* ---------- the loop: three stacked steps by default ---------- */
  .meter {
    display: none;
  }
  .text > * + * {
    margin-top: 0.5rem;
  }
  .media {
    margin-top: 1.2rem;
    container-type: inline-size;
  }
  /* Each shot keeps its own shape; the frame sits on the image so it hugs narrow and wide shots alike.
     --ar is the image's width / height, so the width can be capped without knowing the height. */
  .steps > li:nth-child(1) {
    --ar: 2.3623;
  }
  .steps > li:nth-child(2) {
    --ar: 3.4048;
  }
  .steps > li:nth-child(3) {
    --ar: 0.6413;
  }
  .media :global(.shot) {
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .media :global(.shot a) {
    width: fit-content;
    border-radius: 12px;
  }
  .media :global(.shot img) {
    width: min(100cqw, 26rem * var(--ar));
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 30px 70px -40px var(--shadow);
  }

  /* The pinned scene: one step at a time, driven by the section's own view timeline. */
  @media (min-width: 68rem) and (min-height: 36rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (grid-template-rows: subgrid) {
      .loop {
        height: 320svh;
        padding-block: 0;
      }
      .stage {
        position: sticky;
        top: calc(var(--top) + 1rem);
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr);
        height: calc(100svh - var(--top) - 2rem);
        padding-top: clamp(1rem, 5vh, 3rem);
      }
      .meter {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        font: 500 0.72rem var(--mono);
        color: var(--muted);
      }
      .meter li {
        position: relative;
        padding-top: 0.7rem;
        animation: loop-now 1ms linear both;
      }
      .meter li::before,
      .meter li::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--line);
      }
      .meter li::after {
        background: linear-gradient(90deg, var(--neon-foot), var(--neon-top));
        transform-origin: left;
        scale: 0 1;
        animation: loop-fill 1ms linear both;
      }
      .steps {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 1.2rem;
      }
      /* All three share one cell; subgrid gives every step the tallest text, so the images never jump. */
      .steps > li {
        position: relative;
        grid-area: 1 / 1 / 3 / 2;
        display: grid;
        grid-template-rows: subgrid;
        padding-top: 0;
        border-top: 0;
        animation: loop-step 1ms linear both;
      }
      .steps > li:first-child {
        animation-name: loop-first;
      }
      .steps > li:last-child {
        animation-name: loop-last;
      }
      .steps h3 {
        font-size: 1.5rem;
      }
      .media {
        margin-top: 0;
        container-type: size;
      }
      /* The whole image fits the stage: as wide as the column allows, never taller than the cell. */
      .media :global(.shot img) {
        width: min(100cqw, (100cqh - 2px) * var(--ar));
        max-height: calc(100cqh - 2px);
      }
      /* A keyboard user tabbing to a step that is not showing gets that step, on top. */
      .steps > li:has(:focus-visible) {
        z-index: 2 !important;
        opacity: 1 !important;
        translate: none !important;
        background: var(--bg);
      }

      /* Their own rules, with an id, on purpose: the CSS minifier folds animation-timeline and
         animation-range into the animation shorthand of the same rule, and browsers then drop them. */
      #loop {
        view-timeline-name: --loop;
        view-timeline-inset: calc(var(--top) + 1rem) 0;
      }
      #loop .steps > li,
      #loop .meter li,
      #loop .meter li::after {
        animation-timeline: --loop;
      }
      #loop .steps > li:nth-child(1),
      #loop .meter li:nth-child(1),
      #loop .meter li:nth-child(1)::after {
        animation-range: contain 0% contain 33.333%;
      }
      #loop .steps > li:nth-child(2),
      #loop .meter li:nth-child(2),
      #loop .meter li:nth-child(2)::after {
        animation-range: contain 33.333% contain 66.667%;
      }
      #loop .steps > li:nth-child(3),
      #loop .meter li:nth-child(3),
      #loop .meter li:nth-child(3)::after {
        animation-range: contain 66.667% contain 100%;
      }
    }
  }
  /* Full opacity over 90% of a step's range; the hand-over is a short cross-fade.
     z-index follows opacity so the step on show is also the one that takes the click. */
  @keyframes loop-step {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-first {
    0%,
    95% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -1rem;
      z-index: 0;
    }
  }
  @keyframes loop-last {
    0% {
      opacity: 0;
      translate: 0 1rem;
      z-index: 0;
    }
    5%,
    100% {
      opacity: 1;
      translate: none;
      z-index: 1;
    }
  }
  @keyframes loop-fill {
    to {
      scale: 1 1;
    }
  }
  @keyframes loop-now {
    0%,
    100% {
      color: var(--muted);
    }
    5%,
    95% {
      color: var(--fg);
    }
  }
</style>
